#!/usr/bin/env node
'use strict';

// dotagents installer — payload/ を各ツールのネイティブな置き場へ実ファイルとしてコピーし、
// manifest で所有権を管理する。
//
// 設計原則:
// - 配備は plain copy だけ。symlink も中間ディレクトリ(.agents)も作らない —
//   ツールが読む場所(.claude/ / .codex/)にあるファイルがそのまま実体である。
// - payload/ の最上位の種類が配達先を決める: AGENTS.md は各ツールの規則ファイルへの
//   管理ブロック、skills/ は両ツールの skills/ へ、agents/ は .claude/agents/ へ。
//   それ以外(解説・docs)は配備しない。
// - manifest(~/.dotagents/ に集約)は「自分が置いたもの」だけを内容ハッシュ付きで記録する。
//   update / uninstall はハッシュが一致するファイルにしか触れない — ユーザーの改変と
//   自前スキルは常に保護される。マシン固有の記録なのでプロジェクトには何も残さない。
// - 対象(ユーザーレベル / プロジェクト)は決して既定値で決まらない。フラグで明示するか、
//   対話で選ぶかのどちらかである — 指定し忘れが黙って別の場所を書き換える経路を作らない。
// - 旧レイアウト(.agents + symlink + zshenv 行 + settings 断片)は install / update が
//   同じ所有権規則で検出・刈り込みし、新レイアウトへ移行する。

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const crypto = require('node:crypto');
const readline = require('node:readline');
const { execFileSync } = require('node:child_process');

const REPO_ROOT = path.resolve(__dirname, '..');
const PAYLOAD = path.join(REPO_ROOT, 'payload');
// マシン固有の記録の集約先。~/.claude・~/.codex と同じ古典的 dot ディレクトリ文化に置く。
const STATE_DIR = () => path.join(os.homedir(), '.dotagents');
// 旧レイアウト(<base>/.agents)の manifest 名と zshenv 管理行 — 刈り込み(移行)専用。
const LEGACY_MANIFEST_NAME = '.dotagents.json';
const MARKER = '# agents-harness';

// ---------------------------------------------------------------- helpers

function sha256(file) {
  return 'sha256:' + crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
}

function walk(dir, base = dir) {
  const out = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
    if (e.name === '.DS_Store') continue;
    const p = path.join(dir, e.name);
    if (e.isDirectory()) out.push(...walk(p, base));
    else out.push(path.relative(base, p));
  }
  return out;
}

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    if (e.code === 'ENOENT') return fallback;
    throw new Error(`cannot parse ${file} as JSON: ${e.message}`);
  }
}

function writeJson(file, obj) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(obj, null, 2) + '\n');
}

function lstatOrNull(p) {
  try { return fs.lstatSync(p); } catch { return null; }
}

function gitCommit() {
  try {
    return execFileSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
  } catch { return null; }
}

function pkg() {
  return readJson(path.join(REPO_ROOT, 'package.json'), { version: '0.0.0' });
}

function removeEmptyDirsUpTo(from, stopAt) {
  let dir = from;
  while (dir.startsWith(stopAt) && dir !== stopAt) {
    try { fs.rmdirSync(dir); } catch { return; }
    dir = path.dirname(dir);
  }
}

// ---------------------------------------------------------------- context

// 対象は opts.target(user / project)ただ 1 つ。base = 配達の基準ディレクトリで、
// manifest のファイルキーはすべて base 相対。legacyRoot は旧レイアウトの刈り込み専用。
function makeCtx(opts) {
  if (opts.target === 'project') {
    let proj = path.resolve(opts.dir ?? '.');
    if (!lstatOrNull(proj)?.isDirectory()) throw new Error(`no such directory: ${proj}`);
    proj = fs.realpathSync(proj); // manifest のキーを安定させる(symlink 経由の表記揺れを吸収)
    return {
      kind: 'project',
      base: proj,
      claudeDir: path.join(proj, '.claude'),
      codexDir: path.join(proj, '.codex'),
      zshenv: null, // 旧シェル配達はユーザーレベルにしか無かった
      legacyRoot: path.join(proj, '.agents'),
    };
  }
  const home = os.homedir();
  return {
    kind: 'user',
    base: home,
    claudeDir: path.join(home, '.claude'),
    codexDir: path.join(home, '.codex'),
    zshenv: path.join(home, '.zshenv'),
    legacyRoot: path.join(home, '.agents'),
  };
}

// manifest はマシン固有の状態なので ~/.dotagents/ に集約する。プロジェクトは
// 実パスで一意にキー化する(basename は人間の識別用、hash が同名の衝突を防ぐ)。
function manifestPath(ctx) {
  if (ctx.kind === 'user') return path.join(STATE_DIR(), 'user.json');
  const hash = crypto.createHash('sha256').update(ctx.base).digest('hex').slice(0, 12);
  return path.join(STATE_DIR(), 'projects', `${path.basename(ctx.base)}-${hash}.json`);
}

function legacyManifestPath(ctx) { return path.join(ctx.legacyRoot, LEGACY_MANIFEST_NAME); }

// 断片は絶対パスを含むマシン固有の設定なので、プロジェクトでは版管理対象の
// settings.json ではなく settings.local.json に書く。
function settingsPath(ctx) {
  return path.join(ctx.claudeDir, ctx.kind === 'project' ? 'settings.local.json' : 'settings.json');
}

function ownedSkillNames() {
  const dir = path.join(PAYLOAD, 'skills');
  if (!lstatOrNull(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isDirectory())
    .map((e) => e.name)
    .sort();
}

function ownedAgentNames() {
  const dir = path.join(PAYLOAD, 'agents');
  if (!lstatOrNull(dir)) return [];
  return fs.readdirSync(dir)
    .filter((n) => n.endsWith('.md'))
    .sort();
}

// 配達先の導出。payload の最上位の種類が行き先を決める:
// - skills/<name>/  → .claude/skills/<name>/ と(.codex/ がある環境では).codex/skills/<name>/
//   スキル単位でコピーする — 自前スキルの実体と同じ場所に同居させるため。
// - agents/<f>.md   → .claude/agents/<f>(Codex にエージェント定義の置き場は無い)
// - AGENTS.md       → コピーではなく規則ファイルへの管理ブロック(rulesTargets)
// - それ以外(README / docs)→ 配備しない。解説は正本と npm パッケージで読む。
function deliveryEntries(ctx) {
  const entries = [];
  const add = (src, dst) => entries.push({ src, dst, rel: path.relative(ctx.base, dst) });
  const codex = lstatOrNull(ctx.codexDir)?.isDirectory();
  for (const name of ownedSkillNames()) {
    const dir = path.join(PAYLOAD, 'skills', name);
    for (const rel of walk(dir)) {
      add(path.join(dir, rel), path.join(ctx.claudeDir, 'skills', name, rel));
      if (codex) add(path.join(dir, rel), path.join(ctx.codexDir, 'skills', name, rel));
    }
  }
  for (const file of ownedAgentNames()) {
    add(path.join(PAYLOAD, 'agents', file), path.join(ctx.claudeDir, 'agents', file));
  }
  return entries;
}

// 消してよいのは自分が張った(created: true の)旧リンクだけ。
// インストール前から存在した同内容のリンクはユーザーの持ち物であり、触れない。
// 新レイアウトはリンクを張らない — これは旧レイアウトの刈り込み専用である。
function removeLink(l, log) {
  if (l.created !== true) return;
  const st = lstatOrNull(l.link);
  if (!st || !st.isSymbolicLink()) return;
  const cur = fs.readlinkSync(l.link);
  if (cur === l.target || path.resolve(path.dirname(l.link), cur) === l.target) {
    fs.unlinkSync(l.link);
    log.del(`legacy link ${l.link}`);
  }
}

// ---------------------------------------------------------------- ~/.zshenv(刈り込み専用)

// 旧レイアウトのシェル配達が ~/.zshenv に残した管理行(マーカー付き = 常に自分の持ち物)を
// 除去する。新レイアウトは zshenv に何も書かない。
function removeZshenvLine(ctx, log) {
  if (!ctx.zshenv || !fs.existsSync(ctx.zshenv)) return;
  const text = fs.readFileSync(ctx.zshenv, 'utf8');
  const kept = text.split('\n').filter((l) => !l.includes(MARKER));
  if (kept.join('\n') !== text) {
    fs.writeFileSync(ctx.zshenv, kept.join('\n'));
    log.del(`legacy zshenv managed line`);
  }
}

function zshenvHasMarker(ctx) {
  if (!ctx.zshenv || !fs.existsSync(ctx.zshenv)) return false;
  return fs.readFileSync(ctx.zshenv, 'utf8').includes(MARKER);
}

// ---------------------------------------------------------------- settings.json 断片(刈り込み専用)

// 旧レイアウトが settings に書いた断片の照合パス。除去(所有照合)にだけ使う。
function fragmentDefs(ctx) {
  return {
    bashEnv: path.join(ctx.legacyRoot, 'hooks', 'shellenv.sh'),
    sessionStart: path.join(ctx.legacyRoot, 'hooks', 'beads-session.sh'),
  };
}

function removeSettings(ctx, fragments, log) {
  if (!fragments) return;
  const defs = fragmentDefs(ctx);
  const file = settingsPath(ctx);
  const s = readJson(file, null);
  if (!s) return;
  let changed = false;

  if (fragments.bashEnv && s.env?.BASH_ENV === defs.bashEnv) {
    delete s.env.BASH_ENV;
    if (Object.keys(s.env).length === 0) delete s.env;
    changed = true;
    log.del(`settings env.BASH_ENV`);
  }
  if (fragments.sessionStart && s.hooks?.SessionStart) {
    const before = s.hooks.SessionStart.length;
    s.hooks.SessionStart = s.hooks.SessionStart
      .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(defs.sessionStart)) }))
      .filter((m) => (m.hooks || []).length > 0);
    if (s.hooks.SessionStart.length !== before) { changed = true; log.del(`settings hooks.SessionStart`); }
    if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
    if (Object.keys(s.hooks).length === 0) delete s.hooks;
  }
  if ((fragments.ask || []).length && s.permissions?.ask) {
    const before = s.permissions.ask.length;
    s.permissions.ask = s.permissions.ask.filter((r) => !fragments.ask.includes(r));
    if (s.permissions.ask.length !== before) { changed = true; log.del(`settings permissions.ask`); }
    if (s.permissions.ask.length === 0) delete s.permissions.ask;
    if (Object.keys(s.permissions).length === 0) delete s.permissions;
  }

  if (changed) writeJson(file, s);
}

// Codex の hooks.json に旧レイアウトが書いた SessionStart 断片を、同じ所有権規則で除去する。
function codexHooksPath(ctx) { return path.join(ctx.codexDir, 'hooks.json'); }

function removeCodexHooks(ctx, fragments, log) {
  if (!fragments?.codexSessionStart) return;
  const sessionCmd = path.join(ctx.legacyRoot, 'hooks', 'beads-session.sh');
  const s = readJson(codexHooksPath(ctx), null);
  if (!s?.hooks?.SessionStart) return;
  const before = JSON.stringify(s);
  s.hooks.SessionStart = s.hooks.SessionStart
    .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(sessionCmd)) }))
    .filter((m) => (m.hooks || []).length > 0);
  if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
  if (Object.keys(s.hooks).length === 0) delete s.hooks;
  if (JSON.stringify(s) !== before) {
    writeJson(codexHooksPath(ctx), s);
    log.del('legacy codex hooks.SessionStart');
  }
}

// ---------------------------------------------------------------- 規則ブロック

// payload/AGENTS.md は各ツールの規則ファイルへ、マーカー付きの管理ブロックとして届ける。
// コピーではなくブロックなのは、規則ファイル(CLAUDE.md / AGENTS.md)はユーザー自身の
// 記述と同居する前提のファイルだからである。マーカー間は installer の完全管理領域:
// install / update が望む内容へ書き直し、uninstall が除去する。
// - Claude: <claudeDir>/CLAUDE.md — 無ければ作る
// - Codex(user): ~/.codex/AGENTS.md — .codex/ がある環境でだけ、無ければ作る
// - Codex(project): <project>/AGENTS.md — 既存のファイルにだけ足す(プロジェクトの
//   ルートに新しいファイルを作って見た目を変えない)
const BLOCK_BEGIN = '<!-- agents-harness:begin (dotagents installer が管理。手で編集しない) -->';
const BLOCK_END = '<!-- agents-harness:end -->';

function rulesBody() {
  const src = path.join(PAYLOAD, 'AGENTS.md');
  return lstatOrNull(src) ? fs.readFileSync(src, 'utf8').trim() : null;
}

function desiredBlock(body) { return [BLOCK_BEGIN, body, BLOCK_END].join('\n'); }

function rulesTargets(ctx) {
  const targets = [{ file: path.join(ctx.claudeDir, 'CLAUDE.md'), create: true }];
  if (ctx.kind === 'user') {
    if (lstatOrNull(ctx.codexDir)?.isDirectory()) {
      targets.push({ file: path.join(ctx.codexDir, 'AGENTS.md'), create: true });
    }
  } else if (lstatOrNull(path.join(ctx.base, 'AGENTS.md'))?.isFile()) {
    targets.push({ file: path.join(ctx.base, 'AGENTS.md'), create: false });
  }
  return targets;
}

function stripBlock(lines) {
  const kept = [];
  let inBlock = false;
  for (const l of lines) {
    if (l.trim() === BLOCK_BEGIN) { inBlock = true; continue; }
    if (inBlock) { if (l.trim() === BLOCK_END) inBlock = false; continue; }
    kept.push(l);
  }
  return kept;
}

// 戻り値は manifest への記録 { file(base 相対), createdFile } / null(対象外)。
// createdFile はファイルごと自分が作った事実 — uninstall がブロックを剥いで空になった
// ファイルを消してよいかの根拠になる。
function applyRulesBlock(ctx, t, body, oldRecord, log) {
  const st = lstatOrNull(t.file);
  if (!st && !t.create) return null;
  const rel = path.relative(ctx.base, t.file);
  const desired = desiredBlock(body);
  const text = st ? fs.readFileSync(t.file, 'utf8') : '';
  if (text.includes(desired)) {
    log.ok(`rules block ${rel}`);
    return { file: rel, createdFile: oldRecord?.createdFile === true };
  }
  const kept = stripBlock(text.split('\n'));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  fs.mkdirSync(path.dirname(t.file), { recursive: true });
  fs.writeFileSync(t.file, [...kept, ...(kept.length ? [''] : []), desired, ''].join('\n'));
  if (st) log.update(`rules block ${rel}`);
  else log.add(`rules block ${rel}`);
  return { file: rel, createdFile: st ? oldRecord?.createdFile === true : true };
}

function removeRulesBlock(ctx, record, log) {
  const file = path.join(ctx.base, record.file);
  if (!lstatOrNull(file)?.isFile()) return;
  const text = fs.readFileSync(file, 'utf8');
  if (!text.includes(BLOCK_BEGIN)) return; // ブロックが無ければユーザーのファイルに触れない
  const kept = stripBlock(text.split('\n'));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  if (record.createdFile === true && kept.join('\n').trim() === '') {
    fs.unlinkSync(file);
    log.del(`rules block ${record.file} (removed the file — it was ours)`);
    return;
  }
  fs.writeFileSync(file, kept.length ? kept.join('\n') + '\n' : '');
  log.del(`rules block ${record.file}`);
}

function rulesBlockState(ctx, t, body) {
  const st = lstatOrNull(t.file);
  if (!st) return t.create ? false : null;
  return fs.readFileSync(t.file, 'utf8').includes(desiredBlock(body));
}

// ---------------------------------------------------------------- log

function makeLog() {
  const counts = { add: 0, update: 0, ok: 0, del: 0, warn: 0 };
  const line = (sym, key, paint) => (msg) => { counts[key]++; console.log(`  ${paint(sym)} ${msg}`); };
  return {
    add: line('+', 'add', ui.green),
    update: line('~', 'update', ui.yellow),
    ok: (msg) => { counts.ok++; },
    del: line('-', 'del', ui.gray),
    warn: line('!', 'warn', ui.yellow),
    counts,
  };
}

// 完了行。0 の項目は出さない(何が起きたかだけを残す)。
function summary(counts) {
  const parts = [];
  if (counts.add) parts.push(ui.green(`${counts.add} added`));
  if (counts.update) parts.push(ui.yellow(`${counts.update} updated`));
  if (counts.del) parts.push(ui.gray(`${counts.del} removed`));
  if (counts.ok) parts.push(ui.dim(`${counts.ok} unchanged`));
  if (counts.warn) parts.push(ui.yellow(`${counts.warn} warning${counts.warn > 1 ? 's' : ''}`));
  return parts.length ? parts.join(ui.dim(' · ')) : ui.dim('nothing to do');
}

// ---------------------------------------------------------------- 表示(色・幅)

// 色は端末が受け取れるときだけ。NO_COLOR(no-color.org)と dumb 端末を尊重する。
const COLOR = Boolean(process.stdout.isTTY) && !process.env.NO_COLOR && process.env.TERM !== 'dumb';
const sgr = (on, off) => (s) => (COLOR ? `\x1b[${on}m${s}\x1b[${off}m` : String(s));
const ui = {
  bold: sgr(1, 22),
  dim: sgr(2, 22),
  red: sgr(31, 39),
  green: sgr(32, 39),
  yellow: sgr(33, 39),
  cyan: sgr(36, 39),
  gray: sgr(90, 39),
};

const ANSI_RE = /\x1b\[[0-9;]*m/g;

// 東アジアの全角は 2 桁を占める。行が端末幅で折り返すと再描画の行数計算が壊れるため、
// セレクターは必ずこの幅で測ってから切り詰める。
function isWide(cp) {
  return (cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0x303e) ||
    (cp >= 0x3041 && cp <= 0x33ff) || (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0xa000 && cp <= 0xa4cf) ||
    (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) || (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x20000 && cp <= 0x3fffd);
}

function textWidth(s) {
  let w = 0;
  for (const ch of String(s).replace(ANSI_RE, '')) w += isWide(ch.codePointAt(0)) ? 2 : 1;
  return w;
}

function pad(s, width) {
  return s + ' '.repeat(Math.max(0, width - textWidth(s)));
}

// パスは末尾(どのプロジェクトか)が情報なので、あふれたら頭を落とす。
function truncHead(s, max) {
  if (textWidth(s) <= max) return s;
  const chars = [...s];
  let out = '';
  let w = 0;
  for (let i = chars.length - 1; i >= 0; i--) {
    const cw = isWide(chars[i].codePointAt(0)) ? 2 : 1;
    if (w + cw > max - 1) break;
    out = chars[i] + out;
    w += cw;
  }
  return '…' + out;
}

function homePath(p) {
  const home = os.homedir();
  return p === home || p.startsWith(home + path.sep) ? '~' + p.slice(home.length) : p;
}

function termWidth() {
  return process.stdout.columns && process.stdout.columns > 20 ? process.stdout.columns : 80;
}

// ---------------------------------------------------------------- 対話(セレクター)

function isInteractive() {
  return Boolean(process.stdin.isTTY && process.stdout.isTTY);
}

const CANCELLED = Symbol('cancelled');

// 矢印キーで選ぶ。何を打てばよいかを覚えさせず、選べる物を常に画面へ出す。
// options: [{ label, detail, hint, tone }]
function select({ title, notes = [], options }) {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    const width = termWidth();
    const labelWidth = Math.max(...options.map((o) => textWidth(o.label)));
    let index = 0;
    let drawn = 0;

    const paint = () => {
      const lines = [];
      lines.push('');
      lines.push(`  ${ui.bold(title)}`);
      for (const n of notes) lines.push(`  ${ui.dim(n)}`);
      lines.push('');
      options.forEach((o, i) => {
        const on = i === index;
        const tone = o.tone === 'danger' ? ui.red : ui.cyan;
        const label = on ? tone(ui.bold(pad(o.label, labelWidth))) : pad(o.label, labelWidth);
        const room = width - labelWidth - 8;
        const detail = o.detail ? (on ? ui.gray(truncHead(o.detail, room)) : ui.dim(truncHead(o.detail, room))) : '';
        lines.push(`  ${on ? tone('❯') : ' '} ${label}   ${detail}`.trimEnd());
        if (o.hint) lines.push(`      ${ui.dim(truncHead(o.hint, width - 8))}`);
      });
      lines.push('');
      lines.push(`  ${ui.dim('↑/↓ move · enter select · ctrl-c cancel')}`);

      let out = drawn ? `\x1b[${drawn}A` : '';
      out += lines.map((l) => `\x1b[2K${l}`).join('\n') + '\n';
      process.stdout.write(out);
      drawn = lines.length;
    };

    const finish = (value) => {
      stdin.removeListener('keypress', onKey);
      if (stdin.isTTY) stdin.setRawMode(false);
      stdin.pause();
      // 選択肢を畳んで、決めた結果だけを 1 行残す。
      const chosen = value === CANCELLED ? ui.red('cancelled') : ui.cyan(options[value].label);
      process.stdout.write(`\x1b[${drawn}A\x1b[0J  ${ui.green('✔')} ${ui.bold(title)}  ${chosen}\n`);
      process.stdout.write('\x1b[?25h');
      resolve(value);
    };

    const onKey = (str, key = {}) => {
      if (key.name === 'up' || key.name === 'k') { index = (index - 1 + options.length) % options.length; paint(); }
      else if (key.name === 'down' || key.name === 'j') { index = (index + 1) % options.length; paint(); }
      else if (key.name === 'return' || key.name === 'enter') finish(index);
      else if (key.name === 'escape' || key.name === 'q' || (key.ctrl && (key.name === 'c' || key.name === 'd'))) finish(CANCELLED);
    };

    readline.emitKeypressEvents(stdin);
    if (stdin.isTTY) stdin.setRawMode(true);
    stdin.resume();
    stdin.on('keypress', onKey);
    process.stdout.write('\x1b[?25l');
    paint();
  });
}

// 2 択も同じ器で聞く。返すのは真偽ではなく選ばれた値 — yes/no にすると、安全側を
// 先頭に置いた瞬間に呼び出し側が反転を抱える(`!yes` が「実行する」になる)。
// 先頭は常に影響範囲の狭い側に置く: 連打や早合点で決まっても被害が小さい方を既定にする。
async function pick(title, notes, options) {
  const i = await select({ title, notes, options });
  return i === CANCELLED ? CANCELLED : options[i].value;
}

function closePrompt() {
  if (process.stdout.isTTY) process.stdout.write('\x1b[?25h');
}

const TITLE = {
  install: 'Install where?',
  update: 'Update which installation?',
  uninstall: 'Uninstall from where?',
  status: 'Check which installation?',
};

// 対象は既定値では決まらない。明示されていれば対話しない、無ければ選ばせる、
// 選べない環境(非 TTY)なら止める — 指定し忘れが黙って別の場所に効く経路を作らない。
async function resolveTarget(cmd, opts) {
  if (opts.target) return opts;
  if (!isInteractive()) {
    throw new Error(
      `no target given for \`${cmd}\`. Pick exactly one:\n` +
      `         agents-setup ${cmd} user              ~/.claude + ~/.codex\n` +
      `         agents-setup ${cmd} project [<dir>]   <dir>/.claude + <dir>/.codex (defaults to the current directory)\n` +
      `       (run it in a terminal to choose interactively)`);
  }
  const cwd = process.cwd();
  // 影響範囲の狭い方(このプロジェクト)を初期選択に置く。連打や早合点で決まっても
  // 被害が 1 プロジェクトに閉じ、全プロジェクトに効く側は必ず一手を要する。
  const choice = await select({
    title: TITLE[cmd],
    options: [
      {
        label: 'This project',
        detail: homePath(cwd),
        hint: cwd === REPO_ROOT
          ? 'Rules for this project only — note: this is the dotagents repo itself'
          : 'Rules for this project only',
      },
      {
        label: 'User level',
        detail: '~/.claude · ~/.codex',
        hint: 'Rules, skills and review agents for every project',
      },
    ],
  });
  if (choice === CANCELLED) throw new Error('cancelled.');
  if (choice === 0) { opts.target = 'project'; opts.dir = cwd; }
  else opts.target = 'user';
  opts.interactive = true;
  return opts;
}

// ---------------------------------------------------------------- 旧レイアウトの移行

// 旧レイアウト(<base>/.agents + symlink + zshenv 行 + settings / codex 断片 + 参照ブロック)を
// 検出し、旧 manifest の所有記録に基づいて刈り込む。install / update / uninstall の入口で
// 走る。ユーザーの改変(hash 不一致)と自前スキルは残して警告する — 所有権規則は
// 新レイアウトと同一である。
function migrateLegacy(ctx, log) {
  const m = readJson(legacyManifestPath(ctx), null);
  if (!m) return false;
  for (const l of m.links || []) removeLink(l, log);
  removeZshenvLine(ctx, log);
  removeSettings(ctx, m.fragments, log);
  removeCodexHooks(ctx, m.fragments, log);
  if (m.fragments?.refBlock) {
    // 旧・参照ブロック(マーカーは現行の規則ブロックと同一)。剥ぐだけでよい —
    // 対象が rulesTargets に含まれる場合は、新しい規則ブロックが同じ場所に入り直す。
    const file = path.join(ctx.base, 'AGENTS.md');
    if (lstatOrNull(file)?.isFile()) {
      const text = fs.readFileSync(file, 'utf8');
      if (text.includes(BLOCK_BEGIN)) {
        const kept = stripBlock(text.split('\n'));
        while (kept.length && kept[kept.length - 1] === '') kept.pop();
        fs.writeFileSync(file, kept.length ? kept.join('\n') + '\n' : '');
        log.del('legacy AGENTS.md reference block');
      }
    }
  }
  for (const [rel, hash] of Object.entries(m.files || {})) {
    const dst = path.join(ctx.legacyRoot, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.legacyRoot);
      log.del(`legacy ${path.join('.agents', rel)}`);
    } else {
      log.warn(`legacy file modified in place, keeping it: ${dst}`);
    }
  }
  fs.unlinkSync(legacyManifestPath(ctx));
  try { fs.rmdirSync(ctx.legacyRoot); } catch { /* 自前スキル等が残っていれば残す */ }
  return true;
}

// ---------------------------------------------------------------- commands

async function install(opts, { requireExisting = false } = {}) {
  const ctx = makeCtx(opts);
  const log = makeLog();
  const old = readJson(manifestPath(ctx), null);
  if (requireExisting && !old && !readJson(legacyManifestPath(ctx), null)) {
    throw new Error(`nothing installed for ${homePath(ctx.base)} — run \`agents-setup install\` first.`);
  }

  // 0. 旧レイアウト(.agents + symlink + 断片)の刈り込み
  migrateLegacy(ctx, log);

  // 1. payload → 各ツールの置き場(所有ハッシュに基づく外科的コピー)
  const entries = deliveryEntries(ctx);
  const files = {};
  for (const { src, dst, rel } of entries) {
    const srcHash = sha256(src);
    const st = lstatOrNull(dst);
    const recorded = old?.files?.[rel];
    if (!st) {
      fs.mkdirSync(path.dirname(dst), { recursive: true });
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[rel] = srcHash;
      log.add(rel);
    } else if (sha256(dst) === srcHash) {
      files[rel] = srcHash;
      log.ok(rel);
    } else if (recorded && sha256(dst) === recorded) {
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[rel] = srcHash;
      log.update(rel);
    } else if (opts.force) {
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[rel] = srcHash;
      log.update(`${rel}(--force で上書き)`);
    } else {
      log.warn(`modified in place, leaving it (use --force to overwrite): ${dst}`);
      if (recorded) files[rel] = recorded; // 所有記録は保持し、状態は status が報告する
    }
  }

  // 2. payload から消えたファイルの刈り込み(自分が置いた内容のままのものだけ)
  const relSet = new Set(entries.map((e) => e.rel));
  for (const [rel, hash] of Object.entries(old?.files || {})) {
    if (files[rel] !== undefined || relSet.has(rel)) continue;
    const dst = path.join(ctx.base, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.base);
      log.del(`${rel} (gone from payload)`);
    } else {
      log.warn(`gone from payload but modified in place, keeping it: ${dst}`);
    }
  }

  // 3. 規則ブロック(旧記録から外れた先の刈り込み → 現在の対象への適用)
  const body = rulesBody();
  const oldBlocks = new Map((old?.rulesBlocks || []).map((r) => [r.file, r]));
  const rulesRecords = [];
  if (body !== null) {
    for (const t of rulesTargets(ctx)) {
      const rec = applyRulesBlock(ctx, t, body, oldBlocks.get(path.relative(ctx.base, t.file)), log);
      if (rec) rulesRecords.push(rec);
    }
  }
  const currentBlockFiles = new Set(rulesRecords.map((r) => r.file));
  for (const r of old?.rulesBlocks || []) {
    if (!currentBlockFiles.has(r.file)) removeRulesBlock(ctx, r, log);
  }

  // 4. manifest(マシン固有の記録なので ~/.dotagents/ に置き、配備先には何も残さない)
  writeJson(manifestPath(ctx), {
    schema: 2,
    kind: ctx.kind,
    base: ctx.base,
    version: pkg().version,
    source: REPO_ROOT,
    commit: gitCommit(),
    installedAt: new Date().toISOString(),
    files,
    rulesBlocks: rulesRecords,
  });

  const c = log.counts;
  console.log(`\n  ${ui.bold(ctx.kind)} ${ui.dim('→')} ${homePath(ctx.base)}`);
  console.log(`  ${summary(c)}`);
  if (c.warn > 0) process.exitCode = 1;
}

async function uninstall(opts) {
  const ctx = makeCtx(opts);
  const log = makeLog();
  const m = readJson(manifestPath(ctx), null);
  const hasLegacy = !!readJson(legacyManifestPath(ctx), null);
  if (!m && !hasLegacy) {
    throw new Error(`nothing installed for ${homePath(ctx.base)} — nothing of ours to remove.`);
  }

  // 旧レイアウトの持ち物(リンク・断片・.agents 内のファイル)も同じ所有権規則で外す
  migrateLegacy(ctx, log);

  for (const r of m?.rulesBlocks || []) removeRulesBlock(ctx, r, log);
  for (const [rel, hash] of Object.entries(m?.files || {})) {
    const dst = path.join(ctx.base, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.base);
      log.del(rel);
    } else {
      log.warn(`modified in place, keeping it: ${dst}`);
    }
  }

  if (m) fs.unlinkSync(manifestPath(ctx));
  // 記録が尽きたら集約ディレクトリ自体も残さない(空のときだけ消える)
  try { fs.rmdirSync(path.join(STATE_DIR(), 'projects')); } catch { /* 他の記録があれば残る */ }
  try { fs.rmdirSync(STATE_DIR()); } catch { /* 同上 */ }

  const c = log.counts;
  console.log(`\n  ${ui.bold('uninstall')} ${ui.dim('→')} ${homePath(ctx.base)}`);
  console.log(`  ${summary(c)}${ui.dim(' · your own skills and modified files were left alone')}`);
}

function status(opts) {
  const ctx = makeCtx(opts);
  const m = readJson(manifestPath(ctx), null);
  const hasLegacy = !!readJson(legacyManifestPath(ctx), null);
  let drift = 0;
  const report = (okc, msg) => {
    console.log(`  ${okc ? ui.green('ok') : ui.red('NG')}  ${okc ? msg : ui.bold(msg)}`);
    if (!okc) drift++;
  };

  if (!m) {
    if (hasLegacy) {
      console.log(`\n  ${ui.yellow('legacy layout')} ${ui.dim('—')} ${homePath(ctx.legacyRoot)} exists; run \`agents-setup update\` to migrate`);
    } else {
      console.log(`\n  ${ui.yellow('not installed')} ${ui.dim('—')} no manifest for ${homePath(ctx.base)}`);
    }
    process.exitCode = 1;
    return;
  }

  console.log(`\n  ${ui.bold(m.kind)} ${ui.dim('→')} ${homePath(ctx.base)}`);
  console.log(ui.dim(`  version=${m.version} commit=${(m.commit || 'unknown').slice(0, 12)} installed=${m.installedAt}`));
  console.log(ui.dim(`  source=${m.source}\n`));

  // payload との照合
  const entries = deliveryEntries(ctx);
  for (const { src, dst, rel } of entries) {
    const st = lstatOrNull(dst);
    if (!st) { report(false, `${rel} — missing`); continue; }
    const h = sha256(dst);
    if (h === sha256(src)) report(true, rel);
    else if (h === m.files?.[rel]) report(false, `${rel} — payload is newer, run update`);
    else report(false, `${rel} — modified in place`);
  }
  const relSet = new Set(entries.map((e) => e.rel));
  for (const rel of Object.keys(m.files || {})) {
    if (!relSet.has(rel)) report(false, `${rel} — gone from payload, run update to prune`);
  }

  // 規則ブロック
  const body = rulesBody();
  if (body !== null) {
    for (const t of rulesTargets(ctx)) {
      const st = rulesBlockState(ctx, t, body);
      if (st !== null) report(st, `rules block ${path.relative(ctx.base, t.file)}`);
    }
  }

  // 旧レイアウトの残存
  if (hasLegacy) report(false, `legacy layout ${homePath(ctx.legacyRoot)} — run update to migrate`);
  if (ctx.kind === 'user' && zshenvHasMarker(ctx)) report(false, `legacy zshenv managed line — run update to prune`);

  console.log(drift === 0 ? `\n  ${ui.green('no drift')}` : `\n  ${ui.red(`drift: ${drift}`)}`);
  if (drift > 0) process.exitCode = 1;
}

// ---------------------------------------------------------------- main

// ---------------------------------------------------------------- 正本(取得と追従)
//
// 三層の動詞を分ける: clone(取得・初回)/ pull(追従・繰り返し)/ install・update(配備)。
// 追従の本体は git に委ねる — pull が包むのは「差分の提示 → 統合 → 検証」だけで、
// 配備の再同期は行わない(古さは各セッション入口の計器 agents-doctor が検出する)。

// この実行ファイルが編集可能な正本(git リポジトリ)の中にいるか。
// npx のキャッシュや tarball 展開は正本ではない — そこから黙って配備しない。
function isCorpus() {
  return Boolean(lstatOrNull(path.join(REPO_ROOT, '.git')));
}

function corpusGit(args, opts = {}) {
  return execFileSync('git', ['-C', REPO_ROOT, ...args], { encoding: 'utf8', ...opts });
}

// clone 元の解決: 明示(--from)→ package.json の repository → 実行元リポジトリの origin。
function cloneSource(opts) {
  if (opts.from) return opts.from;
  const repo = pkg().repository;
  const url = typeof repo === 'string' ? repo : repo?.url;
  if (url) return url.replace(/^git\+/, '');
  if (isCorpus()) {
    try { return corpusGit(['remote', 'get-url', 'origin']).trim(); } catch { /* origin 無し */ }
  }
  throw new Error('clone source unknown: pass --from <url|path>.');
}

function question(title) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(`  ${ui.bold(title)} `, (answer) => { rl.close(); resolve(answer.trim()); });
  });
}

async function clone(opts) {
  let dir = opts.cloneDir;
  if (!dir) {
    if (!isInteractive()) {
      throw new Error('no directory given for `clone`. The corpus lands where you say, never in a default:\n' +
        '         dotagents clone <dir>\n' +
        '       (run it in a terminal to type one interactively)');
    }
    dir = await question('Clone the corpus into which directory?');
    if (!dir) throw new Error('cancelled.');
  }
  dir = path.resolve(dir);
  const st = lstatOrNull(dir);
  if (st && (!st.isDirectory() || fs.readdirSync(dir).length)) {
    throw new Error(`not an empty directory: ${dir}`);
  }
  const src = cloneSource(opts);
  console.log(`${ui.dim('clone')} ${src} ${ui.dim('→')} ${homePath(dir)}`);
  execFileSync('git', ['clone', src, dir], { stdio: 'inherit' });
  console.log(`\n${ui.green('✔')} corpus cloned. It is yours to edit — rules live in git, deployments follow it.`);
  console.log(`${ui.dim('  next:')} ${homePath(path.join(dir, 'bin', 'agents-setup'))} install ${ui.dim('user | project [dir]')}`);
  console.log(`${ui.dim('  follow upstream later with:')} ${homePath(path.join(dir, 'bin', 'agents-setup'))} pull`);
}

function pull() {
  if (corpusGit(['status', '--porcelain']).trim()) {
    throw new Error('the corpus has uncommitted changes. Commit or stash them first —\n' +
      '       pulling over local edits mixes upstream and your hand in one diff.');
  }
  let upstream;
  try {
    upstream = corpusGit(['rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}']).trim();
  } catch {
    throw new Error('no upstream branch. Set one (git branch --set-upstream-to=origin/<branch>) and retry.');
  }
  corpusGit(['fetch', '--quiet'], { stdio: ['ignore', 'inherit', 'inherit'] });
  const incoming = corpusGit(['log', '--oneline', `HEAD..${upstream}`]).trim();
  if (!incoming) {
    console.log(`${ui.green('✔')} already following ${upstream} — nothing new upstream.`);
    return;
  }
  // コミットタイトルの規約(業務上何が変わったか)が、そのまま人間の読める changelog になる
  console.log(`${ui.bold('incoming from')} ${upstream}:`);
  for (const line of incoming.split('\n')) console.log(`  ${line}`);
  console.log('');
  try {
    execFileSync('git', ['-C', REPO_ROOT, 'pull', '--rebase'], { stdio: 'inherit' });
  } catch {
    throw new Error('integration stopped (see git output above). Resolve, `git rebase --continue`, then re-run pull.');
  }
  if (pkg().scripts?.test) {
    console.log(`${ui.dim('verifying the merged corpus…')}`);
    try {
      execFileSync('npm', ['test'], { cwd: REPO_ROOT, stdio: ['ignore', 'ignore', 'inherit'] });
    } catch {
      throw new Error('pulled, but the corpus fails its own tests. Fix before deploying —\n' +
        '       do not run `update` from a red corpus.');
    }
  }
  const n = incoming.split('\n').length;
  console.log(`${ui.green('✔')} pulled ${n} commit${n === 1 ? '' : 's'} and verified.`);
  console.log(`${ui.dim('  deployments resync per install:')} agents-setup update ${ui.dim('… (status detects drift)')}`);
}

// 正本の外(npx キャッシュ等)から配備系コマンドが呼ばれたら、既知の正本へ委譲する。
// 使い捨てコピーを source として manifest に記録する経路を作らない。
// 正本の在処は ~/.dotagents/ の記録から引く(旧レイアウトの ~/.agents/.dotagents.json も
// 移行期間の後方互換として読む)。
function knownCorpusSource() {
  const user = readJson(path.join(STATE_DIR(), 'user.json'), null);
  if (user?.source) return user.source;
  const projectsDir = path.join(STATE_DIR(), 'projects');
  for (const f of (lstatOrNull(projectsDir) ? fs.readdirSync(projectsDir).sort() : [])) {
    const m = readJson(path.join(projectsDir, f), null);
    if (m?.source) return m.source;
  }
  return readJson(path.join(os.homedir(), '.agents', LEGACY_MANIFEST_NAME), null)?.source ?? null;
}

function delegateToCorpus(argv) {
  const source = knownCorpusSource();
  const bin = source && path.join(source, 'bin', 'agents-setup');
  if (source && source !== REPO_ROOT && lstatOrNull(bin)) {
    console.log(`${ui.dim('not a corpus here — delegating to')} ${homePath(source)}`);
    const r = require('node:child_process').spawnSync(process.execPath, [bin, ...argv], { stdio: 'inherit' });
    process.exitCode = r.status ?? 1;
    return;
  }
  throw new Error('this copy is disposable (npx cache or tarball), not an editable corpus.\n' +
    '       Get one first, then deploy from it:\n' +
    '         npx @hiroiku/dotagents clone <dir>\n' +
    `         <dir>/bin/agents-setup install user | project [dir]`);
}

const COMMANDS = new Set(['clone', 'pull', 'install', 'update', 'uninstall', 'status']);
// 対象(配備先)を取らないコマンド。clone は取得先ディレクトリ、pull は引数なし。
const CORPUS_COMMANDS = new Set(['clone', 'pull']);
const TARGETS = new Set(['user', 'project']);
// 旧インタフェース。エイリアスとしては生かさない(2 系統は維持費を二重に払う)。
// 正しい形へ案内するためだけに名前を覚えておく。
const RETIRED = new Set(['--user', '--project', '--shell']);

// 対象は位置引数 1 つ。位置は 1 つしか無いので「user と project の同時指定」は
// 表現できない — 排他は検証ではなく構文が保証する。
function parseArgs(argv) {
  const opts = { target: null, dir: null, cloneDir: null, from: null, force: false, interactive: false, help: false, version: false };
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') opts.help = true;
    else if (a === '--version' || a === '-v') opts.version = true;
    else if (a === '--force') opts.force = true;
    else if (a === '--from') {
      if (argv[i + 1] === undefined) throw new Error('--from takes a value: --from <url|path>');
      opts.from = argv[++i];
    }
    else if (RETIRED.has(a)) {
      throw new Error(`${a} is retired. The target is a positional argument now:\n` +
        `         agents-setup <command> user | project [<dir>]`);
    }
    else if (a.startsWith('-')) throw new Error(`unknown argument: ${a}`);
    else positional.push(a);
  }

  const [cmd, target, dir, ...extra] = positional;
  // ヘルプと版の表示は引数の妥当性より優先する(`install --help` に対象を要求しない)
  if (opts.help || opts.version) return { cmd, opts };
  if (!COMMANDS.has(cmd)) return { cmd, opts };  // 使い方の表示へ

  // clone は取得先ディレクトリを 1 つ、pull は位置引数を取らない(配備の対象語彙と混ぜない)
  if (CORPUS_COMMANDS.has(cmd)) {
    if (cmd === 'pull' && target !== undefined) throw new Error(`\`pull\` takes no arguments: ${target}`);
    if (cmd === 'clone') {
      if (dir !== undefined || extra.length) throw new Error(`too many arguments: ${[dir, ...extra].filter(Boolean).join(' ')}`);
      opts.cloneDir = target ?? null;
    }
    return { cmd, opts };
  }

  if (target !== undefined) {
    if (target === 'shell') {
      throw new Error('the `shell` target is retired: the payload no longer ships a shell layer.\n' +
        '       Use `user` or `project [<dir>]`; `update` prunes any old shell wiring.');
    }
    if (!TARGETS.has(target)) {
      throw new Error(`unknown target: ${target} (expected user or project)`);
    }
    opts.target = target;
  }
  if (dir !== undefined) {
    if (TARGETS.has(dir)) throw new Error(`pick exactly one target (got ${target} and ${dir}).`);
    if (target !== 'project') throw new Error(`only \`project\` takes a directory: ${dir}`);
    opts.dir = dir;
  }
  if (extra.length) throw new Error(`too many arguments: ${extra.join(' ')}`);

  return { cmd, opts };
}

// ---------------------------------------------------------------- help

// 対象の説明は 4 コマンドで同一なので 1 箇所に持つ(コマンドごとに書き写すと黙って古くなる)。
const TARGET_HELP = `${ui.bold('Target')} ${ui.dim('— exactly one. Omit it to choose interactively; never defaulted.')}
  ${ui.cyan('user')}           this machine (~/.claude and ~/.codex)
  ${ui.cyan('project')} [dir]  a project (<dir>/.claude and <dir>/.codex; defaults to the current directory)`;

const CMD_HELP = {
  clone: {
    usage: '<dir>',
    line: 'get the corpus as your own editable git repository (first time)',
    body: [
      'Clones the rules corpus into <dir> as a git repository you own: edit rules there,',
      'commit them, and deploy from it with install/update. The directory is explicit or',
      'asked interactively — never defaulted.',
    ],
    options: [['--from <url|path>', 'clone from an explicit source instead of the published repository']],
    notes: ['A clone is for editing and following. `npx @hiroiku/dotagents clone` is the one command that works outside a corpus.'],
    examples: [
      ['npx @hiroiku/dotagents clone ~/dotagents', 'get the corpus next to your dotfiles'],
      ['dotagents clone x --from /path/to/repo', 'clone a local fork'],
    ],
  },
  pull: {
    usage: '',
    line: 'follow upstream: show incoming commits, integrate, verify (repeatable)',
    body: [
      'Fetches upstream, lists the incoming commit titles (the commit convention makes',
      'them a readable changelog), rebases your local commits on top, then runs the',
      'corpus tests. Stops on uncommitted changes, conflicts, or red tests.',
    ],
    options: [],
    notes: ['Deployments are not touched: each install resyncs with `update` (status detects drift).'],
    examples: [
      ['dotagents pull', 'follow the upstream corpus'],
    ],
  },
  install: {
    line: 'copy payload/ into the tool directories (.claude/ and .codex/)',
    body: [
      'Copies skills and agent definitions into .claude/ (and .codex/ when present) as',
      'plain files, and delivers the rules as a managed block in CLAUDE.md / AGENTS.md.',
      'Everything is idempotent and hash-owned: files you edited after installation are',
      'kept and reported, and skills you wrote yourself are never touched.',
    ],
    options: [['--force', 'overwrite files that were modified after installation']],
    notes: ['A legacy .agents layout (symlinks, zshenv line, settings fragments) is migrated automatically.'],
    examples: [
      ['agents-setup install', 'choose the target interactively'],
      ['agents-setup install project', 'into the current directory'],
      ['agents-setup install project /path/to/x', 'into a specific project'],
      ['agents-setup install user', 'for every project on this machine'],
    ],
  },
  update: {
    line: 'same as install, and prune whatever disappeared from payload/',
    body: [
      'Requires an existing installation. Beyond what install does, it removes files that',
      'are gone from payload/ but still recorded in the manifest (kept machine-locally',
      'under ~/.dotagents/), and prunes any legacy .agents layout it finds.',
    ],
    options: [['--force', 'overwrite files that were modified after installation']],
    notes: ['Edit prompts in this repository, never in the installed tree — update carries them over.'],
    examples: [
      ['agents-setup update project', 'refresh the current directory'],
      ['agents-setup update user --force', 'refresh, discarding local edits'],
    ],
  },
  uninstall: {
    line: 'remove only what this installer placed and still owns (hash-matched)',
    body: [
      'Removes files whose content still matches the manifest and strips the managed',
      'rules blocks. Your own skills, files you modified, and everything you wrote',
      'around the blocks are left in place.',
    ],
    options: [],
    notes: [],
    examples: [
      ['agents-setup uninstall project', 'remove from the current directory'],
      ['agents-setup uninstall user', 'remove from this machine'],
    ],
  },
  status: {
    line: 'verify manifest, payload, files and rules blocks (exit 1 on drift)',
    body: [
      'Compares the installed files against both the manifest and payload/, and reports',
      'every difference: missing files, edits made in place, payload changes not yet',
      'applied, and leftover legacy layouts. Exits 1 when anything differs.',
    ],
    options: [],
    notes: [],
    examples: [
      ['agents-setup status project', 'check the current directory'],
      ['agents-setup status user', 'check this machine'],
    ],
  },
};

function printHelp(cmd) {
  const pad2 = (rows) => {
    const w = Math.max(...rows.map(([l]) => textWidth(l)));
    return rows.map(([l, r]) => `  ${ui.cyan(pad(l, w))}  ${ui.dim(r)}`);
  };

  if (!cmd) {
    console.log(`${ui.bold('agents-setup')} ${ui.dim('<command> [target] [options]')}\n`);
    console.log(ui.bold('Commands'));
    console.log(pad2(Object.entries(CMD_HELP).map(([k, h]) => [k, h.line])).join('\n'));
    console.log(`\n${TARGET_HELP}`);
    console.log(`\n${ui.bold('Options')}`);
    console.log(pad2([
      ['--force', 'overwrite files that were modified after installation'],
      ['--help, -h', 'show this help, or the help for a command'],
      ['--version, -v', 'print the version'],
    ]).join('\n'));
    console.log(`\n${ui.dim('Deployments are plain copies — edit rules in the corpus, deliver with update.')}`);
    console.log(`\n${ui.dim(`Run \`agents-setup <command> --help\` for what a single command does.`)}`);
    return;
  }

  const h = CMD_HELP[cmd];
  const usage = h.usage !== undefined ? h.usage : '<target> [options]';
  console.log(`${ui.bold(`agents-setup ${cmd}`)}${usage ? ` ${ui.dim(usage)}` : ''}\n`);
  for (const l of h.body) console.log(`  ${l}`);
  if (!CORPUS_COMMANDS.has(cmd)) console.log(`\n${TARGET_HELP}`);
  if (h.options.length) {
    console.log(`\n${ui.bold('Options')}`);
    console.log(pad2(h.options).join('\n'));
  }
  if (h.notes.length) {
    console.log('');
    for (const n of h.notes) console.log(n);
  }
  console.log(`\n${ui.bold('Examples')}`);
  console.log(pad2(h.examples).join('\n'));
}

// ---------------------------------------------------------------- main

async function main() {
  const { cmd, opts } = parseArgs(process.argv.slice(2));
  if (opts.version) return void console.log(pkg().version);
  if (opts.help || !cmd) return void printHelp(COMMANDS.has(cmd) ? cmd : null);
  if (!COMMANDS.has(cmd)) {
    throw new Error(`unknown command: ${cmd}\n       Run \`agents-setup --help\` to see what is available.`);
  }
  // clone はどこからでも実行できる。それ以外は編集可能な正本からだけ —
  // 正本の外(npx キャッシュ等)では既知の正本へ委譲するか、clone への案内で止まる。
  if (cmd !== 'clone' && !isCorpus()) return delegateToCorpus(process.argv.slice(2));
  switch (cmd) {
    case 'clone': return clone(opts);
    case 'pull': return pull();
    case 'install': return install(await resolveTarget(cmd, opts));
    case 'update': return install(await resolveTarget(cmd, opts), { requireExisting: true });
    case 'uninstall': return uninstall(await resolveTarget(cmd, opts));
    case 'status': return status(await resolveTarget(cmd, opts));
  }
}

main()
  .catch((e) => {
    console.error(`${ui.red('Error:')} ${e.message}`);
    process.exitCode = 1;
  })
  .finally(closePrompt);
