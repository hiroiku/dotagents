function printHelp(cmd) {
  const pad2 = (rows) => {
    const w = Math.max(...rows.map(([l]) => textWidth(l)));
    return rows.map(([l, r]) => `  ${ui.cyan(pad(l, w))}  ${ui.dim(r)}`);
  };

  if (!cmd) {
    console.log(`${ui.bold('agents-setup')} ${ui.dim('<command> [module...] [options]')}\n`);
    // 対象ごとに語彙を分けて示す。
    console.log(`${ui.bold('The rules')} ${ui.dim(`— every module lives in ~/.dotagents/modules/; the ${VENDOR} set is placed there for you`)}`);
    console.log(pad2([['list', CMD_HELP.list.line]]).join('\n'));
    console.log(`\n${ui.bold('Deployments')} ${ui.dim('— what a tool actually reads')}`);
    console.log(pad2(['install', 'update', 'uninstall', 'status'].map((k) => [k, CMD_HELP[k].line])).join('\n'));
    console.log(`\n${TARGET_HELP}`);
    console.log(`\n${ui.bold('Options')}`);
    console.log(pad2([
      ['--force', 'overwrite whatever sits in the way and does not match what would be delivered'],
      ['--help, -h', 'show this help, or the help for a command'],
      ['--version, -v', 'print the version'],
    ]).join('\n'));
    console.log(`\n${ui.bold('Home')} ${ui.dim('— every module, and the record of what was placed where')}`);
    console.log(`  ${ui.cyan(pad(homePath(DOTAGENTS_HOME()), 14))}  ${ui.dim(process.env.DOTAGENTS_HOME ? 'from DOTAGENTS_HOME' : 'set DOTAGENTS_HOME to move it')}`);
    console.log(`\n${ui.dim('Deployments are plain copies. Update the package for new rules, then `update` to redeliver.')}`);
    console.log(`\n${ui.dim(`Run \`agents-setup <command> --help\` for what a single command does.`)}`);
    return;
  }

  const h = CMD_HELP[cmd];
  const usage = h.usage !== undefined ? h.usage : '[options]';
  console.log(`${ui.bold(`agents-setup ${cmd}`)}${usage ? ` ${ui.dim(usage)}` : ''}\n`);
  for (const l of h.body) console.log(`  ${l}`);
  if (!CORPUS_COMMANDS.has(cmd)) console.log(`\n${TARGET_HELP}`);
  if (h.options.length) {
    console.log(`\n${ui.bold('Options')}`);
    console.log(pad2(h.options).join('\n'));
  }
  if (h.notes.length) {
    console.log('');
    for (const n of h.notes) console.log(n);
  }
  console.log(`\n${ui.bold('Examples')}`);
  console.log(pad2(h.examples).join('\n'));
}

// ---------------------------------------------------------------- main

async function main() {
  const { cmd, opts } = parseArgs(process.argv.slice(2));
  if (opts.version) return void console.log(pkg().version);
  if (opts.help || !cmd) return void printHelp(COMMANDS.has(cmd) ? cmd : null);
  if (RETIRED_COMMANDS.has(cmd)) {
    throw new Error(`\`${cmd}\` is retired: ${RETIRED_COMMANDS.get(cmd)}\n` +
      `       Update it the way you installed it:\n` +
      `         bun add -g @hiroiku/dotagents   ${ui.dim('(or npm i -g)')}\n` +
      `       Then \`agents-setup update\` redelivers what is recorded here.`);
  }
  if (!COMMANDS.has(cmd)) {
    throw new Error(`unknown command: ${cmd}\n       Run \`agents-setup --help\` to see what is available.`);
  }
  migrateStateDir();
  migrateCorpus();
  // 見本は使う前に置く。status は読むだけのコマンドなので書かない。
  if (cmd !== 'status') seedModules(opts.force);
  switch (cmd) {
    case 'list': return list();
    case 'install':
      await confirmLooseTarget(opts);
      return install(await resolveAgents(await resolveModules(cmd, opts)));
    // update / uninstall は既存の記録に対して働く。記録が無ければそちらで止まるので、
    // 迷子のカレントディレクトリを塞ぐ関門は install にだけ要る。
    case 'update': return update(opts);
    case 'uninstall': return uninstall(await resolveRemovals(opts));
    case 'status': return status(opts);
  }
}

main()
  .catch((e) => {
    console.error(`${ui.red('Error:')} ${e.message}`);
    process.exitCode = 1;
  })
  .finally(closePrompt);
