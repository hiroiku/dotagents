#!/usr/bin/env node
'use strict';

// dotagents installer — payload/ を .agents/ へ配布し、manifest で所有権を管理する。
//
// 設計原則:
// - payload/ ディレクトリが配布物の唯一の定義である(installer 内に列挙を持たない)。
// - manifest(.dotagents.json)は「自分が置いたもの」だけを内容ハッシュ付きで記録する。
//   update / uninstall はハッシュが一致するファイルにしか触れない — ユーザーの改変と
//   自前スキルは常に保護される。
// - 環境断片(~/.zshenv の管理行・settings.json の env / hooks / permissions)も
//   「自分が追加したものだけを覚えて、それだけを除去する」。
// - 対象(ユーザーレベル / プロジェクト)は決して既定値で決まらない。フラグで明示するか、
//   対話で選ぶかのどちらかである — 指定し忘れが黙って別の場所を書き換える経路を作らない。
// - シェル層(hooks/bin + ~/.zshenv 行)は強制則の唯一の配達経路であり、zsh の起動ファイルが
//   ユーザーグローバルにしか無いため、プロジェクトの数によらず 1 つしか存在しない。共有資源
//   なので install は無ければ補い、uninstall は巻き添えで消さないか確認する。

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const crypto = require('node:crypto');
const readline = require('node:readline');
const { execFileSync } = require('node:child_process');

const REPO_ROOT = path.resolve(__dirname, '..');
const PAYLOAD = path.join(REPO_ROOT, 'payload');
const MANIFEST_NAME = '.dotagents.json';
const MARKER = '# agents-harness';
const SHELLENV_LINE = `[ -f "$HOME/.agents/hooks/shellenv.sh" ] && . "$HOME/.agents/hooks/shellenv.sh" ${MARKER}`;

// ---------------------------------------------------------------- helpers

function sha256(file) {
  return 'sha256:' + crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
}

function walk(dir, base = dir) {
  const out = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
    if (e.name === '.DS_Store') continue;
    const p = path.join(dir, e.name);
    if (e.isDirectory()) out.push(...walk(p, base));
    else out.push(path.relative(base, p));
  }
  return out;
}

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    if (e.code === 'ENOENT') return fallback;
    throw new Error(`cannot parse ${file} as JSON: ${e.message}`);
  }
}

function writeJson(file, obj) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(obj, null, 2) + '\n');
}

function lstatOrNull(p) {
  try { return fs.lstatSync(p); } catch { return null; }
}

function gitCommit() {
  try {
    return execFileSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
  } catch { return null; }
}

function pkg() {
  return readJson(path.join(REPO_ROOT, 'package.json'), { version: '0.0.0' });
}

function removeEmptyDirsUpTo(from, stopAt) {
  let dir = from;
  while (dir.startsWith(stopAt) && dir !== stopAt) {
    try { fs.rmdirSync(dir); } catch { return; }
    dir = path.dirname(dir);
  }
}

// ---------------------------------------------------------------- context

// 対象は opts.target(user / project / shell)ただ 1 つ。shell は「ユーザーレベルの最小形」
// なので場所としては user と同じ木を指す — 違うのは配る範囲(scope)だけである。
function makeCtx(opts) {
  if (opts.target === 'project') {
    const proj = path.resolve(opts.dir ?? '.');
    if (!lstatOrNull(proj)?.isDirectory()) throw new Error(`no such directory: ${proj}`);
    return {
      kind: 'project',
      root: path.join(proj, '.agents'),
      claudeDir: path.join(proj, '.claude'),
      codexDir: path.join(proj, '.codex'),
      zshenv: null, // シェル配達(zsh/BASH_ENV の実体)はユーザーレベルの担当
      relativeLinks: true,
    };
  }
  const home = os.homedir();
  return {
    kind: 'user',
    root: path.join(home, '.agents'),
    claudeDir: path.join(home, '.claude'),
    codexDir: path.join(home, '.codex'),
    zshenv: path.join(home, '.zshenv'),
    relativeLinks: false,
  };
}

function manifestPath(ctx) { return path.join(ctx.root, MANIFEST_NAME); }

// 断片は絶対パスを含むマシン固有の設定なので、プロジェクトでは版管理対象の
// settings.json ではなく settings.local.json に書く。
function settingsPath(ctx) {
  return path.join(ctx.claudeDir, ctx.kind === 'project' ? 'settings.local.json' : 'settings.json');
}

function ownedSkillNames() {
  const dir = path.join(PAYLOAD, 'skills');
  if (!lstatOrNull(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isDirectory())
    .map((e) => e.name)
    .sort();
}

// shell スコープ = 強制則の層(hooks / bin)だけ。プロンプト(AGENTS.md / skills / agents)と
// リンク・settings 断片を伴わないので、全セッションのプロンプトに影響せずガードだけが届く。
// zsh の起動ファイルはユーザーグローバル(~/.zshenv)しか無いため、シェル配達は構造的に
// ユーザーレベルの担当であり、その最小形がこのスコープである。
// npm は配布物から .gitignore を剥ぎ取るため、payload では無印の `gitignore` で持ち、
// 配布時に `.gitignore` へ戻す。写像はこの 1 対だけ(src = payload 内の名前、dst = 配布名)。
const SRC_RENAMES = { gitignore: '.gitignore' };

function payloadEntries(scope) {
  let rels = walk(PAYLOAD);
  if (scope === 'shell') {
    rels = rels.filter((r) => r.startsWith('hooks/') || r.startsWith('bin/'));
  }
  return rels.map((src) => ({ src, dst: SRC_RENAMES[src] ?? src }));
}

// シェル層の配線(zshenv 行・BASH_ENV・SessionStart)は、対応するフックが payload に
// 実在するときだけ張る。payload が配布物の唯一の定義なので、フックが消えたら配線も
// 「自分が張ったものだけ」を同じ所有権規則で除去する。
function shellDelivery() {
  return {
    shellenv: !!lstatOrNull(path.join(PAYLOAD, 'hooks', 'shellenv.sh')),
    session: !!lstatOrNull(path.join(PAYLOAD, 'hooks', 'beads-session.sh')),
  };
}

function ownedAgentNames() {
  const dir = path.join(PAYLOAD, 'agents');
  if (!lstatOrNull(dir)) return [];
  return fs.readdirSync(dir)
    .filter((n) => n.endsWith('.md'))
    .sort();
}

// リンクは「リンクの場所 → payload 内の到達先」を宣言的に列挙する。
// Codex はディレクトリを辿らないためスキル単位で張る。.codex/ が無い環境には作らない。
function desiredLinks(ctx) {
  const links = [
    { link: path.join(ctx.claudeDir, 'CLAUDE.md'), target: path.join(ctx.root, 'AGENTS.md') },
  ];
  // スキルは常にスキル単位でリンクする(ディレクトリごとの 1 本は張らない —
  // 自前スキルの実体と同じ場所に同居させるため)。例外は、既存の .claude/skills が
  // .agents/skills への symlink になっている環境(ユーザーの手張り)だけ:
  // 全スキルが既に見えているので張らず、そのリンクにも触れない。
  const skillsDir = path.join(ctx.claudeDir, 'skills');
  const skillsSt = lstatOrNull(skillsDir);
  const coveredByDirLink = !!(skillsSt && skillsSt.isSymbolicLink()) &&
    path.resolve(path.dirname(skillsDir), fs.readlinkSync(skillsDir)) === path.join(ctx.root, 'skills');
  if (!coveredByDirLink) {
    for (const name of ownedSkillNames()) {
      links.push({ link: path.join(skillsDir, name), target: path.join(ctx.root, 'skills', name) });
    }
  }
  // エージェント定義はファイル単位で張る(自前のエージェント定義と共存させるため)
  for (const file of ownedAgentNames()) {
    links.push({ link: path.join(ctx.claudeDir, 'agents', file), target: path.join(ctx.root, 'agents', file) });
  }
  if (lstatOrNull(ctx.codexDir)?.isDirectory()) {
    links.push({ link: path.join(ctx.codexDir, 'AGENTS.md'), target: path.join(ctx.root, 'AGENTS.md') });
    for (const name of ownedSkillNames()) {
      links.push({ link: path.join(ctx.codexDir, 'skills', name), target: path.join(ctx.root, 'skills', name) });
    }
  }
  return links;
}

function linkValue(ctx, l) {
  return ctx.relativeLinks ? path.relative(path.dirname(l.link), l.target) : l.target;
}

// ---------------------------------------------------------------- symlinks

// 戻り値: 'created'(自分が張った)/ 'exists'(同じ到達先が既にある)/ 'conflict'
function ensureLink(ctx, l, log) {
  const want = linkValue(ctx, l);
  const st = lstatOrNull(l.link);
  if (st) {
    if (st.isSymbolicLink()) {
      const cur = fs.readlinkSync(l.link);
      if (cur === want || path.resolve(path.dirname(l.link), cur) === l.target) {
        log.ok(`link ${l.link}`);
        return 'exists';
      }
      log.warn(`link conflict, leaving it alone (symlink points elsewhere): ${l.link} -> ${cur}`);
      return 'conflict';
    }
    log.warn(`link conflict, leaving it alone (a real file is already there): ${l.link}`);
    if (l.link.endsWith('CLAUDE.md') || l.link.endsWith('AGENTS.md')) {
      console.log(ui.dim(`    add a reference to .agents/AGENTS.md inside it and the harness still loads`));
    }
    return 'conflict';
  }
  fs.mkdirSync(path.dirname(l.link), { recursive: true });
  fs.symlinkSync(want, l.link);
  log.add(`link ${l.link} -> ${want}`);
  return 'created';
}

// 消してよいのは自分が張った(created: true の)リンクだけ。
// インストール前から存在した同内容のリンクはユーザーの持ち物であり、触れない。
function removeLink(ctx, l, log) {
  if (l.created !== true) return;
  const st = lstatOrNull(l.link);
  if (!st || !st.isSymbolicLink()) return;
  const cur = fs.readlinkSync(l.link);
  if (cur === linkValue(ctx, l) || path.resolve(path.dirname(l.link), cur) === l.target) {
    fs.unlinkSync(l.link);
    log.del(`link ${l.link}`);
  }
}

// ---------------------------------------------------------------- ~/.zshenv

function zshenvState(ctx) {
  if (!ctx.zshenv) return 'n/a';
  const text = fs.existsSync(ctx.zshenv) ? fs.readFileSync(ctx.zshenv, 'utf8') : '';
  const managed = text.split('\n').filter((l) => l.includes(MARKER));
  if (managed.length === 1 && managed[0] === SHELLENV_LINE) return 'ok';
  if (managed.length === 0) return 'missing';
  return 'stale';
}

function ensureZshenvLine(ctx, log) {
  if (!ctx.zshenv) return;
  if (zshenvState(ctx) === 'ok') { log.ok(`zshenv managed line`); return; }
  const text = fs.existsSync(ctx.zshenv) ? fs.readFileSync(ctx.zshenv, 'utf8') : '';
  const kept = text.split('\n').filter((l) => !l.includes(MARKER));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  kept.push(SHELLENV_LINE, '');
  fs.writeFileSync(ctx.zshenv, kept.join('\n'));
  log.add(`zshenv managed line (guarded)`);
}

function removeZshenvLine(ctx, log) {
  if (!ctx.zshenv || !fs.existsSync(ctx.zshenv)) return;
  const text = fs.readFileSync(ctx.zshenv, 'utf8');
  const kept = text.split('\n').filter((l) => !l.includes(MARKER));
  if (kept.join('\n') !== text) {
    fs.writeFileSync(ctx.zshenv, kept.join('\n'));
    log.del(`zshenv managed line`);
  }
}

// ---------------------------------------------------------------- settings.json 断片

function fragmentDefs(ctx) {
  return {
    // パスは除去(所有照合)にも使うため、payload の実在によらず常に導出する。
    // 配線するかどうかは shellDelivery() が決める。
    bashEnv: path.join(ctx.root, 'hooks', 'shellenv.sh'),
    sessionStart: path.join(ctx.root, 'hooks', 'beads-session.sh'),
    ask: [],
  };
}

function applySettings(ctx, oldFragments, log) {
  const defs = fragmentDefs(ctx);
  const has = shellDelivery();
  const file = settingsPath(ctx);
  const s = readJson(file, {});
  const owned = { bashEnv: false, sessionStart: false, ask: [] };
  let changed = false;

  s.env = s.env || {};
  if (!has.shellenv) {
    // payload が配達フックを持たない: 過去に自分が張った配線だけを除去する
    if (oldFragments?.bashEnv === true && s.env.BASH_ENV === defs.bashEnv) {
      delete s.env.BASH_ENV;
      changed = true;
      log.del(`settings env.BASH_ENV (no shellenv hook in payload)`);
    }
  } else if (s.env.BASH_ENV === undefined) {
    s.env.BASH_ENV = defs.bashEnv;
    owned.bashEnv = true;
    changed = true;
    log.add(`settings env.BASH_ENV`);
  } else if (s.env.BASH_ENV === defs.bashEnv) {
    // インストール前から同じ値があった場合はユーザーの持ち物。前回の所有記録だけ引き継ぐ
    owned.bashEnv = oldFragments?.bashEnv === true;
    log.ok(`settings env.BASH_ENV`);
  } else {
    log.warn(`settings env.BASH_ENV already set to something else, leaving it: ${s.env.BASH_ENV}`);
  }

  s.hooks = s.hooks || {};
  s.hooks.SessionStart = s.hooks.SessionStart || [];
  // 既存 entry は `bash <path>` のような前置き付きでも同一とみなす(重複登録の予防)
  const hasSession = s.hooks.SessionStart.some((m) =>
    (m.hooks || []).some((h) => (h.command || '').includes(defs.sessionStart)));
  if (!has.session) {
    if (oldFragments?.sessionStart === true && hasSession) {
      s.hooks.SessionStart = s.hooks.SessionStart
        .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(defs.sessionStart)) }))
        .filter((m) => (m.hooks || []).length > 0);
      changed = true;
      log.del(`settings hooks.SessionStart (no session hook in payload)`);
    }
  } else if (hasSession) {
    owned.sessionStart = oldFragments?.sessionStart === true;
    log.ok(`settings hooks.SessionStart`);
  } else {
    s.hooks.SessionStart.push({ hooks: [{ type: 'command', command: defs.sessionStart }] });
    owned.sessionStart = true;
    changed = true;
    log.add(`settings hooks.SessionStart`);
  }

  s.permissions = s.permissions || {};
  s.permissions.ask = s.permissions.ask || [];
  // 過去に自分が足したが defs から消えたルールは刈り込む(ファイルの刈り込みと同じ所有権規則)
  for (const rule of oldFragments?.ask || []) {
    if (!defs.ask.includes(rule) && s.permissions.ask.includes(rule)) {
      s.permissions.ask = s.permissions.ask.filter((r) => r !== rule);
      changed = true;
      log.del(`settings permissions.ask ${rule} (no longer in defs)`);
    }
  }
  for (const rule of defs.ask) {
    if (s.permissions.ask.includes(rule)) {
      // 以前の install で自分が足した記録があるときだけ所有を引き継ぐ
      if ((oldFragments?.ask || []).includes(rule)) owned.ask.push(rule);
      else log.ok(`settings permissions.ask ${rule} (pre-existing, not ours)`);
    } else {
      s.permissions.ask.push(rule);
      owned.ask.push(rule);
      changed = true;
      log.add(`settings permissions.ask ${rule}`);
    }
  }

  // 配線を張らなかった枝で初期化だけされた空の足場をユーザーのファイルに書き残さない
  if (s.env && Object.keys(s.env).length === 0) delete s.env;
  if (s.hooks?.SessionStart && s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
  if (s.hooks && Object.keys(s.hooks).length === 0) delete s.hooks;
  if (s.permissions?.ask && s.permissions.ask.length === 0) delete s.permissions.ask;
  if (s.permissions && Object.keys(s.permissions).length === 0) delete s.permissions;

  if (changed) writeJson(file, s);
  return owned;
}

function removeSettings(ctx, fragments, log) {
  if (!fragments) return;
  const defs = fragmentDefs(ctx);
  const file = settingsPath(ctx);
  const s = readJson(file, null);
  if (!s) return;
  let changed = false;

  if (fragments.bashEnv && s.env?.BASH_ENV === defs.bashEnv) {
    delete s.env.BASH_ENV;
    if (Object.keys(s.env).length === 0) delete s.env;
    changed = true;
    log.del(`settings env.BASH_ENV`);
  }
  if (fragments.sessionStart && s.hooks?.SessionStart) {
    const before = s.hooks.SessionStart.length;
    s.hooks.SessionStart = s.hooks.SessionStart
      .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(defs.sessionStart)) }))
      .filter((m) => (m.hooks || []).length > 0);
    if (s.hooks.SessionStart.length !== before) { changed = true; log.del(`settings hooks.SessionStart`); }
    if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
    if (Object.keys(s.hooks).length === 0) delete s.hooks;
  }
  if ((fragments.ask || []).length && s.permissions?.ask) {
    const before = s.permissions.ask.length;
    s.permissions.ask = s.permissions.ask.filter((r) => !fragments.ask.includes(r));
    if (s.permissions.ask.length !== before) { changed = true; log.del(`settings permissions.ask`); }
    if (s.permissions.ask.length === 0) delete s.permissions.ask;
    if (Object.keys(s.permissions).length === 0) delete s.permissions;
  }

  if (changed) writeJson(file, s);
}

// Codex は ~/.codex/hooks.json(プロジェクトは <proj>/.codex/hooks.json)に
// Claude の settings.json と同形の hooks を持つ。SessionStart 断片を同じ所有権規則で管理する。
function codexHooksPath(ctx) { return path.join(ctx.codexDir, 'hooks.json'); }

function applyCodexHooks(ctx, oldFragments, log) {
  if (!lstatOrNull(ctx.codexDir)?.isDirectory()) return false;
  if (!shellDelivery().session) {
    // payload がセッションフックを持たない: 過去に自分が張った断片だけを除去する
    removeCodexHooks(ctx, oldFragments, log);
    return false;
  }
  const sessionCmd = path.join(ctx.root, 'hooks', 'beads-session.sh');
  const file = codexHooksPath(ctx);
  const s = readJson(file, {});
  s.hooks = s.hooks || {};
  s.hooks.SessionStart = s.hooks.SessionStart || [];
  const has = s.hooks.SessionStart.some((m) => (m.hooks || []).some((h) => (h.command || '').includes(sessionCmd)));
  if (has) {
    log.ok('codex hooks.SessionStart');
    return oldFragments?.codexSessionStart === true;
  }
  s.hooks.SessionStart.push({ hooks: [{ type: 'command', command: sessionCmd, timeout: 10 }] });
  writeJson(file, s);
  log.add('codex hooks.SessionStart');
  return true;
}

function removeCodexHooks(ctx, fragments, log) {
  if (!fragments?.codexSessionStart) return;
  const sessionCmd = path.join(ctx.root, 'hooks', 'beads-session.sh');
  const s = readJson(codexHooksPath(ctx), null);
  if (!s?.hooks?.SessionStart) return;
  const before = JSON.stringify(s);
  s.hooks.SessionStart = s.hooks.SessionStart
    .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(sessionCmd)) }))
    .filter((m) => (m.hooks || []).length > 0);
  if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
  if (Object.keys(s.hooks).length === 0) delete s.hooks;
  if (JSON.stringify(s) !== before) {
    writeJson(codexHooksPath(ctx), s);
    log.del('codex hooks.SessionStart');
  }
}

function codexHooksState(ctx) {
  if (!lstatOrNull(ctx.codexDir)?.isDirectory()) return null;
  const sessionCmd = path.join(ctx.root, 'hooks', 'beads-session.sh');
  const s = readJson(codexHooksPath(ctx), {});
  return (s.hooks?.SessionStart || []).some((m) => (m.hooks || []).some((h) => (h.command || '').includes(sessionCmd)));
}

function settingsState(ctx) {
  const defs = fragmentDefs(ctx);
  const s = readJson(settingsPath(ctx), {});
  return {
    bashEnv: s.env?.BASH_ENV === defs.bashEnv,
    sessionStart: (s.hooks?.SessionStart || []).some((m) => (m.hooks || []).some((h) => (h.command || '').includes(defs.sessionStart))),
    ask: defs.ask.filter((r) => (s.permissions?.ask || []).includes(r)),
  };
}

// ---------------------------------------------------------------- 参照ブロック断片

// 既存の root AGENTS.md を持つプロジェクトでは、ハーネス正本への参照ブロックを
// マーカー付きで管理する。プロンプト層の配線なので版管理に乗り、clone だけで届く。
// マーカー間は installer の完全管理領域(zshenv 管理行と同じ扱い): install / update が
// 望む内容へ書き直し、uninstall が除去する。root AGENTS.md が無いプロジェクトには作らない。
const REF_BEGIN = '<!-- agents-harness:begin (dotagents installer が管理。手で編集しない) -->';
const REF_END = '<!-- agents-harness:end -->';
const REF_BODY = '- エージェントの運転規則は [.agents/AGENTS.md](.agents/AGENTS.md) を正本とする(dotagents ハーネスの配布物。インストール先を直接編集しない)。';

function rootAgentsFile(ctx) {
  return ctx.kind === 'project' ? path.join(path.dirname(ctx.root), 'AGENTS.md') : null;
}

function stripRefBlock(lines) {
  const kept = [];
  let inBlock = false;
  for (const l of lines) {
    if (l.trim() === REF_BEGIN) { inBlock = true; continue; }
    if (inBlock) { if (l.trim() === REF_END) inBlock = false; continue; }
    kept.push(l);
  }
  return kept;
}

function applyRefBlock(ctx, log) {
  const file = rootAgentsFile(ctx);
  if (!file || !lstatOrNull(file)?.isFile()) return false;
  const text = fs.readFileSync(file, 'utf8');
  const desired = [REF_BEGIN, REF_BODY, REF_END].join('\n');
  if (text.includes(desired)) {
    log.ok('AGENTS.md reference block');
    return true;
  }
  const kept = stripRefBlock(text.split('\n'));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  fs.writeFileSync(file, [...kept, '', desired, ''].join('\n'));
  log.add('AGENTS.md reference block (points the existing root AGENTS.md at the harness)');
  return true;
}

function removeRefBlock(ctx, fragments, log) {
  if (!fragments?.refBlock) return;
  const file = rootAgentsFile(ctx);
  if (!file || !lstatOrNull(file)?.isFile()) return;
  const text = fs.readFileSync(file, 'utf8');
  const kept = stripRefBlock(text.split('\n'));
  if (kept.join('\n') !== text) {
    while (kept.length && kept[kept.length - 1] === '') kept.pop();
    fs.writeFileSync(file, kept.length ? kept.join('\n') + '\n' : '');
    log.del('AGENTS.md reference block');
  }
}

function refBlockState(ctx) {
  const file = rootAgentsFile(ctx);
  if (!file || !lstatOrNull(file)?.isFile()) return null;
  return fs.readFileSync(file, 'utf8').includes([REF_BEGIN, REF_BODY, REF_END].join('\n'));
}

// ---------------------------------------------------------------- log

function makeLog() {
  const counts = { add: 0, update: 0, ok: 0, del: 0, warn: 0 };
  const line = (sym, key, paint) => (msg) => { counts[key]++; console.log(`  ${paint(sym)} ${msg}`); };
  return {
    add: line('+', 'add', ui.green),
    update: line('~', 'update', ui.yellow),
    ok: (msg) => { counts.ok++; },
    del: line('-', 'del', ui.gray),
    warn: line('!', 'warn', ui.yellow),
    counts,
  };
}

// 完了行。0 の項目は出さない(何が起きたかだけを残す)。
function summary(counts) {
  const parts = [];
  if (counts.add) parts.push(ui.green(`${counts.add} added`));
  if (counts.update) parts.push(ui.yellow(`${counts.update} updated`));
  if (counts.del) parts.push(ui.gray(`${counts.del} removed`));
  if (counts.ok) parts.push(ui.dim(`${counts.ok} unchanged`));
  if (counts.warn) parts.push(ui.yellow(`${counts.warn} warning${counts.warn > 1 ? 's' : ''}`));
  return parts.length ? parts.join(ui.dim(' · ')) : ui.dim('nothing to do');
}

// ---------------------------------------------------------------- 表示(色・幅)

// 色は端末が受け取れるときだけ。NO_COLOR(no-color.org)と dumb 端末を尊重する。
const COLOR = Boolean(process.stdout.isTTY) && !process.env.NO_COLOR && process.env.TERM !== 'dumb';
const sgr = (on, off) => (s) => (COLOR ? `\x1b[${on}m${s}\x1b[${off}m` : String(s));
const ui = {
  bold: sgr(1, 22),
  dim: sgr(2, 22),
  red: sgr(31, 39),
  green: sgr(32, 39),
  yellow: sgr(33, 39),
  cyan: sgr(36, 39),
  gray: sgr(90, 39),
};

const ANSI_RE = /\x1b\[[0-9;]*m/g;

// 東アジアの全角は 2 桁を占める。行が端末幅で折り返すと再描画の行数計算が壊れるため、
// セレクターは必ずこの幅で測ってから切り詰める。
function isWide(cp) {
  return (cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0x303e) ||
    (cp >= 0x3041 && cp <= 0x33ff) || (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0xa000 && cp <= 0xa4cf) ||
    (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) || (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x20000 && cp <= 0x3fffd);
}

function textWidth(s) {
  let w = 0;
  for (const ch of String(s).replace(ANSI_RE, '')) w += isWide(ch.codePointAt(0)) ? 2 : 1;
  return w;
}

function pad(s, width) {
  return s + ' '.repeat(Math.max(0, width - textWidth(s)));
}

// パスは末尾(どのプロジェクトか)が情報なので、あふれたら頭を落とす。
function truncHead(s, max) {
  if (textWidth(s) <= max) return s;
  const chars = [...s];
  let out = '';
  let w = 0;
  for (let i = chars.length - 1; i >= 0; i--) {
    const cw = isWide(chars[i].codePointAt(0)) ? 2 : 1;
    if (w + cw > max - 1) break;
    out = chars[i] + out;
    w += cw;
  }
  return '…' + out;
}

function homePath(p) {
  const home = os.homedir();
  return p === home || p.startsWith(home + path.sep) ? '~' + p.slice(home.length) : p;
}

function termWidth() {
  return process.stdout.columns && process.stdout.columns > 20 ? process.stdout.columns : 80;
}

// ---------------------------------------------------------------- 対話(セレクター)

function isInteractive() {
  return Boolean(process.stdin.isTTY && process.stdout.isTTY);
}

const CANCELLED = Symbol('cancelled');

// 矢印キーで選ぶ。何を打てばよいかを覚えさせず、選べる物を常に画面へ出す。
// options: [{ label, detail, hint, tone }]
function select({ title, notes = [], options }) {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    const width = termWidth();
    const labelWidth = Math.max(...options.map((o) => textWidth(o.label)));
    let index = 0;
    let drawn = 0;

    const paint = () => {
      const lines = [];
      lines.push('');
      lines.push(`  ${ui.bold(title)}`);
      for (const n of notes) lines.push(`  ${ui.dim(n)}`);
      lines.push('');
      options.forEach((o, i) => {
        const on = i === index;
        const tone = o.tone === 'danger' ? ui.red : ui.cyan;
        const label = on ? tone(ui.bold(pad(o.label, labelWidth))) : pad(o.label, labelWidth);
        const room = width - labelWidth - 8;
        const detail = o.detail ? (on ? ui.gray(truncHead(o.detail, room)) : ui.dim(truncHead(o.detail, room))) : '';
        lines.push(`  ${on ? tone('❯') : ' '} ${label}   ${detail}`.trimEnd());
        if (o.hint) lines.push(`      ${ui.dim(truncHead(o.hint, width - 8))}`);
      });
      lines.push('');
      lines.push(`  ${ui.dim('↑/↓ move · enter select · ctrl-c cancel')}`);

      let out = drawn ? `\x1b[${drawn}A` : '';
      out += lines.map((l) => `\x1b[2K${l}`).join('\n') + '\n';
      process.stdout.write(out);
      drawn = lines.length;
    };

    const finish = (value) => {
      stdin.removeListener('keypress', onKey);
      if (stdin.isTTY) stdin.setRawMode(false);
      stdin.pause();
      // 選択肢を畳んで、決めた結果だけを 1 行残す。
      const chosen = value === CANCELLED ? ui.red('cancelled') : ui.cyan(options[value].label);
      process.stdout.write(`\x1b[${drawn}A\x1b[0J  ${ui.green('✔')} ${ui.bold(title)}  ${chosen}\n`);
      process.stdout.write('\x1b[?25h');
      resolve(value);
    };

    const onKey = (str, key = {}) => {
      if (key.name === 'up' || key.name === 'k') { index = (index - 1 + options.length) % options.length; paint(); }
      else if (key.name === 'down' || key.name === 'j') { index = (index + 1) % options.length; paint(); }
      else if (key.name === 'return' || key.name === 'enter') finish(index);
      else if (key.name === 'escape' || key.name === 'q' || (key.ctrl && (key.name === 'c' || key.name === 'd'))) finish(CANCELLED);
    };

    readline.emitKeypressEvents(stdin);
    if (stdin.isTTY) stdin.setRawMode(true);
    stdin.resume();
    stdin.on('keypress', onKey);
    process.stdout.write('\x1b[?25l');
    paint();
  });
}

// 2 択も同じ器で聞く。返すのは真偽ではなく選ばれた値 — yes/no にすると、安全側を
// 先頭に置いた瞬間に呼び出し側が反転を抱える(`!yes` が「実行する」になる)。
// 先頭は常に影響範囲の狭い側に置く: 連打や早合点で決まっても被害が小さい方を既定にする。
async function pick(title, notes, options) {
  const i = await select({ title, notes, options });
  return i === CANCELLED ? CANCELLED : options[i].value;
}

function closePrompt() {
  if (process.stdout.isTTY) process.stdout.write('\x1b[?25h');
}

const TITLE = {
  install: 'Install where?',
  update: 'Update which installation?',
  uninstall: 'Uninstall from where?',
  status: 'Check which installation?',
};

// 対象は既定値では決まらない。明示されていれば対話しない、無ければ選ばせる、
// 選べない環境(非 TTY)なら止める — 指定し忘れが黙って別の場所に効く経路を作らない。
async function resolveTarget(cmd, opts) {
  if (opts.target) return opts;
  if (!isInteractive()) {
    throw new Error(
      `no target given for \`${cmd}\`. Pick exactly one:\n` +
      `         agents-setup ${cmd} user              ~/.agents\n` +
      `         agents-setup ${cmd} project [<dir>]   <dir>/.agents (defaults to the current directory)\n` +
      `       (run it in a terminal to choose interactively)`);
  }
  const cwd = process.cwd();
  // 影響範囲の狭い方(このプロジェクト)を初期選択に置く。連打や早合点で決まっても
  // 被害が 1 プロジェクトに閉じ、全プロジェクトに効く側は必ず一手を要する。
  const choice = await select({
    title: TITLE[cmd],
    options: [
      {
        label: 'This project',
        detail: homePath(path.join(cwd, '.agents')),
        hint: cwd === REPO_ROOT
          ? 'Prompts for this project only — note: this is the dotagents repo itself'
          : 'Prompts for this project only',
      },
      {
        label: 'User level',
        detail: homePath(path.join(os.homedir(), '.agents')),
        hint: 'Prompts and guard delivery, for every project',
      },
    ],
  });
  if (choice === CANCELLED) throw new Error('cancelled.');
  if (choice === 0) { opts.target = 'project'; opts.dir = cwd; }
  else opts.target = 'user';
  opts.interactive = true;
  return opts;
}

// ---------------------------------------------------------------- シェル層(共有資源)

// シェル層はユーザーレベルにしか存在できず、全プロジェクトが共有する。その健全性は
// 「manifest がある・配達フックの実体がある・zshenv 管理行が正しい」の 3 点で決まる。
function shellLayerState() {
  const uctx = makeCtx({});
  const m = readJson(manifestPath(uctx), null);
  if (!m) return 'missing';
  const delivered = !!lstatOrNull(path.join(uctx.root, 'hooks', 'shellenv.sh'));
  return delivered && zshenvState(uctx) === 'ok' ? 'ok' : 'partial';
}

// プロジェクト install の後始末。既存のユーザーレベル manifest があればその scope を保つ
// (full を shell へ縮小しない)。無ければ最小形の shell スコープで敷く。
async function ensureShellLayer(opts) {
  if (!payloadEntries('shell').length) return; // payload にシェル層が無ければ敷く物が無い
  if (shellLayerState() === 'ok') return;
  const m = readJson(manifestPath(makeCtx({})), null);
  if (opts.interactive) {
    const answer = await pick(
      'Set up guard delivery now?',
      [
        'It is missing — without it the shell-layer guards cannot fire.',
        'zsh only has a user-global startup file, so delivery always lives at the user level.',
      ],
      [
        { label: 'Skip', hint: 'Guards stay off; run `agents-setup install shell` later', value: 'skip' },
        {
          label: 'Set it up',
          detail: homePath(path.join(os.homedir(), '.agents')),
          hint: 'Adds hooks/bin here and one line to ~/.zshenv',
          value: 'setup',
        },
      ],
    );
    if (answer !== 'setup') return;
  } else {
    console.log(ui.dim(`\nAdding the missing guard delivery at the user level (its only possible home).`));
  }
  await install({ target: !m || m.scope === 'shell' ? 'shell' : 'user', force: opts.force });
}

// uninstall の前に、共有資源であるシェル層の扱いを決める。'keep' なら除去後に最小形で
// 敷き直し、'abort' なら何もしない。プロジェクトの uninstall はシェル層に届かないので、
// 判断の対象はユーザーレベルだけである。
async function resolveShellDisposition(ctx, m, opts) {
  if (!payloadEntries('shell').length) return 'remove'; // 残す・敷き直すシェル層が payload に無い
  if (ctx.kind === 'project') {
    if (opts.interactive) {
      console.log(ui.dim(`\n  Guard delivery lives at the user level; this removal does not touch it.`));
    }
    return 'remove';
  }
  if (opts.keepShell) return 'keep';
  if (m.scope === 'shell') {
    // 全体がシェル層なので「残す」は無い。壊す範囲を伝えて既定は中止に倒す。
    if (!opts.interactive) return 'remove';
    const answer = await pick(
      'Remove the guard delivery itself?',
      [
        'This installation IS the delivery (scope=shell).',
        'Removing it turns off the shell-layer guards everywhere on this HOME.',
      ],
      [
        { label: 'Cancel', hint: 'Leave the guards in place', value: 'abort' },
        {
          label: 'Remove anyway',
          detail: homePath(ctx.root),
          hint: 'Enforcement stops everywhere on this HOME',
          tone: 'danger',
          value: 'remove',
        },
      ],
    );
    return answer === 'remove' ? 'remove' : 'abort';
  }
  if (!opts.interactive) return 'remove';
  const answer = await pick(
    'Keep the guard delivery?',
    [
      'The user level also holds it: hooks/bin plus one line in ~/.zshenv, shared by every project.',
      'A project-level .agents cannot replace it — zsh is only reachable from here.',
    ],
    [
      { label: 'Keep the guards', hint: 'Remove the prompt layer only, keep enforcement working', value: 'keep' },
      {
        label: 'Remove everything',
        detail: homePath(ctx.root),
        hint: 'Enforcement stops in every project on this HOME',
        tone: 'danger',
        value: 'remove',
      },
    ],
  );
  if (answer === CANCELLED) return 'abort';
  return answer;
}

// ---------------------------------------------------------------- commands

async function install(opts, { requireExisting = false } = {}) {
  const ctx = makeCtx(opts);
  const log = makeLog();
  const old = readJson(manifestPath(ctx), null);
  if (requireExisting && !old) {
    throw new Error(`no manifest in ${homePath(ctx.root)} — run \`agents-setup install\` first.`);
  }
  // 対象 shell は必ずユーザーレベルを指すので、「project にシェル層を入れる」は表現できない
  // (以前は組み合わせを検証で弾いていた。構文で閉じたので検査は要らない)。
  // update はスコープを維持する。install shell で縮小、install user で全量へ拡大。
  const scope = opts.target === 'shell' ? 'shell' : (requireExisting && old?.scope === 'shell' ? 'shell' : 'full');

  // 1. payload → .agents/(所有ハッシュに基づく外科的コピー)
  const entries = payloadEntries(scope);
  const files = {};
  for (const { src: srcRel, dst: dstRel } of entries) {
    const src = path.join(PAYLOAD, srcRel);
    const dst = path.join(ctx.root, dstRel);
    const srcHash = sha256(src);
    const st = lstatOrNull(dst);
    const recorded = old?.files?.[dstRel];
    if (!st) {
      fs.mkdirSync(path.dirname(dst), { recursive: true });
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[dstRel] = srcHash;
      log.add(dstRel);
    } else if (sha256(dst) === srcHash) {
      files[dstRel] = srcHash;
      log.ok(dstRel);
    } else if (recorded && sha256(dst) === recorded) {
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[dstRel] = srcHash;
      log.update(dstRel);
    } else if (opts.force) {
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, fs.statSync(src).mode & 0o777);
      files[dstRel] = srcHash;
      log.update(`${dstRel}(--force で上書き)`);
    } else {
      log.warn(`modified in place, leaving it (use --force to overwrite): ${dst}`);
      if (recorded) files[dstRel] = recorded; // 所有記録は保持し、状態は status が報告する
    }
  }

  // 2. payload から消えたファイルの刈り込み(自分が置いた内容のままのものだけ)
  const dstSet = new Set(entries.map((e) => e.dst));
  for (const [rel, hash] of Object.entries(old?.files || {})) {
    if (files[rel] !== undefined || dstSet.has(rel)) continue;
    const dst = path.join(ctx.root, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.root);
      log.del(`${rel} (gone from payload)`);
    } else {
      log.warn(`gone from payload but modified in place, keeping it: ${dst}`);
    }
  }

  // 3. リンク(旧リンクの刈り込み → 現リンクの保証)。
  // 所有権は「自分が張った」事実で決まり、再 install では前回の記録を引き継ぐ。
  const links = scope === 'shell' ? [] : desiredLinks(ctx);
  const linkSet = new Set(links.map((l) => l.link));
  const oldLinks = new Map((old?.links || []).map((l) => [l.link, l]));
  for (const l of old?.links || []) {
    if (!linkSet.has(l.link)) removeLink(ctx, l, log);
  }
  const linkRecords = links.map((l) => {
    const r = ensureLink(ctx, l, log);
    const created = r === 'created' ? true : oldLinks.get(l.link)?.created === true;
    return { ...l, created };
  });

  // 4. 環境断片(shell スコープでは zshenv 行のみ。settings / codex 断片は書かず、
  // フルからの縮小時は自分の断片を除去する)。zshenv 行は配達フックが payload に
  // 実在するときだけ張り、無ければ管理行(マーカー付き = 常に自分の持ち物)を除去する。
  if (shellDelivery().shellenv) ensureZshenvLine(ctx, log);
  else removeZshenvLine(ctx, log);
  let fragments;
  if (scope === 'shell') {
    removeSettings(ctx, old?.fragments, log);
    removeCodexHooks(ctx, old?.fragments, log);
    fragments = { bashEnv: false, sessionStart: false, ask: [], codexSessionStart: false, refBlock: false };
  } else {
    fragments = applySettings(ctx, old?.fragments, log);
    fragments.codexSessionStart = applyCodexHooks(ctx, old?.fragments, log);
    fragments.refBlock = applyRefBlock(ctx, log);
  }

  // 5. manifest
  writeJson(manifestPath(ctx), {
    schema: 1,
    kind: ctx.kind,
    scope,
    version: pkg().version,
    source: REPO_ROOT,
    commit: gitCommit(),
    installedAt: new Date().toISOString(),
    files,
    skills: ownedSkillNames(),
    links: linkRecords,
    fragments,
  });

  const c = log.counts;
  console.log(`\n  ${ui.bold(ctx.kind)} ${ui.dim('→')} ${homePath(ctx.root)}`);
  console.log(`  ${summary(c)}`);
  if (c.warn > 0) process.exitCode = 1;

  // プロジェクトへ入れてもシェル層は付いてこない(配達はユーザーレベルにしかない)。
  // 「無ければ足す」を installer 側の責務にして、順序と回数の運用知識を要らなくする。
  if (ctx.kind === 'project') await ensureShellLayer(opts);
}

async function uninstall(opts) {
  const ctx = makeCtx(opts);
  const log = makeLog();
  const m = readJson(manifestPath(ctx), null);
  if (!m) throw new Error(`no manifest in ${homePath(ctx.root)} — nothing of ours to remove.`);

  const shell = await resolveShellDisposition(ctx, m, opts);
  if (shell === 'abort') { console.log(ui.dim('  Cancelled.')); return; }

  for (const l of m.links || []) removeLink(ctx, l, log);
  removeZshenvLine(ctx, log);
  removeSettings(ctx, m.fragments, log);
  removeCodexHooks(ctx, m.fragments, log);
  removeRefBlock(ctx, m.fragments, log);

  for (const [rel, hash] of Object.entries(m.files || {})) {
    const dst = path.join(ctx.root, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.root);
      log.del(rel);
    } else {
      log.warn(`modified in place, keeping it: ${dst}`);
    }
  }

  fs.unlinkSync(manifestPath(ctx));
  try { fs.rmdirSync(ctx.root); } catch { /* 自前スキル等が残っていれば残す */ }

  const c = log.counts;
  console.log(`\n  ${ui.bold('uninstall')} ${ui.dim('→')} ${homePath(ctx.root)}`);
  console.log(`  ${summary(c)}${ui.dim(' · your own skills and modified files were left alone')}`);

  // 一度すべて除去してから最小形で敷き直す。除去の外科性(自分が置いたものだけ)を
  // 保ったまま、共有資源だけが残る。
  if (shell === 'keep') {
    console.log(ui.dim(`\n  Keeping the guards: removing the prompt layer, re-laying the shell layer.`));
    await install({ target: 'shell', force: opts.force });
  }
}

function status(opts) {
  const ctx = makeCtx(opts);
  const m = readJson(manifestPath(ctx), null);
  let drift = 0;
  const report = (okc, msg) => {
    console.log(`  ${okc ? ui.green('ok') : ui.red('NG')}  ${okc ? msg : ui.bold(msg)}`);
    if (!okc) drift++;
  };

  if (!m) {
    console.log(`\n  ${ui.yellow('not installed')} ${ui.dim('—')} no manifest in ${homePath(ctx.root)}`);
    process.exitCode = 1;
    return;
  }

  const scope = m.scope === 'shell' ? 'shell' : 'full';
  console.log(`\n  ${ui.bold(m.kind)} ${ui.dim('→')} ${homePath(ctx.root)}`);
  console.log(ui.dim(`  scope=${scope} version=${m.version} commit=${(m.commit || 'unknown').slice(0, 12)} installed=${m.installedAt}`));
  console.log(ui.dim(`  source=${m.source}\n`));

  // payload との照合
  const entries = payloadEntries(scope);
  for (const { src: srcRel, dst: dstRel } of entries) {
    const dst = path.join(ctx.root, dstRel);
    const st = lstatOrNull(dst);
    if (!st) { report(false, `${dstRel} — missing`); continue; }
    const h = sha256(dst);
    if (h === sha256(path.join(PAYLOAD, srcRel))) report(true, dstRel);
    else if (h === m.files?.[dstRel]) report(false, `${dstRel} — payload is newer, run update`);
    else report(false, `${dstRel} — modified in place`);
  }
  const dstSet = new Set(entries.map((e) => e.dst));
  for (const rel of Object.keys(m.files || {})) {
    if (!dstSet.has(rel)) report(false, `${rel} — gone from payload, run update to prune`);
  }

  // リンク・環境断片(shell スコープはリンクと settings / codex 断片を持たない)
  if (scope !== 'shell') {
    for (const l of desiredLinks(ctx)) {
      const st = lstatOrNull(l.link);
      const okc = !!st && st.isSymbolicLink() &&
        (fs.readlinkSync(l.link) === linkValue(ctx, l) ||
          path.resolve(path.dirname(l.link), fs.readlinkSync(l.link)) === l.target);
      report(okc, `link ${l.link}`);
    }
  }
  // 環境断片の期待値は payload のフックの実在に従う(無いものは「張られていない」が正)
  const has = shellDelivery();
  if (ctx.zshenv) report(zshenvState(ctx) === (has.shellenv ? 'ok' : 'missing'), `zshenv managed line`);
  if (scope !== 'shell') {
    const st = settingsState(ctx);
    report(st.bashEnv === has.shellenv, `settings env.BASH_ENV`);
    report(st.sessionStart === has.session, `settings hooks.SessionStart`);
    report(st.ask.length === fragmentDefs(ctx).ask.length, `settings permissions.ask`);
    const cx = codexHooksState(ctx);
    if (cx !== null) report(cx === has.session, `codex hooks.SessionStart`);
    const rb = refBlockState(ctx);
    if (rb !== null) report(rb, `AGENTS.md reference block`);
  }

  console.log(drift === 0 ? `\n  ${ui.green('no drift')}` : `\n  ${ui.red(`drift: ${drift}`)}`);
  if (drift > 0) process.exitCode = 1;
}

// ---------------------------------------------------------------- main

// ---------------------------------------------------------------- 正本(取得と追従)
//
// 三層の動詞を分ける: clone(取得・初回)/ pull(追従・繰り返し)/ install・update(配備)。
// 追従の本体は git に委ねる — pull が包むのは「差分の提示 → 統合 → 検証」だけで、
// 配備の再同期は行わない(古さは各セッション入口の計器 agents-doctor が検出する)。

// この実行ファイルが編集可能な正本(git リポジトリ)の中にいるか。
// npx のキャッシュや tarball 展開は正本ではない — そこから黙って配備しない。
function isCorpus() {
  return Boolean(lstatOrNull(path.join(REPO_ROOT, '.git')));
}

function corpusGit(args, opts = {}) {
  return execFileSync('git', ['-C', REPO_ROOT, ...args], { encoding: 'utf8', ...opts });
}

// clone 元の解決: 明示(--from)→ package.json の repository → 実行元リポジトリの origin。
function cloneSource(opts) {
  if (opts.from) return opts.from;
  const repo = pkg().repository;
  const url = typeof repo === 'string' ? repo : repo?.url;
  if (url) return url.replace(/^git\+/, '');
  if (isCorpus()) {
    try { return corpusGit(['remote', 'get-url', 'origin']).trim(); } catch { /* origin 無し */ }
  }
  throw new Error('clone source unknown: pass --from <url|path>.');
}

function question(title) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(`  ${ui.bold(title)} `, (answer) => { rl.close(); resolve(answer.trim()); });
  });
}

async function clone(opts) {
  let dir = opts.cloneDir;
  if (!dir) {
    if (!isInteractive()) {
      throw new Error('no directory given for `clone`. The corpus lands where you say, never in a default:\n' +
        '         dotagents clone <dir>\n' +
        '       (run it in a terminal to type one interactively)');
    }
    dir = await question('Clone the corpus into which directory?');
    if (!dir) throw new Error('cancelled.');
  }
  dir = path.resolve(dir);
  const st = lstatOrNull(dir);
  if (st && (!st.isDirectory() || fs.readdirSync(dir).length)) {
    throw new Error(`not an empty directory: ${dir}`);
  }
  const src = cloneSource(opts);
  console.log(`${ui.dim('clone')} ${src} ${ui.dim('→')} ${homePath(dir)}`);
  execFileSync('git', ['clone', src, dir], { stdio: 'inherit' });
  console.log(`\n${ui.green('✔')} corpus cloned. It is yours to edit — rules live in git, deployments follow it.`);
  console.log(`${ui.dim('  next:')} ${homePath(path.join(dir, 'bin', 'agents-setup'))} install ${ui.dim('user | project [dir] | shell')}`);
  console.log(`${ui.dim('  follow upstream later with:')} ${homePath(path.join(dir, 'bin', 'agents-setup'))} pull`);
}

function pull() {
  if (corpusGit(['status', '--porcelain']).trim()) {
    throw new Error('the corpus has uncommitted changes. Commit or stash them first —\n' +
      '       pulling over local edits mixes upstream and your hand in one diff.');
  }
  let upstream;
  try {
    upstream = corpusGit(['rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}']).trim();
  } catch {
    throw new Error('no upstream branch. Set one (git branch --set-upstream-to=origin/<branch>) and retry.');
  }
  corpusGit(['fetch', '--quiet'], { stdio: ['ignore', 'inherit', 'inherit'] });
  const incoming = corpusGit(['log', '--oneline', `HEAD..${upstream}`]).trim();
  if (!incoming) {
    console.log(`${ui.green('✔')} already following ${upstream} — nothing new upstream.`);
    return;
  }
  // コミットタイトルの規約(業務上何が変わったか)が、そのまま人間の読める changelog になる
  console.log(`${ui.bold('incoming from')} ${upstream}:`);
  for (const line of incoming.split('\n')) console.log(`  ${line}`);
  console.log('');
  try {
    execFileSync('git', ['-C', REPO_ROOT, 'pull', '--rebase'], { stdio: 'inherit' });
  } catch {
    throw new Error('integration stopped (see git output above). Resolve, `git rebase --continue`, then re-run pull.');
  }
  if (pkg().scripts?.test) {
    console.log(`${ui.dim('verifying the merged corpus…')}`);
    try {
      execFileSync('npm', ['test'], { cwd: REPO_ROOT, stdio: ['ignore', 'ignore', 'inherit'] });
    } catch {
      throw new Error('pulled, but the corpus fails its own tests. Fix before deploying —\n' +
        '       do not run `update` from a red corpus.');
    }
  }
  const n = incoming.split('\n').length;
  console.log(`${ui.green('✔')} pulled ${n} commit${n === 1 ? '' : 's'} and verified.`);
  console.log(`${ui.dim('  deployments resync per install:')} agents-setup update ${ui.dim('… (each session entrance reports staleness)')}`);
}

// 正本の外(npx キャッシュ等)から配備系コマンドが呼ばれたら、既知の正本へ委譲する。
// 使い捨てコピーを source として manifest に記録する経路を作らない。
function delegateToCorpus(argv) {
  const manifest = readJson(path.join(os.homedir(), '.agents', MANIFEST_NAME), null);
  const source = manifest?.source;
  const bin = source && path.join(source, 'bin', 'agents-setup');
  if (source && source !== REPO_ROOT && lstatOrNull(bin)) {
    console.log(`${ui.dim('not a corpus here — delegating to')} ${homePath(source)}`);
    const r = require('node:child_process').spawnSync(process.execPath, [bin, ...argv], { stdio: 'inherit' });
    process.exitCode = r.status ?? 1;
    return;
  }
  throw new Error('this copy is disposable (npx cache or tarball), not an editable corpus.\n' +
    '       Get one first, then deploy from it:\n' +
    '         npx @hiroiku/dotagents clone <dir>\n' +
    `         <dir>/bin/agents-setup install user | project [dir] | shell`);
}

const COMMANDS = new Set(['clone', 'pull', 'install', 'update', 'uninstall', 'status']);
// 対象(配備先)を取らないコマンド。clone は取得先ディレクトリ、pull は引数なし。
const CORPUS_COMMANDS = new Set(['clone', 'pull']);
const TARGETS = new Set(['user', 'project', 'shell']);
// 旧インタフェース。エイリアスとしては生かさない(2 系統は維持費を二重に払う)。
// 正しい形へ案内するためだけに名前を覚えておく。
const RETIRED = new Set(['--user', '--project', '--shell']);

// 対象は位置引数 1 つ。位置は 1 つしか無いので「user と project の同時指定」は
// 表現できない — 排他は検証ではなく構文が保証する。
function parseArgs(argv) {
  const opts = { target: null, dir: null, cloneDir: null, from: null, force: false, keepShell: false, interactive: false, help: false, version: false };
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') opts.help = true;
    else if (a === '--version' || a === '-v') opts.version = true;
    else if (a === '--force') opts.force = true;
    else if (a === '--keep-shell') opts.keepShell = true;
    else if (a === '--from') {
      if (argv[i + 1] === undefined) throw new Error('--from takes a value: --from <url|path>');
      opts.from = argv[++i];
    }
    else if (RETIRED.has(a)) {
      throw new Error(`${a} is retired. The target is a positional argument now:\n` +
        `         agents-setup <command> user | project [<dir>] | shell`);
    }
    else if (a.startsWith('-')) throw new Error(`unknown argument: ${a}`);
    else positional.push(a);
  }

  const [cmd, target, dir, ...extra] = positional;
  // ヘルプと版の表示は引数の妥当性より優先する(`install --help` に対象を要求しない)
  if (opts.help || opts.version) return { cmd, opts };
  if (!COMMANDS.has(cmd)) return { cmd, opts };  // 使い方の表示へ

  // clone は取得先ディレクトリを 1 つ、pull は位置引数を取らない(配備の対象語彙と混ぜない)
  if (CORPUS_COMMANDS.has(cmd)) {
    if (cmd === 'pull' && target !== undefined) throw new Error(`\`pull\` takes no arguments: ${target}`);
    if (cmd === 'clone') {
      if (dir !== undefined || extra.length) throw new Error(`too many arguments: ${[dir, ...extra].filter(Boolean).join(' ')}`);
      opts.cloneDir = target ?? null;
    }
    return { cmd, opts };
  }

  if (target !== undefined) {
    if (!TARGETS.has(target)) {
      throw new Error(`unknown target: ${target} (expected user, project or shell)`);
    }
    opts.target = target;
  }
  if (dir !== undefined) {
    if (TARGETS.has(dir)) throw new Error(`pick exactly one target (got ${target} and ${dir}).`);
    if (target !== 'project') throw new Error(`only \`project\` takes a directory: ${dir}`);
    opts.dir = dir;
  }
  if (extra.length) throw new Error(`too many arguments: ${extra.join(' ')}`);

  return { cmd, opts };
}

// ---------------------------------------------------------------- help

// 対象の説明は 4 コマンドで同一なので 1 箇所に持つ(コマンドごとに書き写すと黙って古くなる)。
const TARGET_HELP = `${ui.bold('Target')} ${ui.dim('— exactly one. Omit it to choose interactively; never defaulted.')}
  ${ui.cyan('user')}           the user level (~/.agents)
  ${ui.cyan('project')} [dir]  a project (<dir>/.agents; defaults to the current directory)
  ${ui.cyan('shell')}          guard delivery only: hooks/bin and one line in ~/.zshenv.
                 No prompts, links or settings — every zsh gets the guards, nothing else.`;

const SHELL_NOTE = `The shell layer lives only at the user level and every project shares it.`;

const CMD_HELP = {
  clone: {
