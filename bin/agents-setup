#!/bin/sh
':' //# ; exec "$(command -v node || command -v bun)" "$0" "$@"
'use strict';

// 1–2 行目は sh と JS のどちらとしても読める。node があれば node、無ければ bun で
// 自分自身を exec し直す — bun しか無い機械でも、この 1 ファイルがそのまま入口になる。
// (sh では `:` が何もしない組み込み、JS では文字列リテラルと行コメント)

// dotagents installer — modules/ から選んだ物を各ツールが読む場所へ実ファイルで配り、
// manifest(~/.dotagents/)で所有権を管理する。
//
// 配達先:
// - Claude: .claude/skills/dotagents/ 1 つに plugin として。skills・agents・hooks が
//   名前空間 /dotagents:* の下に入り、settings.json を触らずにフックまで届く。
// - Codex : .agents/skills/dotagents-<name>/ と .codex/agents/*.toml へ。
// - AGENTS.md: 各ツールの規則ファイルへマーカー付きの管理ブロックとして。
//
// install はハッシュが一致するファイルにしか触れず、uninstall は manifest の記録だけを外す。
// 旧レイアウト(.agents・symlink・zshenv 行・settings 断片・名前空間の外の素のコピー)は
// install / update が同じ所有権規則で刈り込む。

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const crypto = require('node:crypto');
const readline = require('node:readline');
const { execFileSync } = require('node:child_process');

// 実装と、同梱の module が住む場所。どちらも npm から来て、一緒に新しくなる。
//
// 更新の経路は 1 本しかない。2 本あると必ず片方が古くなり、直した実装がもう一方の
// 追従を待つ羽目になる — 移行を担うコードが、移行される側に閉じ込められる。
// 使う人が自分で持つ物(~/.dotagents/modules/)だけが、この経路の外にある。
const PKG_ROOT = path.resolve(__dirname, '..');
// Claude へ配る plugin の名前 = スキルとエージェントの名前空間(/dotagents:git など)。
const PLUGIN = 'dotagents';
const AGENTS = ['claude', 'codex'];
const AGENT_LABELS = { claude: 'Claude Code', codex: 'Codex' };
// マシン固有の記録(manifest)の集約先。
// この仕組みの本拠地。根は 1 つだけ環境変数で動かせ、中身の位置はすべてそこから導出する。
const DOTAGENTS_HOME = () => (process.env.DOTAGENTS_HOME
  ? path.resolve(process.env.DOTAGENTS_HOME)
  : path.join(os.homedir(), '.dotagents'));
const CORPUS_DIR = () => path.join(DOTAGENTS_HOME(), 'corpus');
const PERSONAL_MODULES_DIR = () => path.join(DOTAGENTS_HOME(), 'modules');
const STATE_DIR = () => path.join(DOTAGENTS_HOME(), 'state');

// 見本の module の在処。ここは「読みに行く場所」ではなく「置いてくる元」である
// (seedModules を見よ) — 置き場は ~/.dotagents/modules/ の 1 つだけだからだ。
const SEED_MODULES_DIR = path.join(PKG_ROOT, 'modules');
// 見本の配布元の名。誰の意見かを言えるようにするためだけに在る — 出どころを名乗らない
// 規則は、消してよいのか直してよいのかが分からない。
const VENDOR = 'hiroiku';
// 旧レイアウト(<base>/.agents)の manifest 名と zshenv 管理行 — 刈り込み(移行)専用。
const LEGACY_MANIFEST_NAME = '.dotagents.json';
const MARKER = '# agents-harness';

// ---------------------------------------------------------------- helpers

function sha256(file) {
  return sha256buf(fs.readFileSync(file));
}

function sha256buf(buf) {
  return 'sha256:' + crypto.createHash('sha256').update(buf).digest('hex');
}

// requires の検出に使う。
function onPath(cmd) {
  return (process.env.PATH || '').split(path.delimiter).filter(Boolean).some((d) => {
    try { fs.accessSync(path.join(d, cmd), fs.constants.X_OK); return true; } catch { return false; }
  });
}

function walk(dir, base = dir) {
  const out = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
    if (e.name === '.DS_Store') continue;
    const p = path.join(dir, e.name);
    if (e.isDirectory()) out.push(...walk(p, base));
    else out.push(path.relative(base, p));
  }
  return out;
}

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    if (e.code === 'ENOENT') return fallback;
    throw new Error(`cannot parse ${file} as JSON: ${e.message}`);
  }
}

// 書き込みは同じディレクトリの一時ファイルへ行い、rename(2) で入れ替える。POSIX の rename は
// 原子的なので、途中で死んでも半分書けたファイルが残らない。配布物より、ユーザー自身の記述と
// 同居する CLAUDE.md が切り詰められる方が重い — どちらも同じ経路を通す。
function writeFileAtomic(file, data, mode) {
  const tmp = path.join(path.dirname(file), `.${path.basename(file)}.dotagents-${process.pid}`);
  try {
    fs.writeFileSync(tmp, data);
    if (mode !== undefined) fs.chmodSync(tmp, mode);
    fs.renameSync(tmp, file);
  } catch (e) {
    try { fs.unlinkSync(tmp); } catch { /* 後始末の失敗で、元の失敗を隠さない */ }
    throw e;
  }
}

// 記録は「置いた物」だけでなく「どの module が置いたか」も持つ。持たないと、供給元を失った
// module のファイルと、外された module のファイルを区別できない — 前者は残し、後者は刈る。
// schema 3 までは値がハッシュ文字列だったので、読む側が両方を受ける。
const fileHash = (v) => (typeof v === 'string' ? v : v?.hash);
const fileOwner = (v) => (typeof v === 'string' ? null : v?.module ?? null);

function writeJson(file, obj) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  writeFileAtomic(file, JSON.stringify(obj, null, 2) + '\n');
}

function lstatOrNull(p) {
  try { return fs.lstatSync(p); } catch { return null; }
}

// 配布先の途中にあるリンクも辿らない。--force はユーザーの別ディレクトリへ
// 書き込む許可ではない。規則の明示的な共通正本は呼び出し側で解決する。
function blockedPath(ctx, file, includeFile = true) {
  const parts = path.relative(ctx.base, file).split(path.sep);
  let current = ctx.base;
  for (let i = 0; i < parts.length; i++) {
    current = path.join(current, parts[i]);
    if (!includeFile && i === parts.length - 1) break;
    const st = lstatOrNull(current);
    if (!st) break;
    if (st.isSymbolicLink() || (i === parts.length - 1 ? !st.isFile() : !st.isDirectory())) return current;
  }
  return null;
}

function pkg() {
  return readJson(path.join(PKG_ROOT, 'package.json'), { version: '0.0.0' });
}

function removeEmptyDirsUpTo(from, stopAt) {
  let dir = from;
  while (dir.startsWith(stopAt) && dir !== stopAt) {
    try { fs.rmdirSync(dir); } catch { return; }
    dir = path.dirname(dir);
  }
}

// 空ディレクトリの遡り削除は各ツールのディレクトリ(.claude / .codex)で止める。
// それ自体はユーザーの持ち物なので、空でも消さない。
function pruneStop(ctx, dst) {
  for (const d of [ctx.claudeDir, ctx.codexDir, path.join(ctx.base, '.agents')]) {
    if (dst.startsWith(d + path.sep)) return d;
  }
  return ctx.base;
}

// ---------------------------------------------------------------- context

// 対象は既定でカレントのプロジェクト、-g のときだけユーザーレベル。base = 配達の基準
// ディレクトリで、manifest のファイルキーはすべて base 相対。legacyRoot は刈り込み専用。
function makeCtx(opts) {
  if (!opts.global) {
    let proj = path.resolve(opts.dir ?? '.');
    if (!lstatOrNull(proj)?.isDirectory()) throw new Error(`no such directory: ${proj}`);
    proj = fs.realpathSync(proj); // manifest のキーを安定させる(symlink 経由の表記揺れを吸収)
    return {
      agents: opts.agents,
      kind: 'project',
      base: proj,
      claudeDir: path.join(proj, '.claude'),
      codexDir: path.join(proj, '.codex'),
      zshenv: null, // 旧シェル配達はユーザーレベルにしか無かった
      legacyRoot: path.join(proj, '.agents'),
    };
  }
  const home = os.homedir();
  return {
    agents: opts.agents,
    kind: 'user',
    base: home,
    claudeDir: path.join(home, '.claude'),
    codexDir: path.join(home, '.codex'),
    zshenv: path.join(home, '.zshenv'),
    legacyRoot: path.join(home, '.agents'),
  };
}

// manifest はマシン固有の状態なので ~/.dotagents/ に集約する。プロジェクトは
// 実パスで一意にキー化する(basename は人間の識別用、hash が同名の衝突を防ぐ)。
function manifestPath(ctx) {
  if (ctx.kind === 'user') return path.join(STATE_DIR(), 'user.json');
  const hash = crypto.createHash('sha256').update(ctx.base).digest('hex').slice(0, 12);
  return path.join(STATE_DIR(), 'projects', `${path.basename(ctx.base)}-${hash}.json`);
}

function legacyManifestPath(ctx) { return path.join(ctx.legacyRoot, LEGACY_MANIFEST_NAME); }

function recordAgent(rel, record) {
  return record?.agent ?? (rel.startsWith('.claude/') ? 'claude' : 'codex');
}

function defaultAgents(ctx) {
  const codex = lstatOrNull(ctx.codexDir)?.isDirectory() ||
    (ctx.kind === 'project' && lstatOrNull(path.join(ctx.base, 'AGENTS.md')));
  return codex ? [...AGENTS] : ['claude'];
}

// 旧記録は実際に配った先から読み替える。新しいディレクトリの有無で、更新先を増やさない。
function recordedAgentModules(ctx, manifest) {
  if (!manifest) return {};
  if (manifest.agentModules) return Object.fromEntries(Object.entries(manifest.agentModules)
    .map(([agent, names]) => [agent, followRenames(names)]));
  const modules = followRenames(manifest.modules ?? [SOLE_MODULE_THEN]);
  const result = { claude: modules };
  const codexFiles = Object.entries(manifest.files ?? {}).filter(([rel, v]) => recordAgent(rel, v) === 'codex');
  const codexRules = (manifest.rulesBlocks ?? []).some((r) => !r.file.startsWith('.claude/'));
  if (codexFiles.length || codexRules) {
    const owned = codexFiles.map(([, v]) => fileOwner(v));
    const rules = codexRules ? Object.keys(manifest.rulesBodies ?? {}) : [];
    result.codex = owned.includes(null) || (codexRules && !manifest.rulesBodies)
      ? modules : followRenames([...new Set([...owned, ...rules])]);
  }
  return result;
}

function recordedAgentBodies(manifest, agentModules) {
  return Object.fromEntries(Object.entries(agentModules).map(([agent, names]) => [agent,
    manifest?.agentRulesBodies?.[agent] ?? Object.fromEntries(Object.entries(manifest?.rulesBodies ?? {})
      .filter(([n]) => names.includes(n))),
  ]));
}

function rulesRecordAgents(ctx, record) {
  if (record.agents) return record.agents;
  if (record.file === path.join('.agents', 'AGENTS.md')) return [...AGENTS];
  return [recordAgent(record.file, record)];
}

// 記録は本拠地の直下に置いていた。modules/ と並ぶようになったので state/ へ移す。
function migrateStateDir() {
  const home = DOTAGENTS_HOME();
  const moves = [['user.json', 'user.json'], ['projects', 'projects']];
  for (const [from, to] of moves) {
    const src = path.join(home, from);
    const dst = path.join(STATE_DIR(), to);
    if (!lstatOrNull(src) || lstatOrNull(dst)) continue;
    fs.mkdirSync(STATE_DIR(), { recursive: true });
    fs.renameSync(src, dst);
  }
}

// 旧レイアウトが断片を書いた settings の場所(プロジェクトは settings.local.json)。刈り込みに使う。
function settingsPath(ctx) {
  return path.join(ctx.claudeDir, ctx.kind === 'project' ? 'settings.local.json' : 'settings.json');
}

// ---------------------------------------------------------------- modules(規則の編成単位)

// module の概念を持たない記録(旧レイアウトを含む)が指していた、当時の唯一の配布物。
// これは記録の書式についての知識であって、正本の中身についての知識ではない。
const SOLE_MODULE_THEN = 'harness';

// 退役した名前 → それを受け継いだ module。憶えている名前が正本から無くなったとき、それが
// 消滅なのか、改名や分割なのかは記録の側からは判らない。知っているのは受け継いだ側だけ
// なので、宣言するのは module.json の replaces である — installer は対応表を持たない。
// 正本が変われば対応も一緒に変わり、同期のずれで古びる物が無い。
function renameMap() {
  const index = moduleIndex();
  const heirs = new Map();
  for (const name of index.keys()) {
    for (const old of moduleMeta(name).replaces) {
      // まだ在る名前は誰にも受け継がれていない。生きている module を横取りさせない。
      if (index.has(old)) continue;
      heirs.set(old, [...(heirs.get(old) ?? []), name].sort());
    }
  }
  return heirs;
}

// 記録が憶えている module 名を、今の正本の語彙へ直す。
function followRenames(names, heirs = renameMap()) {
  return [...new Set(names.flatMap((n) => heirs.get(n) ?? [n]))].sort();
}

// ---------------------------------------------------------------- 見本を置く(seed)

// 見本は読みに行く場所ではなく、置いてくる物である。置いた後はその人の物として扱う:
// 触っていない写しだけを新しくし、編集した物は残し、消した物は二度と作らない。
// 配布物に対して既に効いている所有ハッシュの規則を、そのまま自分の置き場へ広げている。
const seedRecordPath = () => path.join(STATE_DIR(), 'seed.json');

// 名前 → 'sample'(置いたまま) / 'edited'(手が入っている) / 'yours'(見本ではない)。
// 出どころを分ける唯一の軸がこれである — 置き場は 1 つで、違いは中身にしかない。
function seedStates() {
  const rec = readJson(seedRecordPath(), null);
  const states = new Map();
  for (const [name, known] of Object.entries(rec?.modules ?? {})) {
    const dir = path.join(PERSONAL_MODULES_DIR(), name);
    if (!lstatOrNull(dir)) continue;
    const same = Object.entries(known.files).every(([rel, h]) => {
      const p = path.join(dir, rel);
      return lstatOrNull(p) && sha256(p) === h;
    }) && walk(dir).every((rel) => known.files[rel] !== undefined);
    states.set(name, same ? 'sample' : 'edited');
  }
  return states;
}

function seedModules(force) {
  if (!lstatOrNull(SEED_MODULES_DIR)?.isDirectory()) return;
  const rec = readJson(seedRecordPath(), null) ?? { schema: 1, modules: {} };
  const home = PERSONAL_MODULES_DIR();
  const placed = [], updated = [], edited = [];
  let dirty = false;

  for (const e of fs.readdirSync(SEED_MODULES_DIR, { withFileTypes: true })) {
    if (!e.isDirectory() || !lstatOrNull(path.join(SEED_MODULES_DIR, e.name, 'module.json'))) continue;
    const src = path.join(SEED_MODULES_DIR, e.name);
    const dst = path.join(home, e.name);
    const known = rec.modules[e.name];
    // 消したのは意思である。見本が新しくなっても作り直さない。
    if (known && !lstatOrNull(dst)) continue;
    const was = known?.files ?? {};
    const now = {};
    let wrote = 0, held = false;

    for (const rel of walk(src)) {
      const from = path.join(src, rel);
      const to = path.join(dst, rel);
      const hash = sha256(from);
      const st = lstatOrNull(to);
      if (!st) {
        // 憶えている物が無いなら、消したということ。憶えが無いなら、見本に増えた物である。
        if (was[rel] !== undefined && !force) continue;
      } else if (sha256(to) === hash) {
        now[rel] = hash;
        continue;
      } else if (!(was[rel] !== undefined && sha256(to) === was[rel]) && !force) {
        now[rel] = was[rel] ?? sha256(to); // 編集した物は残し、所有の記録だけ保つ
        held = true;
        continue;
      }
      fs.mkdirSync(path.dirname(to), { recursive: true });
      writeFileAtomic(to, fs.readFileSync(from), fs.statSync(from).mode & 0o777);
      now[rel] = hash;
      wrote++;
    }
    // 見本から消えたファイルは、触られていなければ刈る
    for (const [rel, h] of Object.entries(was)) {
      if (now[rel] !== undefined) continue;
      const to = path.join(dst, rel);
      if (lstatOrNull(to) && sha256(to) === h) {
        fs.unlinkSync(to);
        removeEmptyDirsUpTo(path.dirname(to), dst);
      }
    }
    if (!known && wrote) placed.push(e.name);
    else if (wrote) updated.push(e.name);
    if (held) edited.push(e.name);
    rec.modules[e.name] = { files: now };
    dirty = true;
  }

  if (!dirty) return;
  rec.version = pkg().version;
  writeJson(seedRecordPath(), rec);
  // 配達の数には混ぜない。ここで起きたのは見本の設置であって、配備ではない。
  if (placed.length) {
    console.log(`  ${ui.green('+')} ${placed.join(' ')} ${ui.dim(`→ ${homePath(home)} (yours now — edit or delete them freely)`)}`);
  }
  if (updated.length) console.log(`  ${ui.yellow('~')} ${updated.join(' ')} ${ui.dim('(refreshed from the sample set)')}`);
  if (edited.length) console.log(`  ${ui.dim(`  kept your edits in ${edited.join(' ')}${force ? '' : ' (--force to take the sample version)'}`)}`);
}

// module の在処は 1 つだけ — ~/.dotagents/modules/ である。見本もここへ実体で置かれるので、
// 「読む場所」と「自分の場所」が分かれていない。要らない物は消せ、真似して直せ、隣に自分の
// 物を足せる。それが一目で分かることが、経路の純度より価値がある。
function moduleSources() {
  return [{ root: PERSONAL_MODULES_DIR() }];
}

// 名前 → { dir }。名前はディレクトリ名であり、同じ場所に同じ名前は 2 つ作れない。
function moduleIndex() {
  const index = new Map();
  for (const src of moduleSources()) {
    if (!lstatOrNull(src.root)?.isDirectory()) continue;
    for (const e of fs.readdirSync(src.root, { withFileTypes: true })) {
      if (!e.isDirectory() || !lstatOrNull(path.join(src.root, e.name, 'module.json'))) continue;
      index.set(e.name, { name: e.name, dir: path.join(src.root, e.name) });
    }
  }
  return index;
}

function moduleNames() {
  return [...moduleIndex().keys()].sort();
}

function moduleDir(name) {
  const found = moduleIndex().get(name);
  if (!found) throw new Error(`unknown module: ${name}`);
  return found.dir;
}

function moduleMeta(name) {
  const meta = readJson(path.join(moduleDir(name), 'module.json'), {});
  return {
    name,
    description: typeof meta.description === 'string' ? meta.description : '',
    requires: Array.isArray(meta.requires) ? meta.requires.filter((r) => typeof r === 'string') : [],
    // この module が受け継いだ、もう正本に無い名前。移行が済んだと判断したら消せばよい。
    replaces: Array.isArray(meta.replaces) ? meta.replaces.filter((r) => typeof r === 'string') : [],
  };
}

// module が要る外部コマンドのうち、この機械に無いもの。導入は代行せず、
// 無くても配備は通す。
function missingRequirements(name) {
  return moduleMeta(name).requires.filter((cmd) => !onPath(cmd));
}

// 退役した名前は、別名として生かさない — 正しい形へ案内して止まる。行き先を知っているのに
// 黙るのは、記録が無言で追従するのと釣り合わない。手順書もスクリプトも、ここを読んで直る。
function assertKnownModules(names) {
  const known = new Set(moduleNames());
  const unknown = names.filter((n) => !known.has(n));
  if (!unknown.length) return;
  const heirs = renameMap();
  const say = (n) => {
    const to = heirs.get(n);
    if (!to) return `unknown module: ${n}`;
    return `${n} is retired — it was ${to.length > 1 ? 'split into' : 'renamed to'} ${to.join(' ')}. Name those instead.`;
  };
  throw new Error(`${unknown.map(say).join('\n       ')}\n` +
    `       Run \`agents-setup list\` to see what you can install.`);
}

// plugin の身元。内容は選んだ module 群から導出されるので、コピーではなく生成して配る。
function pluginManifest(modules) {
  return JSON.stringify({
    name: PLUGIN,
    description: `dotagents — ${modules.join(' · ')}`,
    version: pkg().version,
  }, null, 2) + '\n';
}

// 配備しない物。module の残りはすべて plugin の中身なので、種類を数え上げない —
// skills/ と agents/ と hooks/ に限らず、plugin が解する物はそのまま運べる。
const NOT_DELIVERED = new Set(['module.json', 'AGENTS.md', 'README.md', 'docs']);

// 配達先の導出:
// - module の中身  → Claude: plugin の同じ位置(skills/<name>/ は /dotagents:<name> になる)
// - skills/<name>/ → Codex : .agents/skills/dotagents-<name>/
// - agents/*.md    → Codex : .codex/agents/dotagents-<name>.toml
// - AGENTS.md      → コピーではなく規則ファイルへの管理ブロック(rulesTargets)
function deliveryEntries(ctx, modules, { keepPlugin = false, agents = AGENTS } = {}) {
  const entries = [];
  const seen = new Map();
  const known = new Set(moduleNames());
  const agentModules = ctx.agentModules ?? Object.fromEntries(defaultAgents(ctx).map((a) => [a, modules]));
  const add = (e) => {
    const rel = path.relative(ctx.base, e.dst);
    if (seen.has(rel)) throw new Error(`modules ${seen.get(rel)} and ${e.module} both deliver ${rel}.`);
    seen.set(rel, e.module);
    entries.push({ ...e, rel });
  };
  for (const [agent, names] of Object.entries(agentModules)) {
    if (!agents.includes(agent)) continue;
    const present = names.filter((n) => known.has(n));
    const pluginRoot = path.join(ctx.claudeDir, 'skills', PLUGIN);
    const before = entries.length;
    for (const m of present) {
      const root = moduleDir(m);
      if (agent === 'claude') {
        for (const rel of walk(root)) {
          if (NOT_DELIVERED.has(rel.split(path.sep)[0]) || rel.startsWith('codex/')) continue;
          add({ agent, module: m, src: path.join(root, rel), dst: path.join(pluginRoot, rel), unit: pluginRoot });
        }
      } else {
        const skills = path.join(root, 'skills');
        if (lstatOrNull(skills)?.isDirectory()) {
          for (const skill of fs.readdirSync(skills, { withFileTypes: true }).filter((e) => e.isDirectory())) {
            const unit = path.join(ctx.base, '.agents', 'skills', `${PLUGIN}-${skill.name}`);
            for (const rel of walk(path.join(skills, skill.name))) {
              const src = path.join(skills, skill.name, rel);
              add({ agent, module: m, src, ...(rel === 'SKILL.md' ? { content: codexSkill(src, skill.name, moduleMeta(m).description) } : {}), dst: path.join(unit, rel), unit });
            }
          }
        }
        const roles = path.join(root, 'agents');
        if (lstatOrNull(roles)?.isDirectory()) {
          for (const rel of walk(roles).filter((rel) => rel.endsWith('.md'))) {
            const role = codexAgent(path.join(roles, rel), path.join(root, 'codex', 'agents'));
            if (role.override) continue;
            const dst = path.join(ctx.codexDir, 'agents', `${role.name}.toml`);
            add({ agent, module: m, content: role.content, dst, unit: path.dirname(dst) });
          }
        }
        // Native Codex assets allow modules to add hooks or role overrides without
        // pretending that Claude-specific configuration is portable.
        const native = path.join(root, 'codex');
        if (lstatOrNull(native)?.isDirectory()) {
          for (const rel of walk(native)) {
            add({ agent, module: m, src: path.join(native, rel), dst: path.join(ctx.codexDir, rel), unit: ctx.codexDir });
          }
        }
      }
    }
    if (agent === 'claude' && (entries.length > before || (keepPlugin && names.length))) {
      add({ agent, module: null, content: pluginManifest(present),
        dst: path.join(pluginRoot, '.claude-plugin', 'plugin.json'), unit: pluginRoot });
    }
  }
  return entries;
}

function codexAgent(file, nativeRoot) {
  const text = fs.readFileSync(file, 'utf8');
  const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
  if (!match) throw new Error(`agent needs YAML frontmatter: ${file}`);
  const scalar = (key) => {
    const raw = match[1].match(new RegExp(`^${key}: *(.+)$`, 'm'))?.[1]?.trim();
    if (!raw) return '';
    if (raw.startsWith('"')) return JSON.parse(raw);
    if (raw.startsWith("'")) return raw.slice(1, -1).replaceAll("''", "'");
    if (/^[>|]/.test(raw)) throw new Error(`use a single-line ${key} or a native codex/agents TOML file: ${file}`);
    return raw;
  };
  const name = `${PLUGIN}-${scalar('name') || path.basename(file, '.md')}`;
  if (/^[a-zA-Z0-9_-]+$/.test(name) && lstatOrNull(path.join(nativeRoot, `${name}.toml`))?.isFile()) return { name, override: true };
  const description = scalar('description');
  if (!/^[a-zA-Z0-9_-]+$/.test(name) || !description) throw new Error(`invalid agent name or description: ${file}`);
  const tools = scalar('tools').split(',').map((t) => t.trim());
  const readOnly = tools.length > 0 && tools.every((t) => ['Read', 'Glob', 'Grep', 'Bash', 'WebFetch', 'WebSearch'].includes(t));
  const fields = { name, description, ...(readOnly ? { sandbox_mode: 'read-only' } : {}), developer_instructions: match[2].trim() };
  return { name, content: Object.entries(fields).map(([k, v]) => `${k} = ${JSON.stringify(v)}`).join('\n') + '\n' };
}

function codexSkill(file, name, description) {
  const text = fs.readFileSync(file, 'utf8');
  const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
  const field = `name: ${PLUGIN}-${name}`;
  if (!match) return `---\n${field}\ndescription: ${JSON.stringify(description)}\n---\n\n${text}`;
  const metadata = /^name:/m.test(match[1]) ? match[1].replace(/^name:.*$/m, field) : `${field}\n${match[1]}`;
  return `---\n${metadata}\n---\n${match[2]}`;
}

function unsupportedCodexHooks(modules) {
  return modules.filter((name) => {
    const root = moduleDir(name);
    return lstatOrNull(path.join(root, 'hooks'))?.isDirectory() && walk(path.join(root, 'hooks')).length &&
      !lstatOrNull(path.join(root, 'codex', 'hooks.json'))?.isFile();
  });
}

// 生成される配達物(plugin.json)と、正本からコピーされる物を同じ所有権規則で扱う。
function entryHash(e) {
  return e.content !== undefined ? sha256buf(Buffer.from(e.content)) : sha256(e.src);
}

function writeEntry(e) {
  fs.mkdirSync(path.dirname(e.dst), { recursive: true });
  if (e.content !== undefined) return void writeFileAtomic(e.dst, e.content);
  // フックの実行ビットを保つ。規則は小さいので、丸ごと読んでから一息で置き換える。
  writeFileAtomic(e.dst, fs.readFileSync(e.src), fs.statSync(e.src).mode & 0o777);
}

// 消してよいのは自分が張った(created: true の)旧リンクだけ。
// インストール前から存在した同内容のリンクはユーザーの持ち物であり、触れない。
function removeLink(l, log) {
  if (l.created !== true) return;
  const st = lstatOrNull(l.link);
  if (!st || !st.isSymbolicLink()) return;
  const cur = fs.readlinkSync(l.link);
  if (cur === l.target || path.resolve(path.dirname(l.link), cur) === l.target) {
    fs.unlinkSync(l.link);
    log.del(`legacy link ${l.link}`);
  }
}

// 共通正本へのリンクを除き、旧 .agents を指すリンクと切れたリンクは除去する。
// 配布先を実ファイルへ移行するため、所有記録に無い旧リンクも対象とする。
// それ以外の生きた symlink はユーザーの構成として残し、後段が conflict として警告する。
function clearStaleSymlink(ctx, p, log, migratedLegacy = false) {
  if (blockedPath(ctx, p, false)) return;
  const st = lstatOrNull(p);
  if (!st?.isSymbolicLink()) return;
  // プロジェクトの共通正本へのリンクは、配布先の構成として保持する。
  if (!migratedLegacy && projectRulesLinkTarget(ctx, p)) return;
  const resolved = path.resolve(path.dirname(p), fs.readlinkSync(p));
  const inLegacy = resolved === ctx.legacyRoot || resolved.startsWith(ctx.legacyRoot + path.sep);
  if (inLegacy || !fs.existsSync(p)) {
    fs.unlinkSync(p);
    log.del(`stale symlink ${path.relative(ctx.base, p)}`);
  }
}

// 掃除の対象 = これから配達する場所と、そこへ至る経路すべて(規則ファイル・各配達単位・
// 配達先までの各段)。経路の途中に行き先の無いリンクが 1 つ挟まるだけで、その先は
// ディレクトリを作ることさえできない — 配達単位だけを見ていては届かない。
// 上の段から順に外す(浅い順)ので、先に外れた段の下は素直に作れる。
function staleSymlinkCandidates(ctx, entries) {
  const out = new Set(rulesTargets(ctx).filter((t) => t.agents.some((a) => !ctx.agents || ctx.agents.includes(a))).map((t) => t.file));
  for (const e of entries) {
    out.add(e.unit);
    let cur = ctx.base;
    for (const part of path.relative(ctx.base, path.dirname(e.dst)).split(path.sep)) {
      cur = path.join(cur, part);
      out.add(cur);
    }
  }
  return [...out].sort((a, b) => a.length - b.length);
}

// ---------------------------------------------------------------- ~/.zshenv(刈り込み専用)

// ~/.zshenv に残った管理行(マーカー付き = 常に自分の持ち物)を除去する。
function removeZshenvLine(ctx, log) {
  if (!ctx.zshenv || !fs.existsSync(ctx.zshenv)) return;
  const text = fs.readFileSync(ctx.zshenv, 'utf8');
  const kept = text.split('\n').filter((l) => !l.includes(MARKER));
  if (kept.join('\n') !== text) {
    writeFileAtomic(ctx.zshenv, kept.join('\n'));
    log.del(`legacy zshenv managed line`);
  }
}

function zshenvHasMarker(ctx) {
  if (!ctx.zshenv || !fs.existsSync(ctx.zshenv)) return false;
  return fs.readFileSync(ctx.zshenv, 'utf8').includes(MARKER);
}

// ---------------------------------------------------------------- settings.json 断片(刈り込み専用)

// 旧レイアウトが settings に書いた断片の照合パス。除去(所有照合)にだけ使う。
function fragmentDefs(ctx) {
  return {
    bashEnv: path.join(ctx.legacyRoot, 'hooks', 'shellenv.sh'),
    sessionStart: path.join(ctx.legacyRoot, 'hooks', 'beads-session.sh'),
  };
}

function removeSettings(ctx, fragments, log) {
  if (!fragments) return;
  const defs = fragmentDefs(ctx);
  const file = settingsPath(ctx);
  let s;
  try { s = readJson(file, null); } catch (e) {
    log.warn(`cannot read ${file}, leaving its legacy fragments: ${e.message}`);
    return;
  }
  if (!s) return;
  let changed = false;

  if (fragments.bashEnv && s.env?.BASH_ENV === defs.bashEnv) {
    delete s.env.BASH_ENV;
    if (Object.keys(s.env).length === 0) delete s.env;
    changed = true;
    log.del(`settings env.BASH_ENV`);
  }
  if (fragments.sessionStart && s.hooks?.SessionStart) {
    const before = s.hooks.SessionStart.length;
    s.hooks.SessionStart = s.hooks.SessionStart
      .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(defs.sessionStart)) }))
      .filter((m) => (m.hooks || []).length > 0);
    if (s.hooks.SessionStart.length !== before) { changed = true; log.del(`settings hooks.SessionStart`); }
    if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
    if (Object.keys(s.hooks).length === 0) delete s.hooks;
  }
  if ((fragments.ask || []).length && s.permissions?.ask) {
    const before = s.permissions.ask.length;
    s.permissions.ask = s.permissions.ask.filter((r) => !fragments.ask.includes(r));
    if (s.permissions.ask.length !== before) { changed = true; log.del(`settings permissions.ask`); }
    if (s.permissions.ask.length === 0) delete s.permissions.ask;
    if (Object.keys(s.permissions).length === 0) delete s.permissions;
  }

  if (changed) writeJson(file, s);
}

// Codex の hooks.json に旧レイアウトが書いた SessionStart 断片を、同じ所有権規則で除去する。
function codexHooksPath(ctx) { return path.join(ctx.codexDir, 'hooks.json'); }

function removeCodexHooks(ctx, fragments, log) {
  if (!fragments?.codexSessionStart) return;
  const sessionCmd = path.join(ctx.legacyRoot, 'hooks', 'beads-session.sh');
  let s;
  try { s = readJson(codexHooksPath(ctx), null); } catch (e) {
    log.warn(`cannot read ${codexHooksPath(ctx)}, leaving its legacy fragments: ${e.message}`);
    return;
  }
  if (!s?.hooks?.SessionStart) return;
  const before = JSON.stringify(s);
  s.hooks.SessionStart = s.hooks.SessionStart
    .map((m) => ({ ...m, hooks: (m.hooks || []).filter((h) => !(h.command || '').includes(sessionCmd)) }))
    .filter((m) => (m.hooks || []).length > 0);
  if (s.hooks.SessionStart.length === 0) delete s.hooks.SessionStart;
  if (Object.keys(s.hooks).length === 0) delete s.hooks;
  if (JSON.stringify(s) !== before) {
    writeJson(codexHooksPath(ctx), s);
    log.del('legacy codex hooks.SessionStart');
  }
}

// ---------------------------------------------------------------- 規則ブロック

// module の AGENTS.md は、各ツールの規則ファイルへマーカー付きの管理ブロックとして届ける。
// 規則ファイルはユーザー自身の記述と同居するので、コピーではなくブロックである。
// マーカー間は installer の管理領域: install / update が書き直し、uninstall が除去する。
// - Claude: <claudeDir>/CLAUDE.md — 無ければ作る
// - Codex(user): ~/.codex/AGENTS.md — .codex/ がある環境でだけ、無ければ作る
// - Codex(project): <project>/AGENTS.md — 既存のファイルにだけ足す(プロジェクトの
//   ルートに新しいファイルを作って見た目を変えない)
// - project の両規則ファイルから .agents/AGENTS.md へのリンクは、共通正本へ1度だけ届ける。
const BLOCK_BEGIN = '<!-- agents-harness:begin -->';
const BLOCK_END = '<!-- agents-harness:end -->';
// 目印は agents-harness:begin までで、行の残りは飾りである。
const hasBlock = (text) => /^[ \t]*<!-- agents-harness:begin/m.test(text);

// module ごとの本文を返す。1 本の文字列ではなく分けて持つのは、供給元を失った module の
// 遍在則を、記録から復元して残せるようにするためである — CLAUDE.md へ注がれる規則が
// 「置き場のディレクトリを消した」だけで黙って抜けるのは、最も避けたい失われ方である。
function rulesBodies(modules) {
  const bodies = {};
  for (const m of modules) {
    const src = path.join(moduleDir(m), 'AGENTS.md');
    if (lstatOrNull(src)) bodies[m] = fs.readFileSync(src, 'utf8').trim();
  }
  return bodies;
}

function joinBodies(bodies) {
  const keys = Object.keys(bodies).sort();
  return keys.length ? keys.map((k) => bodies[k]).join('\n\n') : null;
}

function desiredBlock(body) { return [BLOCK_BEGIN, body, BLOCK_END].join('\n'); }

// プロジェクト内の明示された共通正本だけを扱い、任意のリンク先へは配布しない。
function projectRulesLinkTarget(ctx, file) {
  if (ctx.kind !== 'project') return null;
  if (file !== path.join(ctx.base, 'AGENTS.md') && file !== path.join(ctx.claudeDir, 'CLAUDE.md')) return null;
  if (!lstatOrNull(file)?.isSymbolicLink()) return null;
  const canonical = path.join(ctx.base, '.agents', 'AGENTS.md');
  return path.resolve(path.dirname(file), fs.readlinkSync(file)) === canonical ? canonical : null;
}

function sharedRulesFile(ctx, file) {
  if (ctx.kind !== 'project') return null;
  const canonical = path.join(ctx.base, '.agents', 'AGENTS.md');
  if (file !== canonical && !projectRulesLinkTarget(ctx, file)) return null;
  // 正本や親ディレクトリが別のリンクなら、その先の所有権は引き受けない。
  if (!lstatOrNull(path.dirname(canonical))?.isDirectory() || !lstatOrNull(canonical)?.isFile()) return null;
  if (file === path.join(ctx.claudeDir, 'CLAUDE.md') && !lstatOrNull(ctx.claudeDir)?.isDirectory()) return null;
  return canonical;
}

function rulesTargets(ctx) {
  const targets = [];
  const agents = Object.keys(ctx.agentModules ?? Object.fromEntries(defaultAgents(ctx).map((a) => [a, []])));
  if (agents.includes('claude')) targets.push({ file: path.join(ctx.claudeDir, 'CLAUDE.md'), create: true, agents: ['claude'] });
  if (agents.includes('codex')) targets.push({ file: path.join(ctx.kind === 'user' ? ctx.codexDir : ctx.base, 'AGENTS.md'), create: true, agents: ['codex'] });
  const unique = new Map();
  for (const t of targets) {
    const shared = sharedRulesFile(ctx, t.file);
    const file = shared ?? t.file;
    const existing = unique.get(file);
    if (existing) existing.agents.push(...t.agents);
    else unique.set(file, { ...t, file, create: shared ? false : t.create });
  }
  return [...unique.values()];
}

function targetRulesBodies(ctx, target) {
  const bodies = {};
  // A user-selected common rules file serves both tools. Keep the other tool's
  // recorded rules when changing only one installation.
  const active = ctx.agents ?? ctx.inspectionAgents ?? AGENTS;
  const agents = [...target.agents].sort((a, b) => Number(active.includes(a)) - Number(active.includes(b)));
  for (const agent of agents) Object.assign(bodies, ctx.agentRulesBodies?.[agent] ?? {});
  return bodies;
}

function stripBlock(lines) {
  const kept = [];
  let inBlock = false;
  for (const l of lines) {
    if (l.trim().startsWith('<!-- agents-harness:begin')) { inBlock = true; continue; }
    if (inBlock) { if (l.trim() === BLOCK_END) inBlock = false; continue; }
    kept.push(l);
  }
  return kept;
}

// 戻り値は manifest への記録 { file(base 相対), createdFile } / null(対象外)。
// createdFile はファイルごと自分が作った事実 — uninstall がブロックを剥いで空になった
// ファイルを消してよいかの根拠になる。
function applyRulesBlock(ctx, t, body, oldRecord, log) {
  const st = lstatOrNull(t.file);
  if (!st && !t.create) return null;
  const rel = path.relative(ctx.base, t.file);
  if (blockedPath(ctx, t.file)) {
    // リンク越しに書くとリンク先(ユーザーの実体)を書き換えてしまう
    log.warn(`a symlink or non-file is in the way, leaving it alone: ${t.file}`);
    return null;
  }
  const desired = desiredBlock(body);
  const text = st ? fs.readFileSync(t.file, 'utf8') : '';
  if (text.includes(desired)) {
    log.ok(`rules block ${rel}`);
    return { file: rel, createdFile: oldRecord?.createdFile === true };
  }
  const kept = stripBlock(text.split('\n'));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  fs.mkdirSync(path.dirname(t.file), { recursive: true });
  writeFileAtomic(t.file, [...kept, ...(kept.length ? [''] : []), desired, ''].join('\n'));
  if (st) log.update(`rules block ${rel}`);
  else log.add(`rules block ${rel}`);
  return { file: rel, createdFile: st ? oldRecord?.createdFile === true : true };
}

function removeRulesBlock(ctx, record, log) {
  const recordedFile = path.join(ctx.base, record.file);
  const shared = sharedRulesFile(ctx, recordedFile);
  if (ctx.kind === 'project' && recordedFile === path.join(ctx.base, '.agents', 'AGENTS.md') && !shared) return;
  const file = shared ?? recordedFile;
  if (blockedPath(ctx, file)) return;
  if (!lstatOrNull(file)?.isFile()) return;
  const text = fs.readFileSync(file, 'utf8');
  if (!hasBlock(text)) return; // ブロックが無ければユーザーのファイルに触れない
  const kept = stripBlock(text.split('\n'));
  while (kept.length && kept[kept.length - 1] === '') kept.pop();
  if (record.createdFile === true && !shared && kept.join('\n').trim() === '') {
    fs.unlinkSync(file);
    log.del(`rules block ${record.file} (removed the file — it was ours)`);
    return;
  }
  writeFileAtomic(file, kept.length ? kept.join('\n') + '\n' : '');
  log.del(`rules block ${record.file}`);
}

// ---------------------------------------------------------------- 配備状態(読み取り専用)

// status と選択画面は同じ検査結果を使う。版番号は配備全体の記録なので、module の
// 更新待ちは「配布元・前回配布・現在の配備先」の内容で判定する。
function inspectDeployment(ctx) {
  const full = readJson(manifestPath(ctx), null);
  const hasLegacy = !!readJson(legacyManifestPath(ctx), null);
  const agentModules = recordedAgentModules(ctx, full);
  const agents = ctx.agents ?? Object.keys(agentModules);
  ctx.agentModules = agentModules;
  ctx.agentRulesBodies = recordedAgentBodies(full, agentModules);
  ctx.inspectionAgents = agents;
  const known = new Set(moduleNames());
  for (const agent of agents) {
    const names = agentModules[agent] ?? [];
    const bodies = rulesBodies(names.filter((n) => known.has(n)));
    for (const n of names.filter((n) => !known.has(n))) {
      if (ctx.agentRulesBodies[agent]?.[n] !== undefined) bodies[n] = ctx.agentRulesBodies[agent][n];
    }
    ctx.agentRulesBodies[agent] = bodies;
  }
  const names = [...new Set(agents.flatMap((a) => agentModules[a] ?? []))].sort();
  const installed = new Set(names);
  const checks = [];
  const add = (owners, kinds, message) => checks.push({ owners, kinds, message });
  const manifest = full ? { ...full,
    files: Object.fromEntries(Object.entries(full.files ?? {}).filter(([rel, v]) => agents.includes(recordAgent(rel, v)))),
    rulesBlocks: (full.rulesBlocks ?? []).filter((r) => rulesRecordAgents(ctx, r).some((a) => agents.includes(a))),
  } : null;
  if (!manifest) {
    if (hasLegacy) add([], ['update'], `legacy layout ${homePath(ctx.legacyRoot)} — run update to migrate`);
    return { manifest, hasLegacy, installed, checks, agentModules };
  }

  const orphans = names.filter((n) => !known.has(n));
  const orphanFiles = new Set();
  for (const n of orphans) {
    const owned = Object.keys(manifest.files ?? {}).filter((rel) => fileOwner(manifest.files[rel]) === n);
    owned.forEach((rel) => orphanFiles.add(rel));
    const kept = owned.filter((rel) => lstatOrNull(path.join(ctx.base, rel))).length;
    const lost = owned.length - kept;
    const what = [
      kept ? `${kept} file${kept > 1 ? 's' : ''} kept but unverifiable` : '',
      lost ? `${lost} missing with nothing to restore from` : '',
      !owned.length ? 'nothing delivered from it' : '',
    ].filter(Boolean).join(', ');
    add([n], ['gone'], `module ${n} — gone from ${homePath(PERSONAL_MODULES_DIR())}: ${what} (\`uninstall ${n}\` to remove)`);
  }

  const present = names.filter((n) => known.has(n));
  if (agents.includes('codex')) for (const n of unsupportedCodexHooks((agentModules.codex ?? []).filter((n) => known.has(n)))) {
    add([n], ['blocked'], `${n} — Claude hooks need native codex/hooks.json for Codex`);
  }
  const entries = deliveryEntries(ctx, present, { keepPlugin: orphanFiles.size > 0, agents });
  for (const e of entries) {
    const owners = e.module ? [e.module] : [];
    const st = lstatOrNull(e.dst);
    const was = fileHash(manifest.files?.[e.rel]);
    if (blockedPath(ctx, e.dst)) {
      add(owners, ['blocked'], `${e.rel} — a symlink is in the way`);
    } else if (!st) {
      add(owners, [was ? 'missing' : 'update'], `${e.rel} — ${was ? 'missing' : 'new delivery, run update'}`);
    } else if (!st.isFile()) {
      add(owners, ['blocked'], `${e.rel} — not a regular file`);
    } else {
      const current = sha256(e.dst);
      const source = entryHash(e);
      const kinds = [];
      // 既に正本と同じなら、前回の記録が古くても内容のドリフトは無い。
      if (current !== source) {
        if (was && source !== was) kinds.push('update');
        if (!was || current !== was) kinds.push('modified');
      }
      const reasons = [];
      if (kinds.includes('update')) reasons.push('source changed, run update');
      if (kinds.includes('modified')) reasons.push('modified in place');
      add(owners, kinds, e.rel + (reasons.length ? ` — ${reasons.join('; ')}` : ''));
    }
  }
  const delivered = new Set(entries.map((e) => e.rel));
  for (const [rel, record] of Object.entries(manifest.files ?? {})) {
    if (delivered.has(rel) || orphanFiles.has(rel)) continue;
    const owner = fileOwner(record);
    const owners = owner ? followRenames([owner]).filter((n) => installed.has(n)) : [];
    const st = lstatOrNull(path.join(ctx.base, rel));
    const kinds = ['update'];
    let reason = 'no longer delivered, run update to prune';
    if (st && (blockedPath(ctx, path.join(ctx.base, rel)) || sha256(path.join(ctx.base, rel)) !== fileHash(record))) {
      kinds.push('modified');
      reason += '; modified in place';
    }
    add(owners, kinds, `${rel} — ${reason}`);
  }

  inspectRules(ctx, manifest, present, orphans, add);
  if (hasLegacy) add([], ['update'], `legacy layout ${homePath(ctx.legacyRoot)} — run update to migrate`);
  if (ctx.kind === 'user' && zshenvHasMarker(ctx)) add([], ['update'], 'legacy zshenv managed line — run update to prune');
  return { manifest, hasLegacy, installed, checks, agentModules };
}

function inspectRules(ctx, manifest, present, orphans, add) {
  const targets = new Map(rulesTargets(ctx).filter((t) => t.agents.some((a) => ctx.inspectionAgents.includes(a))).map((t) => [t.file, t]));
  const records = new Map();
  for (const r of manifest.rulesBlocks ?? []) {
    const recorded = path.join(ctx.base, r.file);
    const file = sharedRulesFile(ctx, recorded) ?? recorded;
    records.set(file, r);
    if (!targets.has(file)) targets.set(file, { file, create: false, agents: rulesRecordAgents(ctx, r) });
  }
  for (const t of targets.values()) {
    const bodies = targetRulesBodies(ctx, t);
    const previous = records.get(t.file)?.bodies ?? (records.has(t.file) ? manifest.rulesBodies : {});
    const body = joinBodies(bodies);
    const oldBody = previous ? joinBodies(previous) : null;
    const owners = followRenames([...new Set([...Object.keys(bodies), ...Object.keys(previous ?? {})])]);
    if (body === null && oldBody === null && !records.has(t.file)) continue;
    const changed = previous ? owners.filter((n) => bodies[n] !== previous[n]) : [];
    const rel = `rules block ${path.relative(ctx.base, t.file)}`;
    const st = lstatOrNull(t.file);
    if (!st && body === null) continue;
    if (!st) {
      add(owners, [records.has(t.file) ? 'missing' : 'update'], `${rel} — ${records.has(t.file) ? 'missing' : 'new delivery, run update'}`);
      continue;
    }
    if (blockedPath(ctx, t.file)) { add(owners, ['blocked'], `${rel} — a symlink or non-file is in the way`); continue; }
    const text = fs.readFileSync(t.file, 'utf8');
    const matches = (b) => b === null ? !hasBlock(text) : text.includes(desiredBlock(b));
    if (matches(body)) { add(owners, [], rel); continue; }
    if (previous && changed.length) add(changed, ['update'], `${rel} — source changed, run update`);
    if (!previous || !matches(oldBody)) {
      add(owners, ['shared'], `${rel} — shared rules differ${previous ? ' (modified in place)' : ' (no previous content recorded)'}; inspect with status`);
    }
  }
}

const DEPLOYMENT_STATES = {
  available: { symbol: '○', label: 'available', color: 'gray' },
  installed: { symbol: '●', label: 'installed', color: 'green' },
  update: { symbol: '↑', label: 'update available', color: 'yellow' },
  modified: { symbol: '~', label: 'modified locally', color: 'blue' },
  shared: { symbol: '~', label: 'shared rules changed', color: 'blue' },
  missing: { symbol: '!', label: 'missing files', color: 'red' },
  blocked: { symbol: '!', label: 'blocked', color: 'red' },
  gone: { symbol: '!', label: 'source missing', color: 'red' },
};

function deploymentState(inspection, name) {
  const checks = inspection.checks.filter((c) => c.kinds.length && (name === null ? !c.owners.length : c.owners.includes(name)));
  const kinds = new Set(checks.flatMap((c) => c.kinds));
  const priority = ['gone', 'blocked', 'missing', 'modified', 'shared', 'update'];
  const states = priority.filter((kind) => kinds.has(kind));
  const primary = states[0] ?? (inspection.installed.has(name) ? 'installed' : 'available');
  return {
    ...DEPLOYMENT_STATES[primary],
    label: states.length ? states.map((kind) => DEPLOYMENT_STATES[kind].label).join(' + ') : DEPLOYMENT_STATES[primary].label,
    details: checks.map((c) => c.message),
  };
}

// ---------------------------------------------------------------- log

function makeLog() {
  const counts = { add: 0, update: 0, ok: 0, del: 0, warn: 0 };
  const line = (sym, key, paint) => (msg) => { counts[key]++; console.log(`  ${paint(sym)} ${msg}`); };
  return {
    add: line('+', 'add', ui.green),
    update: line('~', 'update', ui.yellow),
    ok: (msg) => { counts.ok++; },
    del: line('-', 'del', ui.gray),
    warn: line('!', 'warn', ui.yellow),
    counts,
  };
}

// 完了行。0 の項目は出さない(何が起きたかだけを残す)。
function summary(counts) {
  const parts = [];
  if (counts.add) parts.push(ui.green(`${counts.add} added`));
  if (counts.update) parts.push(ui.yellow(`${counts.update} updated`));
  if (counts.del) parts.push(ui.gray(`${counts.del} removed`));
  if (counts.ok) parts.push(ui.dim(`${counts.ok} unchanged`));
  if (counts.warn) parts.push(ui.yellow(`${counts.warn} warning${counts.warn > 1 ? 's' : ''}`));
  return parts.length ? parts.join(ui.dim(' · ')) : ui.dim('nothing to do');
}

// ---------------------------------------------------------------- 表示(色・幅)

// 色は端末が受け取れるときだけ。NO_COLOR(no-color.org)と dumb 端末を尊重する。
const COLOR = Boolean(process.stdout.isTTY) && !process.env.NO_COLOR && process.env.TERM !== 'dumb';
const sgr = (on, off) => (s) => (COLOR ? `\x1b[${on}m${s}\x1b[${off}m` : String(s));
const ui = {
  bold: sgr(1, 22),
  dim: sgr(2, 22),
  red: sgr(31, 39),
  green: sgr(32, 39),
  yellow: sgr(33, 39),
  blue: sgr(34, 39),
  cyan: sgr(36, 39),
  gray: sgr(90, 39),
};

const ANSI_RE = /\x1b\[[0-9;]*m/g;

// 東アジアの全角は 2 桁を占める。行が端末幅で折り返すと再描画の行数計算が壊れるため、
// セレクターは必ずこの幅で測ってから切り詰める。
function isWide(cp) {
  return (cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0x303e) ||
    (cp >= 0x3041 && cp <= 0x33ff) || (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0xa000 && cp <= 0xa4cf) ||
    (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) || (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x20000 && cp <= 0x3fffd);
}

function textWidth(s) {
  let w = 0;
  for (const ch of String(s).replace(ANSI_RE, '')) w += isWide(ch.codePointAt(0)) ? 2 : 1;
  return w;
}

function pad(s, width) {
  return s + ' '.repeat(Math.max(0, width - textWidth(s)));
}

// パスは末尾(どのプロジェクトか)が情報なので、あふれたら頭を落とす。
function truncHead(s, max) {
  if (textWidth(s) <= max) return s;
  const chars = [...s];
  let out = '';
  let w = 0;
  for (let i = chars.length - 1; i >= 0; i--) {
    const cw = isWide(chars[i].codePointAt(0)) ? 2 : 1;
    if (w + cw > max - 1) break;
    out = chars[i] + out;
    w += cw;
  }
  return '…' + out;
}

// 説明は冒頭、パスは末尾を残す。色を付ける前に切り詰めて ANSI を途中で切らない。
function truncText(s, max) {
  const text = String(s).replace(ANSI_RE, '').replace(/[\x00-\x1f\x7f]/g, ' ');
  if (max <= 0) return '';
  if (textWidth(text) <= max) return text;
  let out = '';
  let width = 0;
  for (const ch of text) {
    const cw = isWide(ch.codePointAt(0)) ? 2 : 1;
    if (width + cw > max - 1) break;
    out += ch;
    width += cw;
  }
  return out + '…';
}

function homePath(p) {
  const home = os.homedir();
  return p === home || p.startsWith(home + path.sep) ? '~' + p.slice(home.length) : p;
}

function termWidth() {
  return process.stdout.columns && process.stdout.columns > 20 ? process.stdout.columns : 80;
}

// ---------------------------------------------------------------- 対話(セレクター)

function isInteractive() {
  return Boolean(process.stdin.isTTY && process.stdout.isTTY);
}

const CANCELLED = Symbol('cancelled');

// 矢印キーで選ぶ。何を打てばよいかを覚えさせず、選べる物を常に画面へ出す。
// options: [{ label, detail, hint }]
function select({ title, options }) {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    const width = termWidth();
    const labelWidth = Math.max(...options.map((o) => textWidth(o.label)));
    let index = 0;
    let drawn = 0;

    const paint = () => {
      const lines = [];
      lines.push('');
      lines.push(`  ${ui.bold(title)}`);
      lines.push('');
      options.forEach((o, i) => {
        const on = i === index;
        const label = on ? ui.cyan(ui.bold(pad(o.label, labelWidth))) : pad(o.label, labelWidth);
        const room = width - labelWidth - 8;
        const detail = o.detail ? (on ? ui.gray(truncHead(o.detail, room)) : ui.dim(truncHead(o.detail, room))) : '';
        lines.push(`  ${on ? ui.cyan('❯') : ' '} ${label}   ${detail}`.trimEnd());
        if (o.hint) lines.push(`      ${ui.dim(truncHead(o.hint, width - 8))}`);
      });
      lines.push('');
      lines.push(`  ${ui.dim('↑/↓ move · enter select · ctrl-c cancel')}`);

      let out = drawn ? `\x1b[${drawn}A` : '';
      out += lines.map((l) => `\x1b[2K${l}`).join('\n') + '\n';
      process.stdout.write(out);
      drawn = lines.length;
    };

    const finish = (value) => {
      stdin.removeListener('keypress', onKey);
      if (stdin.isTTY) stdin.setRawMode(false);
      stdin.pause();
      // 選択肢を畳んで、決めた結果だけを 1 行残す。
      const chosen = value === CANCELLED ? ui.red('cancelled') : ui.cyan(options[value].label);
      process.stdout.write(`\x1b[${drawn}A\x1b[0J  ${ui.green('✔')} ${ui.bold(title)}  ${chosen}\n`);
      process.stdout.write('\x1b[?25h');
      resolve(value);
    };

    const onKey = (str, key = {}) => {
      if (key.name === 'up' || key.name === 'k') { index = (index - 1 + options.length) % options.length; paint(); }
      else if (key.name === 'down' || key.name === 'j') { index = (index + 1) % options.length; paint(); }
      else if (key.name === 'return' || key.name === 'enter') finish(index);
      else if (key.name === 'escape' || key.name === 'q' || (key.ctrl && (key.name === 'c' || key.name === 'd'))) finish(CANCELLED);
    };

    readline.emitKeypressEvents(stdin);
    if (stdin.isTTY) stdin.setRawMode(true);
    stdin.resume();
    stdin.on('keypress', onKey);
    process.stdout.write('\x1b[?25l');
    paint();
  });
}

function closePrompt() {
  if (process.stdout.isTTY) process.stdout.write('\x1b[?25h');
}

// 複数選択。何を入れるかは既定値で決まらないので、初期選択は空である。
function multiSelect({ title, context, options, notices = [] }) {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    const chosen = new Set();
    let index = 0;
    let drawn = 0;

    const paint = () => {
      // 右端の自動折返しを避ける。高さにも収め、長い一覧はカーソルに追従させる。
      const width = termWidth() - 1;
      const room = width - 2;
      const narrow = width < 58;
      const labelWidth = Math.min(Math.max(...options.map((o) => textWidth(o.label))), width - 12);
      const selected = options[index];
      const details = [
        `  ${truncText(selected.detail, room)}`,
        `  ${ui.dim(truncText(selected.hint, room))}`,
      ];
      if (selected.state.details.length) {
        details.push(`  ${ui[selected.state.color](truncText(selected.state.label, room))}`);
        details.push(`  ${truncHead(selected.state.details[0], room)}`);
      }
      if (notices.length) details.push(`  ${ui.yellow(truncText(`shared: ${notices.join('; ')} — see status`, room))}`);
      const footer = (narrow ? [
        `${chosen.size} selected · [x] this run`,
        '↑/↓ move · space toggle',
        'enter confirm · ctrl-c cancel',
      ] : [
        `${chosen.size} selected · checks: this run · icons: current state`,
        '↑/↓ move · space toggle · enter confirm',
        'ctrl-c cancel',
      ]).map((text) => `  ${ui.dim(truncText(text, room))}`);
      const scope = `${context.scope} → `;
      const header = ['', `  ${ui.bold(truncText(title, room))}`, `  ${ui.dim(scope + truncHead(context.path, room - textWidth(scope)))}`, ''];
      const rows = process.stdout.rows || 24;
      const count = Math.max(1, Math.min(options.length, Math.floor((rows - header.length - details.length - footer.length - 4) / (narrow ? 2 : 1))));
      const start = Math.min(Math.max(0, index - Math.floor(count / 2)), options.length - count);
      const lines = [...header];
      options.slice(start, start + count).forEach((o, offset) => {
        const i = start + offset;
        const on = i === index;
        const check = chosen.has(i) ? ui.cyan('[x]') : ui.dim('[ ]');
        const mark = ui[o.state.color](o.state.symbol);
        const name = pad(truncText(o.label, labelWidth), labelWidth);
        const label = on ? ui.cyan(ui.bold(name)) : name;
        const prefix = `  ${on ? ui.cyan('❯') : ' '} ${check} ${mark} `;
        lines.push(`${prefix}${label}${narrow ? '' : `  ${truncText(o.state.label, width - labelWidth - 12)}`}`.trimEnd());
        if (narrow) lines.push(`          ${truncText(o.state.label, width - 10)}`);
      });
      if (count < options.length) lines.push(`  ${ui.dim(`${start + 1}–${start + count} of ${options.length}`)}`);
      lines.push('', ...details, '', ...footer);

      let out = drawn ? `\x1b[${drawn}A` : '';
      out += '\x1b[0J' + lines.map((l) => `\x1b[2K${l}`).join('\n') + '\n';
      process.stdout.write(out);
      drawn = lines.length;
    };

    const finish = (value) => {
      stdin.removeListener('keypress', onKey);
      process.stdout.removeListener('resize', paint);
      if (stdin.isTTY) stdin.setRawMode(false);
      stdin.pause();
      const picked = value === CANCELLED
        ? ui.red('cancelled')
        : value.length ? ui.cyan(value.map((i) => options[i].label).join(' ')) : ui.dim('nothing');
      process.stdout.write(`\x1b[${drawn}A\x1b[0J  ${ui.green('✔')} ${ui.bold(title)}  ${picked}\n`);
      process.stdout.write('\x1b[?25h');
      resolve(value);
    };

    const onKey = (str, key = {}) => {
      if (key.name === 'up' || key.name === 'k') { index = (index - 1 + options.length) % options.length; paint(); }
      else if (key.name === 'down' || key.name === 'j') { index = (index + 1) % options.length; paint(); }
      else if (key.name === 'space') { chosen.has(index) ? chosen.delete(index) : chosen.add(index); paint(); }
      else if (key.name === 'return' || key.name === 'enter') finish([...chosen].sort((a, b) => a - b));
      else if (key.name === 'escape' || (key.ctrl && (key.name === 'c' || key.name === 'd'))) finish(CANCELLED);
    };

    readline.emitKeypressEvents(stdin);
    if (stdin.isTTY) stdin.setRawMode(true);
    stdin.resume();
    stdin.on('keypress', onKey);
    process.stdout.on('resize', paint);
    process.stdout.write('\x1b[?25l');
    paint();
  });
}

function pickerContext(ctx) {
  return { scope: ctx.kind === 'user' ? 'global' : 'project', path: homePath(ctx.base) };
}

// 選択画面の 1 行。出どころは選ぶ前に要る。見本のままか、手が入っているかで意味が違う。
function moduleOption(name, inspection, states) {
  const agents = Object.entries(inspection.agentModules).filter(([, names]) => names.includes(name)).map(([a]) => a);
  const state = deploymentState(inspection, name);
  // 供給元を失った module は外す候補としてだけ並ぶ。読める説明はもう無い。
  if (!moduleIndex().has(name)) return { label: name, detail: '', hint: agents.join(' · '), state };
  const meta = moduleMeta(name);
  const missing = missingRequirements(name);
  const origin = { sample: `from ${VENDOR}`, edited: `from ${VENDOR}, edited by you` }[states.get(name)] ?? 'yours';
  const req = !meta.requires.length ? ''
    : missing.length
      ? `requires ${meta.requires.join(' ')} — missing: ${missing.join(' ')}`
      : `requires ${meta.requires.join(' ')} — found`;
  return { label: name, detail: meta.description, hint: [origin, req, ...agents].filter(Boolean).join(' · '), state };
}

// 何を入れるかは既定値では決まらない。明示されていれば対話しない、無ければ選ばせる、
// 選べない環境(非 TTY)なら止める。
async function resolveModules(cmd, opts) {
  if (opts.modules.length) { assertKnownModules(opts.modules); return opts; }
  const available = moduleNames();
  if (!available.length) throw new Error(`no modules in ${homePath(PERSONAL_MODULES_DIR())} — run \`npm i -g @hiroiku/dotagents\` to have the sample set placed there.`);
  if (!isInteractive()) {
    throw new Error(
      `no module given for \`${cmd}\`. Name at least one:\n` +
      available.map((n) => `         agents-setup ${cmd} ${n}`).join('\n') + '\n' +
      `       (run it in a terminal to choose interactively)`);
  }
  const states = seedStates();
  const ctx = makeCtx(opts);
  const inspection = inspectDeployment(ctx);
  const shared = deploymentState(inspection, null);
  const orphans = [...inspection.installed].filter((n) => !available.includes(n));
  const picked = await multiSelect({
    title: 'Which modules?',
    context: pickerContext(ctx),
    notices: [...(shared.details.length ? [shared.label] : []), ...orphans.map((n) => `${n}: source missing (uninstall ${n} to remove)`)],
    options: available.map((n) => moduleOption(n, inspection, states)),
  });
  if (picked === CANCELLED) throw new Error('cancelled.');
  if (!picked.length) throw new Error('no module chosen — nothing was written.');
  opts.modules = picked.map((i) => available[i]);
  opts.interactive = true;
  return opts;
}

// 導入先の選択。行ごとに、選んだ module のうちいくつがそこに入っているかを示す。
async function pickAgents(ctx, modules, { title, agents = AGENTS, removing = false }) {
  const picked = await multiSelect({
    title,
    context: pickerContext(ctx),
    options: agents.map((agent) => {
      const inspection = inspectDeployment({ ...ctx, agents: [agent] });
      const states = modules.map((n) => deploymentState(inspection, n));
      const installed = modules.filter((n) => inspection.installed.has(n)).length;
      const state = states.find((s) => s.details.length) ?? states.find((s) => s.symbol === '●') ?? DEPLOYMENT_STATES.available;
      return {
        label: AGENT_LABELS[agent],
        detail: agent === 'claude' ? 'Skills, agents, hooks and CLAUDE.md rules' : 'Native skills, custom agents and AGENTS.md rules',
        hint: `${modules.join(', ')} ${removing ? 'from' : '→'} ${agent === 'claude' ? '.claude/' : '.agents/skills/ and .codex/'}`,
        state: { ...state, label: `${installed}/${modules.length} installed${state.details?.length ? ` · ${state.label}` : ''}`, details: state.details ?? [] },
      };
    }),
  });
  if (picked === CANCELLED) throw new Error('cancelled.');
  if (!picked.length) throw new Error(`no agent chosen — nothing was ${removing ? 'removed' : 'written'}.`);
  return picked.map((i) => agents[i]);
}

async function resolveAgents(opts) {
  if (opts.agents || !isInteractive()) return opts;
  const agents = await pickAgents(makeCtx(opts), opts.modules, { title: 'Install into which agents?' });
  return { ...opts, agents, interactive: true };
}

// 外す物も既定値では決めない。名前が無く端末で選べるなら、ここに配っている物から選ばせる。
// 選べない環境で名前を挙げない uninstall は、これまでどおりすべてを外す。
async function resolveRemovals(opts) {
  if (opts.modules.length || !isInteractive()) return opts;
  const ctx = makeCtx(opts);
  const inspection = inspectDeployment(ctx);
  // 記録が無い、または対象の導入先に何も無いときの案内は uninstall が出す。
  if (!inspection.manifest || !inspection.installed.size) return opts;
  const installed = [...inspection.installed].sort();
  const states = seedStates();
  const picked = await multiSelect({
    title: 'Which modules to remove?',
    context: pickerContext(ctx),
    options: installed.map((n) => moduleOption(n, inspection, states)),
  });
  if (picked === CANCELLED) throw new Error('cancelled.');
  if (!picked.length) throw new Error('no module chosen — nothing was removed.');
  const modules = picked.map((i) => installed[i]);
  // 選んだ module が 1 つの導入先にしか入っていなければ、選ばせる物が無い。
  const candidates = AGENTS.filter((a) => modules.some((n) => inspection.agentModules[a]?.includes(n)));
  if (opts.agents || candidates.length < 2) return { ...opts, modules, interactive: true };
  const agents = await pickAgents(makeCtx(opts), modules, { title: 'Remove from which agents?', agents: candidates, removing: true });
  // 選んだ導入先に入っていない module は、そこから外す物が無いだけである。
  return { ...opts, agents, modules: modules.filter((n) => agents.some((a) => inspection.agentModules[a].includes(n))), interactive: true };
}

// 配備先の既定はカレントディレクトリである。-C も -g も無いまま無関係な場所で走った
// ときに黙って書かないよう、git リポジトリでなければ一手を要求する。
async function confirmLooseTarget(opts) {
  if (opts.global || opts.dirExplicit) return;
  const cwd = process.cwd();
  if (lstatOrNull(path.join(cwd, '.git'))) return;
  if (!isInteractive()) {
    throw new Error(`${homePath(cwd)} is not a git repository, and no target was named.\n` +
      `       Name it explicitly with \`-C .\`, or use \`-g\` for the user level.`);
  }
  const choice = await select({
    title: `Deploy into ${homePath(cwd)}?`,
    options: [
      { label: 'Cancel', hint: 'Nothing is written' },
      { label: 'Yes, here', detail: homePath(cwd), hint: 'This directory is not a git repository' },
    ],
  });
  if (choice !== 1) throw new Error('cancelled.');
  opts.interactive = true;
}

// ---------------------------------------------------------------- 旧レイアウトの移行

// 旧レイアウト(<base>/.agents + symlink + zshenv 行 + settings / codex 断片 + 参照ブロック)を
// 旧 manifest の所有記録に基づいて刈り込む。install / update / uninstall の入口で走る。
// ユーザーの改変(hash 不一致)と自前スキルは残して警告する。
function migrateLegacy(ctx, log) {
  const m = readJson(legacyManifestPath(ctx), null);
  if (!m) return false;
  for (const l of m.links || []) removeLink(l, log);
  removeZshenvLine(ctx, log);
  removeSettings(ctx, m.fragments, log);
  removeCodexHooks(ctx, m.fragments, log);
  if (m.fragments?.refBlock) {
    // 旧・参照ブロック(マーカーは現行の規則ブロックと同一)。剥ぐだけでよい:
    // 対象が rulesTargets に含まれるなら、新しい規則ブロックが同じ場所に入り直す。
    const file = path.join(ctx.base, 'AGENTS.md');
    if (lstatOrNull(file)?.isFile()) {
      const text = fs.readFileSync(file, 'utf8');
      if (hasBlock(text)) {
        const kept = stripBlock(text.split('\n'));
        while (kept.length && kept[kept.length - 1] === '') kept.pop();
        writeFileAtomic(file, kept.length ? kept.join('\n') + '\n' : '');
        log.del('legacy AGENTS.md reference block');
      }
    }
  }
  for (const [rel, hash] of Object.entries(m.files || {})) {
    const dst = path.join(ctx.legacyRoot, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), ctx.legacyRoot);
      log.del(`legacy ${path.join('.agents', rel)}`);
    } else {
      log.warn(`legacy file modified in place, keeping it: ${dst}`);
    }
  }
  fs.unlinkSync(legacyManifestPath(ctx));
  try { fs.rmdirSync(ctx.legacyRoot); } catch { /* 自前スキル等が残っていれば残す */ }
  return true;
}

// ---------------------------------------------------------------- commands

async function install(opts, { requireExisting = false, replaceModules = false } = {}) {
  const ctx = makeCtx(opts);
  const log = makeLog();
  const old = readJson(manifestPath(ctx), null);
  const legacy = readJson(legacyManifestPath(ctx), null);
  if (requireExisting && !old && !legacy) {
    throw new Error(`nothing installed for ${homePath(ctx.base)} — run \`agents-setup install <module>\` first.`);
  }

  assertKnownModules(opts.modules);
  const previousTargets = recordedAgentModules(ctx, old);
  const active = opts.agents ?? (Object.keys(previousTargets).length ? Object.keys(previousTargets) : defaultAgents(ctx));
  if (legacy && !old && opts.agents && !AGENTS.every((a) => active.includes(a))) {
    throw new Error('legacy installation has no per-agent record; run update without --agent once to migrate it.');
  }
  if (requireExisting && old && !active.some((a) => previousTargets[a]?.length)) {
    throw new Error(`nothing installed for ${active.join(', ')} here — run install first.`);
  }
  const known = new Set(moduleNames());
  const heirs = renameMap();
  const agentModules = { ...previousTargets };
  const agentRulesBodies = recordedAgentBodies(old, previousTargets);
  const rawRecorded = old?.agentModules ? active.flatMap((a) => old.agentModules[a] ?? []) : old?.modules ?? (legacy ? [SOLE_MODULE_THEN] : []);
  for (const n of new Set(rawRecorded.filter((n) => heirs.has(n)))) {
    log.update(`module ${n} → ${heirs.get(n).join(' ')} (it was ${heirs.get(n).length > 1 ? 'split' : 'renamed'})`);
  }
  // 触れるのは名前を挙げた module だけである。記録に残る他の module は、正本が変わっていても
  // 前回配った内容のまま持ち越し、配り直しは update に任せる。持ち越すには導入先ごとの記録が
  // 要るので、それを持たない古い記録と、改名で受け継いだ名前は配り直す。
  const redeliverAll = !old?.agentModules || (!replaceModules && !opts.modules.length);
  const held = {};
  for (const agent of active) {
    const recorded = previousTargets[agent] ?? (legacy && !old ? [SOLE_MODULE_THEN] : []);
    const remembered = followRenames(recorded, heirs);
    const wanted = replaceModules ? remembered.filter((n) => !opts.removeModules.includes(n))
      : [...new Set([...remembered, ...opts.modules])].sort();
    if (!wanted.length) { delete agentModules[agent]; delete agentRulesBodies[agent]; continue; }
    agentModules[agent] = wanted;
    const raw = old?.agentModules?.[agent] ?? [];
    held[agent] = new Set(redeliverAll ? [] : wanted.filter((n) => raw.includes(n) && !opts.modules.includes(n)));
    const fresh = (n) => known.has(n) && !held[agent].has(n);
    const bodies = rulesBodies(wanted.filter(fresh));
    for (const n of wanted.filter((n) => !fresh(n))) {
      if (agentRulesBodies[agent]?.[n] !== undefined) bodies[n] = agentRulesBodies[agent][n];
    }
    agentRulesBodies[agent] = bodies;
  }
  const isHeld = (agent, name) => held[agent]?.has(name) ?? false;
  ctx.agentModules = agentModules;
  ctx.agentRulesBodies = agentRulesBodies;
  const wanted = [...new Set(Object.values(agentModules).flat())].sort();
  const modules = wanted.filter((n) => known.has(n));
  const touched = modules.filter((n) => active.some((a) => agentModules[a]?.includes(n) && !isHeld(a, n)));
  const orphans = wanted.filter((n) => !known.has(n) && active.some((a) => agentModules[a]?.includes(n)));
  const orphanHasFiles = orphans.some((n) => Object.values(old?.files || {}).some((v) => fileOwner(v) === n));
  // 衝突の検出と plugin の中身は持ち越す module も含めた全体で決め、書くのは触れる物だけにする。
  const entries = deliveryEntries(ctx, modules, { keepPlugin: orphanHasFiles, agents: active })
    .filter((e) => !e.module || !isHeld(e.agent, e.module));
  if (active.includes('codex')) for (const n of unsupportedCodexHooks((agentModules.codex ?? []).filter((n) => known.has(n) && !isHeld('codex', n)))) {
    log.warn(`${n}: Claude hooks need native codex/hooks.json for Codex`);
  }

  // 0. 旧レイアウト(.agents + symlink + 断片)の刈り込みと、配達先を塞ぐ旧 symlink の掃除
  const migratedLegacy = (!opts.agents || opts.migrateAllLegacy || AGENTS.every((a) => active.includes(a))) ? migrateLegacy(ctx, log) : false;
  for (const p of staleSymlinkCandidates(ctx, entries)) clearStaleSymlink(ctx, p, log, migratedLegacy);

  // 1. module → 各ツールの置き場(所有ハッシュに基づく外科的コピー)
  const files = Object.fromEntries(Object.entries(old?.files ?? {}).filter(([rel, v]) => !active.includes(recordAgent(rel, v))));
  const blockedUnits = new Set();
  for (const e of entries) {
    const { dst, rel } = e;
    const unit = blockedPath(ctx, dst);
    // 掃除を生き延びた symlink はユーザーの構成。リンク越しに書き込まず、警告して退く
    if (unit) {
      if (!blockedUnits.has(unit)) {
        blockedUnits.add(unit);
        log.warn(`a symlink is in the way, leaving it alone: ${unit}`);
      }
      if (old?.files?.[rel]) files[rel] = old.files[rel];
      continue;
    }
    const srcHash = entryHash(e);
    const st = lstatOrNull(dst);
    const was = fileHash(old?.files?.[rel]);
    const mine = (hash) => ({ hash, module: e.module ?? null, agent: e.agent });
    if (!st) {
      writeEntry(e);
      files[rel] = mine(srcHash);
      log.add(rel);
    } else if (sha256(dst) === srcHash) {
      files[rel] = mine(srcHash);
      log.ok(rel);
    } else if (was && sha256(dst) === was) {
      writeEntry(e);
      files[rel] = mine(srcHash);
      log.update(rel);
    } else if (opts.force) {
      writeEntry(e);
      files[rel] = mine(srcHash);
      log.update(`${rel}(--force で上書き)`);
    } else {
      log.warn(`modified in place, leaving it (use --force to overwrite): ${dst}`);
      if (was) files[rel] = mine(was); // 所有記録は保持し、状態は status が報告する
    }
  }

  // 2. 配達されなくなったファイルの刈り込み(自分が置いた内容のままのものだけ)。
  //    module を外したとき・正本から消えたとき・旧配置から移ったときの、どれにも同じ規則が効く。
  const relSet = new Set(entries.map((e) => e.rel));
  const orphanSet = new Set(orphans);
  for (const [rel, v] of Object.entries(old?.files || {})) {
    if (files[rel] !== undefined || relSet.has(rel)) continue;
    // 供給元を失った module と、今回触れない module が置いた物は、所有の記録ごと持ち越す
    const agent = recordAgent(rel, v);
    const owner = fileOwner(v);
    if ((orphanSet.has(owner) || isHeld(agent, owner)) && agentModules[agent]?.includes(owner)) { files[rel] = v; continue; }
    const hash = fileHash(v);
    const dst = path.join(ctx.base, rel);
    const st = lstatOrNull(dst);
    if (!st) continue;
    if (!blockedPath(ctx, dst) && sha256(dst) === hash) {
      fs.unlinkSync(dst);
      removeEmptyDirsUpTo(path.dirname(dst), pruneStop(ctx, dst));
      log.del(`${rel} (no longer delivered)`);
    } else {
      log.warn(`no longer delivered but modified in place, keeping it: ${dst}`);
      if (fileOwner(v) && followRenames([fileOwner(v)]).some((n) => agentModules[agent]?.includes(n))) files[rel] = v;
    }
  }

  const oldBlocks = new Map();
  for (const r of old?.rulesBlocks ?? []) {
    const file = path.join(ctx.base, r.file);
    const rel = path.relative(ctx.base, sharedRulesFile(ctx, file) ?? file);
    const previous = oldBlocks.get(rel);
    oldBlocks.set(rel, { ...r, agents: [...new Set([...(previous?.agents ?? []), ...rulesRecordAgents(ctx, r)])] });
  }
  const rulesRecords = [];
  for (const t of rulesTargets(ctx)) {
    const rel = path.relative(ctx.base, t.file);
    const before = oldBlocks.get(rel);
    const affected = [...t.agents, ...(before?.agents ?? [])].some((a) => active.includes(a));
    if (!affected) { if (before) rulesRecords.push({ ...before, file: rel }); continue; }
    const bodies = targetRulesBodies(ctx, t);
    const body = joinBodies(bodies);
    if (body === null) continue;
    const rec = applyRulesBlock(ctx, t, body, before, log);
    if (rec) {
      rulesRecords.push({ ...rec, agents: t.agents, bodies });
      // 共通ファイルは両者が同じ内容を読む。その実際の内容を両方の記録に反映する。
      for (const agent of t.agents) for (const name of Object.keys(agentRulesBodies[agent] ?? {})) {
        if (bodies[name] !== undefined) agentRulesBodies[agent][name] = bodies[name];
      }
    } else if (before) rulesRecords.push({ ...before, file: rel });
  }
  const currentBlockFiles = new Set(rulesRecords.map((r) => r.file));
  for (const [rel, r] of oldBlocks) {
    if (currentBlockFiles.has(rel)) continue;
    if (!r.agents.some((a) => active.includes(a))) rulesRecords.push({ ...r, file: rel });
    else removeRulesBlock(ctx, { ...r, file: rel }, log);
  }

  // Keep per-tool selections as well as the combined view used by older readers.
  if (wanted.length || Object.keys(files).length || rulesRecords.length) {
    writeJson(manifestPath(ctx), {
      schema: 5, kind: ctx.kind, base: ctx.base,
      modules: wanted, agentModules, agentRulesBodies,
      version: pkg().version, installedAt: new Date().toISOString(), files,
      rulesBodies: Object.assign({}, ...Object.values(agentRulesBodies)), rulesBlocks: rulesRecords,
    });
  } else if (old) fs.unlinkSync(manifestPath(ctx));

  const c = log.counts;
  console.log(`\n  ${ui.bold(ctx.kind)} ${ui.dim('→')} ${homePath(ctx.base)}  ${ui.cyan([...modules, ...orphans].sort().join(' ')) || ui.dim('none')}`);
  console.log(`  agents: ${active.join(', ')} · ${summary(c)}`);
  for (const n of orphans) {
    const owned = Object.keys(files).filter((rel) => fileOwner(files[rel]) === n);
    const kept = owned.filter((rel) => lstatOrNull(path.join(ctx.base, rel))).length;
    const lost = owned.length - kept;
    const what = [
      kept ? `kept ${kept} delivered file${kept > 1 ? 's' : ''}, unverifiable until the module is back` : '',
      lost ? `${lost} recorded file${lost > 1 ? 's' : ''} missing with nothing to restore from` : '',
      !owned.length ? 'nothing was delivered from it; the record is kept' : '',
    ].filter(Boolean).join('; ');
    console.log(`  ${ui.yellow('!')} ${n} ${ui.dim(`is gone from ${homePath(PERSONAL_MODULES_DIR())} — ${what}`)}`);
    console.log(`    ${ui.dim(`\`agents-setup uninstall ${n}\` removes it; nothing else will`)}`);
  }
  if (orphans.length) process.exitCode = 1;
  // 持ち越した module に更新が溜まっていれば、黙って古いままにせず、取り込み方を示す。
  const kept = [...new Set(active.flatMap((a) => [...(held[a] ?? [])]))];
  if (kept.length) {
    const inspection = inspectDeployment(makeCtx({ ...opts, agents: active }));
    const stale = kept.filter((n) => inspection.checks.some((c) => c.owners.includes(n) && c.kinds.includes('update'))).sort();
    if (stale.length) {
      console.log(`  ${ui.yellow('↑')} ${stale.join(' ')} ${ui.dim(`left as delivered — \`agents-setup update\` applies ${stale.length > 1 ? 'their updates' : 'its update'}`)}`);
    }
  }
  // 依存の不在は配備の失敗ではない。伝えるが、終了コードは変えない。
  for (const m of touched) {
    const missing = missingRequirements(m);
    if (missing.length) console.log(`  ${ui.yellow('!')} ${m} expects ${missing.join(' ')} on PATH — install it when you need it`);
  }
  noticeOldCorpus();
  // plugin の agents / hooks は次のセッションから効く(SKILL.md だけは即時に読まれる)。
  if (c.add + c.update + c.del > 0) {
    if (active.includes('claude')) console.log(ui.dim('  run /reload-plugins in a running Claude Code session, or start a new one'));
    if (active.includes('codex')) console.log(ui.dim('  start a new Codex session to load the installed skills, agents and rules'));
  }
  if (c.warn > 0 && !(replaceModules && !opts.modules.length && !active.some((a) => agentModules[a]?.length))) process.exitCode = 1;
}

// update は「今あるもので配り直す」。規則を新しくするのはパッケージの更新であって、
// このコマンドではない — 追従の経路は 1 本しかなく、それは npm の側にある。
async function update(opts) {
  return install(opts, { requireExisting: true });
}

async function uninstall(opts) {
  const ctx = makeCtx(opts);
  const m = readJson(manifestPath(ctx), null);
  const hasLegacy = !!readJson(legacyManifestPath(ctx), null);
  if (!m && !hasLegacy) throw new Error(`nothing installed for ${homePath(ctx.base)} — nothing of ours to remove.`);
  if (!m) {
    if (opts.agents) throw new Error('legacy installation has no per-agent record; run update before selecting an agent.');
    migrateLegacy(ctx, makeLog());
    return;
  }
  const targets = recordedAgentModules(ctx, m);
  const agents = opts.agents ?? Object.keys(targets);
  const remembered = [...new Set(agents.flatMap((a) => targets[a] ?? []))];
  const unknown = opts.modules.filter((n) => !remembered.includes(n));
  if (unknown.length) {
    const heirs = renameMap();
    const hint = unknown.filter((n) => heirs.has(n)).map((n) => `\n       ${n} is retired — its rules are now ${heirs.get(n).join(' ')}`).join('');
    throw new Error(`not installed here: ${unknown.join(' ')} (installed: ${remembered.join(' ')})${hint}`);
  }
  return install({ ...opts, agents, migrateAllLegacy: !opts.agents, modules: [], removeModules: opts.modules.length ? opts.modules : remembered },
    { requireExisting: true, replaceModules: true });
}

function status(opts) {
  const ctx = makeCtx(opts);
  const inspection = inspectDeployment(ctx);
  const m = inspection.manifest;
  if (m && opts.agents && !inspection.installed.size) {
    console.log(`\n  ${ui.yellow('not installed')} ${ui.dim('—')} ${opts.agents.join(', ')} at ${homePath(ctx.base)}`);
    process.exitCode = 1;
    return;
  }
  if (!m) {
    if (inspection.hasLegacy) {
      console.log(`\n  ${ui.yellow('legacy layout')} ${ui.dim('—')} ${homePath(ctx.legacyRoot)} exists; run \`agents-setup update\` to migrate`);
    } else {
      console.log(`\n  ${ui.yellow('not installed')} ${ui.dim('—')} no manifest for ${homePath(ctx.base)}`);
    }
    process.exitCode = 1;
    return;
  }

  const modules = [...inspection.installed];
  console.log(`\n  ${ui.bold(ctx.kind === 'user' ? 'global' : 'project')} ${ui.dim('→')} ${homePath(ctx.base)}`);
  console.log(ui.dim(`  version=${m.version} installed=${m.installedAt}`));
  console.log(ui.dim(`  agents=${(ctx.agents ?? Object.keys(inspection.agentModules)).join(', ')}`));
  if (m.commit) console.log(ui.dim(`  commit=${m.commit.slice(0, 12)}`));
  if (m.source) console.log(ui.dim(`  source=${m.source}`));
  console.log(ui.dim(`  home=${homePath(DOTAGENTS_HOME())}${process.env.DOTAGENTS_HOME ? ' (DOTAGENTS_HOME)' : ''}\n`));
  const width = Math.max(0, ...modules.map(textWidth));
  for (const n of modules) {
    const state = deploymentState(inspection, n);
    console.log(`  ${ui[state.color](state.symbol)} ${pad(n, width)}  ${state.label}`);
  }
  console.log('');
  for (const check of inspection.checks) {
    const ok = !check.kinds.length;
    console.log(`  ${ok ? ui.green('ok') : ui.red('NG')}  ${ok ? check.message : ui.bold(check.message)}`);
  }
  const drift = inspection.checks.filter((c) => c.kinds.length).length;
  console.log(drift === 0 ? `\n  ${ui.green('no drift')}` : `\n  ${ui.red(`drift: ${drift}`)}`);
  noticeOldCorpus();
  if (drift > 0) process.exitCode = 1;
}

// 何が install できるか。導入は代行しないので、依存は在るか無いかだけを添える。
function list() {
  const index = moduleIndex();
  if (!index.size) {
    // 置き場が空でも壊れてはいない。どこから来る物なのかだけを示す。
    console.log(`\n  ${ui.yellow('no modules')} ${ui.dim('—')} nothing in ${homePath(PERSONAL_MODULES_DIR())}\n`);
    console.log(`  ${ui.dim(`the sample set (${VENDOR})`)}   npm i -g @hiroiku/dotagents   ${ui.dim('(it places them here, yours to keep or delete)')}`);
    console.log(`  ${ui.dim('your own')}                  ${ui.dim('put any module directory here — nothing else is needed')}`);
    process.exitCode = 1;
    return;
  }
  const names = [...index.keys()].sort();
  const w = Math.max(...names.map((n) => textWidth(n)));
  // 置き場は 1 つ。見本として来た物か、手を入れた物か、自分で書いた物かだけを添える。
  const states = seedStates();
  console.log(`\n  ${ui.bold('modules')} ${ui.dim(`— ${homePath(PERSONAL_MODULES_DIR())}`)}\n`);
  for (const n of names) {
    const meta = moduleMeta(n);
    const missing = missingRequirements(n);
    console.log(`  ${ui.cyan(pad(n, w))}  ${ui.dim(meta.description)}`);
    const notes = [];
    const st = states.get(n);
    if (st === 'sample') notes.push(`from ${VENDOR}`);
    else if (st === 'edited') notes.push(`from ${VENDOR}, edited by you`);
    if (meta.requires.length) {
      notes.push(`requires ${meta.requires.join(' ')} ${missing.length ? `— missing: ${missing.join(' ')}` : '— found'}`);
    }
    if (notes.length) console.log(`  ${pad('', w)}  ${ui.dim(notes.join(' · '))}`);
  }
  console.log(`\n${ui.dim('  agents-setup install <module>       into this project')}`);
  console.log(`${ui.dim('  agents-setup install <module> -g    for every project on this machine')}`);
  console.log(ui.dim(`  every module above is a directory you own — edit it, delete it, or drop a new one beside it`));
}

// ---------------------------------------------------------------- 旧 corpus(刈り取り専用)

// 規則を git clone して ~/.dotagents/corpus に置いていた頃の名残。同梱と同じ名前の物は
// もう要らないが、自作の module はその人の仕事なので個人の置き場へ写す。corpus 自体は
// 消さない — 中身を確かめるのは持ち主であって、こちらではない。
//
// どのコマンドより先に済ませる。写した module はその場で名前が通るようになり、
// 移行した直後に `install <自分の module>` と打っても知らない名前にはならない。
function migrateCorpus() {
  const src = path.join(CORPUS_DIR(), 'modules');
  if (!lstatOrNull(src)?.isDirectory()) return;
  const seeded = new Set(lstatOrNull(SEED_MODULES_DIR) ? fs.readdirSync(SEED_MODULES_DIR) : []);
  const moved = [];
  for (const e of fs.readdirSync(src, { withFileTypes: true })) {
    if (!e.isDirectory() || seeded.has(e.name)) continue;
    if (!lstatOrNull(path.join(src, e.name, 'module.json'))) continue;
    const dst = path.join(PERSONAL_MODULES_DIR(), e.name);
    if (lstatOrNull(dst)) continue; // 同名が既にあるなら、そちらが持ち主の意思である
    fs.mkdirSync(PERSONAL_MODULES_DIR(), { recursive: true });
    fs.cpSync(path.join(src, e.name), dst, { recursive: true });
    moved.push(e.name);
  }
  // 配達の数には混ぜない。ここで起きたのは本拠地の引っ越しであって、配備ではない。
  if (moved.length) {
    console.log(`  ${ui.green('+')} ${moved.join(' ')} → ${homePath(PERSONAL_MODULES_DIR())} ${ui.dim('(copied out of the old corpus)')}`);
  }
}

// corpus が残っている限り、毎回 1 行だけ言う。消すかどうかは持ち主が決める。
function noticeOldCorpus() {
  if (!lstatOrNull(CORPUS_DIR())) return;
  console.log(`  ${ui.yellow('!')} ${homePath(CORPUS_DIR())} ${ui.dim('is no longer read — rules ship with the package now.')}`);
  console.log(`    ${ui.dim('Anything of your own there was copied to')} ${homePath(PERSONAL_MODULES_DIR())}${ui.dim('; remove the old corpus when you are ready.')}`);
}


const COMMANDS = new Set(['list', 'install', 'update', 'uninstall', 'status']);
// 配備先を取らないコマンド。list は引数なし。
const CORPUS_COMMANDS = new Set(['list']);
// 規則を git で持っていた頃のコマンド。同梱になったので、行き先だけを示して退く。
const RETIRED_COMMANDS = new Map([
  ['clone', 'the rules ship with the package now — there is nothing to clone.'],
  ['pull', 'the rules ship with the package now — update the package instead.'],
]);
// module 名を取るコマンド。update / status は憶えている選択に対して働くので取らない。
const MODULE_COMMANDS = new Set(['install', 'uninstall']);
// 旧インタフェース。エイリアスとしては生かさず、正しい形へ案内するためだけに覚えておく。
const RETIRED_TARGETS = new Set(['user', 'project', 'shell']);
const RETIRED = new Set(['--user', '--project', '--shell']);
const RETIRED_FLAGS = new Set(['--keep-shell']);

// 位置引数は module 名だけ。配備先は真偽フラグ(-g)なので、-C との併用だけを矛盾として止める。
function parseArgs(argv) {
  const opts = {
    global: false, dir: null, dirExplicit: false, modules: [], agents: null,
    force: false,
    interactive: false, help: false, version: false,
  };
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') opts.help = true;
    else if (a === '--version' || a === '-v') opts.version = true;
    else if (a === '--force') opts.force = true;
    else if (a === '--global' || a === '-g') opts.global = true;
    else if (a === '--agent') {
      const value = argv[++i];
      if (!value) throw new Error('--agent takes a value: claude, codex, or all');
      const names = value === 'all' ? AGENTS : value.split(',');
      if (names.some((n) => !AGENTS.includes(n))) throw new Error(`unknown agent: ${value} (choose claude or codex)`);
      opts.agents = [...new Set([...(opts.agents ?? []), ...names])];
    }
    else if (a === '--directory' || a === '-C') {
      if (argv[i + 1] === undefined) throw new Error('-C takes a value: -C <dir>');
      opts.dir = argv[++i];
      opts.dirExplicit = true;
    }
    else if (RETIRED.has(a)) {
      throw new Error(`${a} is retired. The target is a flag now — project by default:\n` +
        `         agents-setup <command> [module...] [-g] [-C <dir>]`);
    }
    else if (RETIRED_FLAGS.has(a)) {
      throw new Error(`${a} is retired: no module ships a shell layer, so there is nothing to keep.\n` +
        `       Use plain \`uninstall\`; \`update\` prunes any old shell wiring.`);
    }
    else if (a.startsWith('-')) throw new Error(`unknown argument: ${a}`);
    else positional.push(a);
  }

  const [cmd, ...rest] = positional;
  // ヘルプと版の表示は引数の妥当性より優先する(`install --help` に module を要求しない)
  if (opts.help || opts.version) return { cmd, opts };
  if (!COMMANDS.has(cmd)) return { cmd, opts };  // 使い方の表示へ

  // list は位置引数を取らない
  if (CORPUS_COMMANDS.has(cmd)) {
    if (opts.agents) throw new Error('list has no installation target; use install or status with --agent');
    if (rest.length) throw new Error(`\`${cmd}\` takes no arguments: ${rest.join(' ')}`);
    return { cmd, opts };
  }

  if (opts.global && opts.dirExplicit) {
    throw new Error('-g and -C are exclusive: the user level has no directory to choose.');
  }
  if (RETIRED_TARGETS.has(rest[0])) {
    throw new Error(`the \`${rest[0]}\` target is retired. The target is a flag now, and project is the default:\n` +
      `         agents-setup ${cmd} <module>          this project (the current directory)\n` +
      `         agents-setup ${cmd} <module> -g       this machine (~/.claude and ~/.codex)\n` +
      `         agents-setup ${cmd} <module> -C <dir> a specific project`);
  }
  if (rest.length && !MODULE_COMMANDS.has(cmd)) {
    throw new Error(`\`${cmd}\` takes no module names: ${rest.join(' ')}\n` +
      `       It works on whatever is recorded for the target.`);
  }
  opts.modules = rest;

  return { cmd, opts };
}

// ---------------------------------------------------------------- help

// 対象の説明は 4 コマンドで同一なので 1 箇所に持つ。
const TARGET_HELP = `${ui.bold('Target')} ${ui.dim('— this project by default; the wider scope always takes a flag.')}
  ${ui.cyan('(default)')}      the current directory (.claude/, .agents/skills/, .codex/)
  ${ui.cyan('-g, --global')}   this machine (~/.claude, ~/.agents/skills, ~/.codex)
  ${ui.cyan('-C <dir>')}       a specific project
  ${ui.cyan('--agent <name>')} claude, codex, or all; repeat or comma-separate to select both`;

const CMD_HELP = {
