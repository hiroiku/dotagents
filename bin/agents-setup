    ],
  },
  update: {
    usage: '[options]',
    line: 'redeliver whatever is recorded here, keeping what lost its source',
    body: [
      'Requires an existing installation, and works on the module set the manifest',
      'remembers — no module names, no flags to recall. Beyond what install does, it',
      'drops files a module no longer carries, and prunes any legacy .agents layout it',
      'finds. A remembered name that a module now declares it replaces is followed to its',
      'heirs, renamed or split, and the record is rewritten to say so.',
      '',
      'A delivered module whose source is gone from ~/.dotagents/modules/ is kept, not',
      'removed — only uninstall takes rules out of a deployment. It is reported instead.',
      '',
      'New rules arrive by updating the package, not by running this. Update it the way',
      'you installed it (bun add -g / npm i -g), then run this to redeliver.',
    ],
    options: [
      ['--force', 'overwrite whatever sits in the way and does not match what would be delivered'],
    ],
    notes: ['Never edit prompts in the installed tree — update overwrites them. Your own rules go in ~/.dotagents/modules/.'],
    examples: [
      ['dotagents update', 'refresh the current project'],
      ['dotagents update -g --force', 'refresh this machine, discarding local edits'],
    ],
  },
  uninstall: {
    usage: '[module...] [options]',
    line: 'remove only what this installer placed and still owns (hash-matched)',
    body: [
      'Naming modules is subtractive: the rest is redelivered and the removed module\'s',
      'files are pruned. Naming none removes everything. Only files whose content still',
      'matches the manifest are touched, and the managed rules blocks are stripped —',
      'your own skills, your edits, and whatever you wrote around the blocks stay.',
