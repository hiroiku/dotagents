#!/bin/bash
# 完了ゲートの機械項目を判定する。出力の各行は ok / NG、末尾に集計、乖離があれば exit 1。
#
# 検査するのは bd / git / 検査コマンドから導出できる項目だけ:
#   - worktree が clean か
#   - HEAD が指定コミット(レビュー対象コミット)と一致するか(--commit)
#   - 統合ブランチと conflict しないか(--base)
#   - 検査コマンドの通過(--check、複数可: lint / spec / 横断検査)
#   - 対象 issue の子に open / in_progress が残っていないか(--issue)
#   - 自 actor($BEADS_ACTOR)の in_progress 残置(対象 issue 自身は除く)
#
# 検証できない項目(反証レビューの clean・欠落・設計転換の合意)は検査しない —
# gate はレビューの代替ではなく、機械で落ちる状態にレビュアーの注意を使わないための前段である。
# 完了報告にはこの出力を生のまま貼る(要約・言い換えをしない)。

usage() {
  echo "使い方: agents-gate [--issue <id>] [--commit <sha>] [--base <branch>] [--check '<cmd>']..." >&2
  exit 64
}

issue="" commit="" base=""
checks=()
while [ $# -gt 0 ]; do
  case "$1" in
    --issue)  issue="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --base)   base="$2"; shift 2 ;;
    --check)  checks+=("$2"); shift 2 ;;
    *) usage ;;
  esac
done

ng=0
ok() { echo "ok  $1"; }
bad() { echo "NG  $1"; ng=$((ng + 1)); }

# --- git ---
if git rev-parse --git-dir >/dev/null 2>&1; then
  if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
    ok "worktree clean"
  else
    bad "worktree に未 commit の変更が残っている"
  fi

  if [ -n "$commit" ]; then
    head=$(git rev-parse HEAD 2>/dev/null)
    want=$(git rev-parse "$commit" 2>/dev/null)
    if [ -n "$want" ] && [ "$head" = "$want" ]; then
      ok "HEAD = ${want:0:12}(レビュー対象コミット)"
    else
      bad "HEAD(${head:0:12})がレビュー対象コミット($commit)と一致しない"
    fi
  fi

  if [ -n "$base" ]; then
    git merge-tree --write-tree --no-messages "$base" HEAD >/dev/null 2>&1
    rc=$?
    if [ "$rc" = "0" ]; then
      ok "統合ブランチ($base)と conflict なし"
    elif [ "$rc" = "1" ]; then
      bad "統合ブランチ($base)と conflict する"
    else
      bad "統合ブランチとの conflict を確認できない(git merge-tree 不可。手動で確認する)"
    fi
  fi
else
  bad "git リポジトリではない(worktree の中で実行する)"
fi

# --- 検査コマンド ---
for cmd in ${checks+"${checks[@]}"}; do
  if sh -c "$cmd" >/dev/null 2>&1; then
    ok "check: $cmd"
  else
    bad "check: $cmd(exit $?)"
  fi
done

# --- bd ---
if [ -n "$issue" ]; then
  if command -v bd >/dev/null 2>&1; then
    leftover=$(bd children "$issue" --json 2>/dev/null | python3 -c '
import json, sys
try:
    kids = json.load(sys.stdin)
except Exception:
    print("__ERR__"); raise SystemExit
print(",".join(k["id"] for k in kids if k.get("status") in ("open", "in_progress")))
' 2>/dev/null)
    if [ "$leftover" = "__ERR__" ]; then
      bad "bd children($issue)を確認できない"
    elif [ -n "$leftover" ]; then
      bad "issue($issue)の子に open / in_progress が残っている: $leftover"
    else
      ok "issue($issue)の子に open 残なし"
    fi
  else
    bad "bd が無いため issue($issue)の子を確認できない"
  fi
fi

if [ -n "${BEADS_ACTOR:-}" ] && command -v bd >/dev/null 2>&1; then
  mine=$(bd list --status in_progress --json 2>/dev/null | _GATE_ISSUE="$issue" python3 -c '
import json, os, sys
try:
    items = json.load(sys.stdin)
except Exception:
    raise SystemExit
actor = os.environ.get("BEADS_ACTOR")
skip = os.environ.get("_GATE_ISSUE")
print(",".join(i["id"] for i in items if i.get("assignee") == actor and i["id"] != skip))
' 2>/dev/null)
  if [ -n "$mine" ]; then
    bad "自 actor($BEADS_ACTOR)の in_progress 残置: $mine"
  else
    ok "自 actor の in_progress 残置なし"
  fi
fi

echo ""
if [ "$ng" = "0" ]; then
  echo "gate: ok(機械項目のみ。反証レビューの clean・記録・合意は別途)"
  exit 0
else
  echo "gate: NG ${ng} 件"
  exit 1
fi
