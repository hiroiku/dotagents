{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${PLUGIN_ROOT}/dotagents.mjs\" codex session",
            "timeout": 10,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${PLUGIN_ROOT}/dotagents.mjs\" codex subagent",
            "timeout": 10,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${PLUGIN_ROOT}/dotagents.mjs\" codex tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
