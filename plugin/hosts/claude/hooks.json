{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${CLAUDE_PLUGIN_ROOT}/dotagents.mjs\" claude session",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${CLAUDE_PLUGIN_ROOT}/dotagents.mjs\" claude subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v bun || command -v node)\" \"${CLAUDE_PLUGIN_ROOT}/dotagents.mjs\" claude tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
